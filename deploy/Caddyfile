# Reverse proxy on the VM. exe.dev terminates TLS and proxies https://treachery.exe.xyz/ to
# port 8080 here. Everything goes to the Rust server (treachery.service).
{
	# Plain HTTP only: TLS belongs to exe.dev.
	auto_https off
	admin localhost:2019
}

:8080 {
	# The Rust site was a beta under /beta/ before it replaced the C# site. Old links land on
	# the same path at the root.
	redir /beta / 301
	handle_path /beta/* {
		redir * {uri} 301
	}

	# reverse_proxy passes WebSocket upgrades through on its own.
	handle {
		reverse_proxy 127.0.0.1:8000
	}
}
