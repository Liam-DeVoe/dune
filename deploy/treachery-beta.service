[Unit]
Description=treachery.online beta (Rust server and React client), served under /beta
After=network.target

[Service]
User=exedev
Group=exedev
# No appsettings.json here: everything is set below.
WorkingDirectory=/opt/treachery/beta
ExecStart=/opt/treachery/beta/treachery-server
Restart=always
RestartSec=5
# Caddy (deploy/Caddyfile) proxies /beta/* here with the prefix stripped.
Environment=ASPNETCORE_URLS=http://127.0.0.1:8001
Environment=ASPNETCORE_ENVIRONMENT=Production
# Its own database, separate from the C# server's.
Environment="ConnectionStrings__TreacheryDatabase=Data Source=/opt/treachery/data-beta/treachery.db"
# The web client built with base /beta/ (deploy/deploy-beta.sh).
Environment=WebRoot=/opt/treachery/beta/web
# The C# client's published wwwroot: the art, CSS and fonts both clients use.
Environment=SharedAssetsRoot=/opt/treachery/app/wwwroot
Environment=DevScene=false
Environment=GameAdminUsername=admin
# An empty user name turns mail off, as in the C# server's production config.
Environment=GameEndEmailUsername=
Environment=GameEndEmailPassword=
Environment=GameEndEmailFrom=player@treachery.online
Environment=GameEndEmailTo=admin@treachery.online

[Install]
WantedBy=multi-user.target
