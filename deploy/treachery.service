[Unit]
Description=treachery.online (Rust server and React client)
After=network.target

[Service]
User=exedev
Group=exedev
# No appsettings.json here: everything is set below.
WorkingDirectory=/opt/treachery/server
ExecStart=/opt/treachery/server/treachery-server
Restart=always
RestartSec=5
# A runaway game (e.g. an endless loop in the engine) must not take the VM down; systemd restarts the server from its last save.
MemoryMax=3G
# The settings are described in rust/server/src/settings.rs.
# Caddy (deploy/Caddyfile) proxies everything here.
Environment=TREACHERY_LISTEN=127.0.0.1:8000
# Outside /opt/treachery/server, so a deploy never touches the database.
Environment=TREACHERY_DATABASE=/opt/treachery/db/treachery.db
# The web client build and the art, CSS and fonts it links (deploy/deploy.sh).
Environment=TREACHERY_WEB_ROOT=/opt/treachery/server/web
Environment=TREACHERY_ASSETS_ROOT=/opt/treachery/server/assets
Environment=TREACHERY_SITE_URL=https://treachery.exe.xyz
Environment=TREACHERY_ADMIN=admin
# Mail is off without an SMTP user (TREACHERY_SMTP_USER, TREACHERY_SMTP_PASSWORD).
Environment=TREACHERY_STATS_FROM=player@treachery.online
Environment=TREACHERY_STATS_TO=admin@treachery.online
# Unsaved games are saved on SIGTERM; give that time.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
