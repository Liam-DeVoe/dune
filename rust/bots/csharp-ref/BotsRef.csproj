<Project Sdk="Microsoft.NET.Sdk">
  <!-- C# reference values for the Rust bots tests (rust/bots/tests). See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../treachery-online/Oracle/StepExecutor.cs" />
    <Using Include="System.Reflection" />
    <Using Include="Treachery.Shared" />
    <Using Include="Treachery.Shared.Model" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../treachery-online/Shared/Treachery.Shared.csproj" />
    <ProjectReference Include="../../../treachery-online/Bots/Treachery.Bots/Treachery.Bots.csproj" />
  </ItemGroup>
</Project>
