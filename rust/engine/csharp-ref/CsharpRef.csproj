<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dumps the static tables of Treachery.Shared to JSON for the Rust golden tests.
       Run with the output path as the only argument (see tests/golden/README note in engine-conventions.md) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- The oracle's canonical state dumper, for the undo-identity mode. -->
  <ItemGroup>
    <Compile Include="../../../treachery-online/Oracle/Canon/*.cs" />
    <Using Include="System.Reflection" />
    <Using Include="System.Text" />
    <Using Include="Treachery.Shared" />
    <Using Include="Treachery.Shared.Model" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../treachery-online/Shared/Treachery.Shared.csproj" />
  </ItemGroup>
</Project>
