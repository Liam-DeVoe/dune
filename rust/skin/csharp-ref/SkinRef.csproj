<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# side of the rust/skin differential tests: renders DefaultSkin text for
       static objects, string.Format cases and every message of oracle traces.
       See rust/skin/README section in rust/docs/skin.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>CS0612;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Treachery.Shared" />
    <Using Include="System.Reflection" />
    <Using Include="System.Text.Json" />
    <!-- The oracle's Execute wrapper, so the replay makes the same engine calls as the oracle. -->
    <Compile Include="../../../treachery-online/Oracle/StepExecutor.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../treachery-online/Shared/Treachery.Shared.csproj" />
  </ItemGroup>
</Project>
