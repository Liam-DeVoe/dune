@inherits GameEventComponent<AllyPermission>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()" Collapsed="CollapseState.Collapsed">

    <Header>Manage your Alliance with <FactionChip Faction=@Player.Ally Game=Game/></Header>

    <Body>

        @if (Player.AlliedPlayer.IsBot)
        {
            var ally = Player.AlliedPlayer;

            if (ally.TreacheryCards.Any(c => c.IsWeapon))
            {
                <div>They claim they own a weapon.</div>
            }
            else
            {
                <div>They claim they don't own weapons.</div>
            }

            if (ally.TreacheryCards.Any(c => c.IsDefense))
            {
                <div>They claim they own a defense.</div>
            }
            else
            {
                <div>They claim they don't own defenses.</div>
            }

            var safeLeaders = ally.KnownNonTraitors.Where(l => l.Faction == Faction)
                .Union(ally.Traitors.Where(l => l.Faction == Faction)
                .Union(ally.FaceDancers.Where(l => l.Faction == Faction)));

            if (safeLeaders.Any())
            {
                <div>
                    They claim you can safely use:
                    @foreach (var l in safeLeaders) {
                        <Image Popover=@Client.CurrentSkin.GetPopup(l) Shown=l Width="30"/>
                    }
                </div>
            }
            else
            {

                <div>They don't know of any safe leaders you could use.</div>
            }

            <div>They own <SpiceComponent Amount="@ally.Resources.ToString()"/>.</div>
        }

        <div class="mt-1">
            <SelectResourcesComponent @bind-Value="spice" Min="0" Max="Player.Resources" OnChanged="SetEdited" Label="@WillingToPayLabel"/>
        </div>

        @if (Karma.CanKarma(Game, Player))
        {
            var permittedKarma = Game.GetPermittedUseOfAllyKarma(Player.Ally);

            <SelectFromImageComponent @bind-Value="karmaCard" Values="Karma.ValidKarmaCards(Game, Player)" Required="false" T=TreacheryCard OnChanged=SetEdited ImageWidth="80">
                <Label>Select a @Client.CurrentSkin.Describe(TreacheryCardType.Karma) card they may use to ship at <FactionChip Faction=Faction.Guild Game=Game/> rates (currently: @if (permittedKarma == null) { <strong>none</strong> } else { <RichText Shown=@permittedKarma Game=Game/> })?</Label>
            </SelectFromImageComponent>
        }
        else
        {
            karmaCard = null;
        }

        @switch (Faction)
        {
            case Faction.Emperor:
                <div class="mt-1">
                    <label class="mt-1 mb-0">How many revivals will you pay for them (currently: <strong>@(Game.EmperorWillPayForExtraRevival)</strong>)?</label>
                    <SelectForcesComponent @bind-Value="emperorWillPayForExtraRevival" Min="0" Max="3" Faction="Player.Ally" Special="false" OnChanged="@SetEdited"/>
                </div>
                break;

            case Faction.Guild:
                <CheckboxComponent @bind-Value="guildAllyMayShipAsGuild" OnChanged=SetEdited>
                    Allow shipment at <FactionChip Faction=Faction.Guild Game=Game/> rates and site-to-site (currently: <strong>@(Game.GuildAllowsShippingDiscount ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

            case Faction.Tleilaxu:
                <CheckboxComponent @bind-Value="tleilaxuAllyMyReviveAsTleilaxu" OnChanged=SetEdited>
                    Allow revival at <FactionChip Faction=Faction.Tleilaxu Game=Game/> rates (currently: <strong>@(Game.TleilaxuAllowsRevivalDiscount ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

            case Faction.Ixian:
                <CheckboxComponent @bind-Value="ixianAllyMayReplace" OnChanged=SetEdited>
                    Allow replacing treachery cards they win (currently: <strong>@(Game.IxianAllowsReplacingCards ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

            case Faction.Fremen:
                <CheckboxComponent @bind-Value="fremenAllowsThreeFreeRevivals" OnChanged=SetEdited>
                    Allow 3 free revivals (currently: <strong>@(Game.FremenAllowsThreeFreeRevivals ? "yes" : "no")</strong>)
                </CheckboxComponent>

                <CheckboxComponent @bind-Value="fremenWillProtectFromShaiHulud" OnChanged=SetEdited>
                    Protect them from <MonsterIcon/> (currently: <strong>@(Game.FremenWillProtectFromMonster ? "yes" : "no")</strong>)
                </CheckboxComponent>

                @if (Game.Applicable(Rule.FremenDeterminesStorm))
                {
                    <CheckboxComponent @bind-Value="fremenShareStormPrescience" OnChanged=SetEdited>
                        Share storm knowledge (currently: <strong>@(Game.FremenSharesPrescience ? "yes" : "no")</strong>)
                    </CheckboxComponent>
                }

                @if (Game.Applicable(Rule.FremenAllyGetsDialedResourcesRefunded))
                {
                    <CheckboxComponent @bind-Value="fremenRefundsDial" OnChanged=SetEdited>
                        Refund @Name(Concept.Resource) dialled in battle (currently: <strong>@(Game.FremenRefundsBattleDial ? "yes" : "no")</strong>)
                    </CheckboxComponent>
                }

                break;

            case Faction.Atreides:
                <CheckboxComponent @bind-Value="atreidesSharePrescience" OnChanged=SetEdited>
                    Share your Prescience (currently: <strong>@(Game.AtreidesSharesPrescience ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

            case Faction.BeneGesserit:
                <CheckboxComponent @bind-Value="beneGesseritAllyMayUseVoice" OnChanged=SetEdited>
                    Allow use of Voice (currently: <strong>@(Game.BeneGesseritAllowsUseOfVoice ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

            case Faction.Richese:
                <CheckboxComponent @bind-Value="richeseAllyMayUseNoField" OnChanged=SetEdited>
                    Allow shipment by No-Field (currently: <strong>@(Game.RicheseAllowsUseOfNoField ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

            case Faction.Moritani:
                <CheckboxComponent @bind-Value="moritaniAllyMayKeepCards" OnChanged=SetEdited>
                    Allow keeping a treachery card after a lost battle (currently: <strong>@(Game.MoritaniAllowsKeepingCards ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

            case Faction.Ecaz:
                <CheckboxComponent @bind-Value="ecazAllyMayUseAmbassadors" OnChanged=SetEdited>
                    Allow them to activate and benefit from ambassadors (currently: <strong>@(Game.EcazSharesAmbassadors ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

        }

        <ButtonRowComponent Confirm="ConfirmAndSetUnedited" ConfirmText="Confirm Changes" ConfirmError="@Validation" Disabled="@(!edited)"/>

    </Body>

</GameEventComponentLayout>

@code {

    private bool tleilaxuAllyMyReviveAsTleilaxu;
    private bool ixianAllyMayReplace;
    private bool guildAllyMayShipAsGuild;
    private int emperorWillPayForExtraRevival;
    private bool fremenWillProtectFromShaiHulud;
    private bool fremenAllowsThreeFreeRevivals;
    private bool fremenShareStormPrescience;
    private bool fremenRefundsDial;
    private bool atreidesSharePrescience;
    private bool beneGesseritAllyMayUseVoice;
    private bool richeseAllyMayUseNoField;
    private bool moritaniAllyMayKeepCards;
    private bool ecazAllyMayUseAmbassadors;

    private int spice;
    private TreacheryCard? karmaCard;
    private bool edited = false;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!edited)
        {
            spice = Game.GetPermittedUseOfAllyResources(Player.Ally);
            karmaCard = Game.GetPermittedUseOfAllyKarma(Player.Ally);

            switch (Faction)
            {
                case Faction.Tleilaxu:
                    tleilaxuAllyMyReviveAsTleilaxu = Game.TleilaxuAllowsRevivalDiscount;
                    break;

                case Faction.Ixian:
                    ixianAllyMayReplace = Game.IxianAllowsReplacingCards;
                    break;

                case Faction.Guild:
                    guildAllyMayShipAsGuild = Game.GuildAllowsShippingDiscount;
                    break;

                case Faction.Emperor:
                    emperorWillPayForExtraRevival = Game.EmperorWillPayForExtraRevival;
                    break;

                case Faction.Fremen:
                    fremenWillProtectFromShaiHulud = Game.FremenWillProtectFromMonster;
                    fremenAllowsThreeFreeRevivals = Game.FremenAllowsThreeFreeRevivals;
                    fremenShareStormPrescience = Game.FremenSharesPrescience;
                    fremenRefundsDial = Game.FremenRefundsBattleDial;
                    break;

                case Faction.Atreides:
                    atreidesSharePrescience = Game.AtreidesSharesPrescience;
                    break;

                case Faction.BeneGesserit:
                    beneGesseritAllyMayUseVoice = Game.BeneGesseritAllowsUseOfVoice;
                    break;

                case Faction.Richese:
                    richeseAllyMayUseNoField = Game.RicheseAllowsUseOfNoField;
                    break;

                case Faction.Moritani:
                    moritaniAllyMayKeepCards = Game.MoritaniAllowsKeepingCards;
                    break;

                case Faction.Ecaz:
                    ecazAllyMayUseAmbassadors = Game.EcazSharesAmbassadors;
                    break;

            }
        }
    }

    private void SetEdited(bool value)
    {
        edited = true;
    }

    private void SetEdited(int value)
    {
        edited = true;
    }

    private void SetEdited(TreacheryCard c)
    {
        edited = true;
    }

    protected override AllyPermission ConfirmedResult =>

        new(Game, Faction)
        {
            EmperorWillPayForExtraRevival = emperorWillPayForExtraRevival,
            FremenAllowsThreeFreeRevivals = fremenAllowsThreeFreeRevivals,
            FremenWillProtectFromMonster = fremenWillProtectFromShaiHulud,
            FremenSharesPrescience = fremenShareStormPrescience,
            FremenRefundsBattleDial = fremenRefundsDial,
            AtreidesSharesPrescience = atreidesSharePrescience,
            BeneGesseritAllowsUseOfVoice = beneGesseritAllyMayUseVoice,
            RicheseAllowsUseOfNoField = richeseAllyMayUseNoField,
            GuildAllowsShippingDiscount = guildAllyMayShipAsGuild,
            TleilaxuAllowsRevivalDiscount = tleilaxuAllyMyReviveAsTleilaxu,
            IxianAllowsReplacingCards = ixianAllyMayReplace,
            MoritaniAllowsKeepingCards = moritaniAllyMayKeepCards,
            EcazSharesAmbassadors = ecazAllyMayUseAmbassadors,
            PermittedResources = spice,
            PermittedKarmaCard = karmaCard
        };

    private async Task ConfirmAndSetUnedited()
    {
        await Confirm();
        edited = false;
    }

    private string WillingToPayLabel =>
        string.Format("How much are you willing to pay for their {0}bids and shipments (currently: {1})? {2}",
            Faction == Faction.Choam ? "battles, " : "",
            Game.GetPermittedUseOfAllyResources(Player.Ally),
            Faction == Faction.Emperor ? "Payments for bids flow back to you." : "");
}
