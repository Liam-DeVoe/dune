@inherits MapPickComponent<AmbassadorActivated>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Activate the <Image Shown="@AmbassadorActivated.GetAmbassador(Game)" Width="30"/> Ambassador?</Header>
    <Body>

        @{
            var ambassador = AmbassadorActivated.GetAmbassador(Game);
            var victim = AmbassadorActivated.GetVictim(Game);

            if (ambassador == Ambassador.BeneGesserit)
            {
                <SelectFromImageComponent @bind-Value=_actualAmbassador Values=@AmbassadorActivated.GetValidBeneGesseritAmbassadors(Game)>
                    <Label>Activate the effect of which ambassador?</Label>
                </SelectFromImageComponent>
                <br/>
            }
            else
            {
                _actualAmbassador = ambassador;
            }

            switch (_actualAmbassador)
            {
                case Ambassador.Atreides:

                    <div>See the <FactionChip Faction=@victim Game=Game/> hand?</div>
                    break;

                case Ambassador.Choam:

                    <div>Discard cards from your hand for <SpiceComponent Amount="3"/> each?</div>
                    <SelectFromImageComponent Selected="_choamCards" Values=@AmbassadorActivated.GetValidChoamCards(Player) T=TreacheryCard OnChanged=StateHasChanged ImageWidth="80">
                        <Label>Select the cards you wish to discard for <SpiceComponent Amount="3"/> each</Label>
                    </SelectFromImageComponent>
                    break;

                case Ambassador.Ecaz:
                
                    if (AmbassadorActivated.VidalCanBeTaken(Game, Player)) {

                        <CheckboxComponent @bind-Value="_ecazTakeVidal">Take <RichText Shown=@Game.Vidal Game=Game/></CheckboxComponent>
                    }
                    else
                    {
                        _ecazTakeVidal = false;
                    }
                    
                    if (!_ecazTakeVidal && AmbassadorActivated.AllianceCanBeOffered(Game, Player))
                    {
                        <CheckboxComponent @bind-Value="_ecazOfferAlliance">Offer an alliance to <FactionChip Faction=@victim Game=Game/></CheckboxComponent>
                        
                        if (_ecazOfferAlliance && AmbassadorActivated.VidalCanBeOfferedToNewAlly(Game, Player))
                        {
                            <CheckboxComponent @bind-Value="_ecazGiveVidal">Give <RichText Shown=@Game.Vidal Game=Game/> to <FactionChip Faction=@victim Game=Game/> if they agree to ally</CheckboxComponent>
                        }
                        else
                        {
                            _ecazGiveVidal = false;
                        }
                    }
                    else
                    {
                        _ecazOfferAlliance = false;
                        _ecazGiveVidal = false;
                    }
                    break;

                case Ambassador.Emperor:

                    <div>Receive <SpiceComponent Amount="5"/>?</div>
                    break;

                case Ambassador.Fremen:

                    <div>Move a group of your forces?</div>

                    if (FremenSources.Any())
                    {
                        <div class="small">Use the map to move forces: click the sector to move from, then where to move to.</div>
                    }
                    else
                    {
                        <div>You don't have any forces to move.</div>
                    }
                    break;

                case Ambassador.Harkonnen:
                    
                    if (victim == Faction.Harkonnen)
                    {
                        <div>See one of the <FactionChip Faction=@victim Game=Game/> traitors?</div>
                    }
                    else if (victim == Faction.Tleilaxu)
                    {
                        <div>See one of the <FactionChip Faction=@victim Game=Game/> unrevealed Face Dancers?</div>
                    }
                    else {

                        <div>See the <FactionChip Faction=@victim Game=Game/> traitor?</div>
                    }
                    break;

                case Ambassador.Ixian:

                    <div>Discard a card from your hand to draw a new one?</div>
                    <SelectFromImageComponent @bind-Value=@_ixianCard Values=@AmbassadorActivated.GetValidIxianCards(Player) ImageWidth="80">
                        <Label>Select the card you wish to discard</Label>
                    </SelectFromImageComponent>
                    break;

                case Ambassador.Richese:

                    <div>Buy a treachery card for <SpiceComponent Amount="3"/>?</div>
                    break;

                case Ambassador.Guild:

                    <div>Send up to 4 <ForceToken Faction=@Faction Size="20"/> to any location?</div>

                    if (AmbassadorActivated.ValidGuildTargets(Game, Player).Any())
                    {
                        <div class="small">Use the map to choose a location.</div>
                    }
                    else
                    {
                        _guildForceAmount = 0;

                        <div>There are no valid locations to ship to.</div>
                    }
                    break;

                case Ambassador.Tleilaxu:

                    <div>Revive one of your leaders or up to 4 <ForceToken Faction=@Faction Size="20"/> for free?</div>
                    @if (AmbassadorActivated.ValidTleilaxuMaxAmount(Player) > 0)
                    {
                        <SelectForcesComponent @bind-Value="_tleilaxuAmountOfForces" Min="0" Max=@AmbassadorActivated.ValidTleilaxuMaxAmount(Player) Faction="Faction" Special="false" />
                    }
                    else
                    {
                        _tleilaxuAmountOfForces = 0;
                    }

                    <SelectFromImageComponent Game="Game" @bind-Value=@_tleilaxuHero Values="AmbassadorActivated.ValidTleilaxuHeroes(Game, Player)" Required="false" ImageWidth="80"/>

                    @if (_tleilaxuHero != null && Revival.MayAssignSkill(Game, Player, _tleilaxuHero))
                    {
                        <RadioComponent @bind-Value=_tleilaxuAssignSkill Values="@(new[] {false,true})" ValueLabels="@(new[] {"No","Yes"})">
                            <Label>Do you wish to assign a skill to this leader?</Label>
                        </RadioComponent>
                    }
                    else
                    {
                        _tleilaxuAssignSkill = false;
                    }

                    break;
            }
        }

        @if (AmbassadorActivated.MayPass(Player)) 
        {
            <ButtonRowComponent Confirm="Confirm" ConfirmError=@Validation Pass="Pass" />
        }
        else
        {
            <ButtonRowComponent Confirm="Confirm" ConfirmError=@Validation />
        }

    </Body>

</GameEventComponentLayout>

@code {

    protected override bool IsUrgent => true;
    protected override Faction IsFactionSpecific => Faction.Ecaz;

    private Ambassador _actualAmbassador;
    private List<TreacheryCard> _choamCards = new();
    private bool _ecazOfferAlliance;
    private bool _ecazTakeVidal;
    private bool _ecazGiveVidal;
    private Dictionary<Location, Battalion> _fremenForces = new();
    private TreacheryCard? _ixianCard;
    private int _guildForceAmount;
    private int _tleilaxuAmountOfForces;
    private IHero? _tleilaxuHero;
    private bool _tleilaxuAssignSkill;

    // The Fremen ambassador moves forces like a regular move: sources first,
    // then the destination. The Guild one ships from reserves: destination only.
    private bool MovesForces => _actualAmbassador == Ambassador.Fremen;

    private bool ShipsForces => _actualAmbassador == Ambassador.Guild;

    private IEnumerable<Location> FremenSources =>
        AmbassadorActivated.ValidFremenSources(Game, Player).SelectMany(t => t.Locations).Where(l => Player.AnyForcesIn(l) > 0 && !Game.IsInStorm(l));

    protected override bool PickEnabled => (MovesForces && FremenSources.Any()) || (ShipsForces && AmbassadorActivated.ValidGuildTargets(Game, Player).Any());

    protected override IEnumerable<Location> PickSources => MovesForces ? FremenSources : [];

    protected override IEnumerable<Location> PickTargets =>
        MovesForces ? (SelectedSources.Count > 0 ? AmbassadorActivated.ValidFremenTargets(Game, Player) : []) :
        ShipsForces ? AmbassadorActivated.ValidGuildTargets(Game, Player) : [];

    protected override void OnGameChanged()
    {
        _fremenForces.Clear();
        _guildForceAmount = 0;
    }

    // Moving starts with everything in the clicked sectors; shipping starts with one force.
    protected override void OnPickChanged()
    {
        foreach (var l in _fremenForces.Keys.Where(l => !SelectedSources.Contains(l)).ToList()) _fremenForces.Remove(l);
        foreach (var l in SelectedSources.Where(l => !_fremenForces.ContainsKey(l)))
        {
            _fremenForces[l] = new Battalion(Faction, Player.ForcesIn(l), Player.SpecialForcesIn(l), l);
        }
        if (ShipsForces && Target != null && _guildForceAmount == 0) _guildForceAmount = Math.Min(1, AmbassadorActivated.ValidGuildMaxForces(Player));
    }

    private void SetFremenAmount(Location l, int amount, bool special)
    {
        if (!_fremenForces.TryGetValue(l, out var battalion)) return;
        if (special) battalion.AmountOfSpecialForces = amount;
        else battalion.AmountOfForces = amount;
        RefreshPin();
    }

    private void SetGuildAmount(int amount)
    {
        _guildForceAmount = amount;
        RefreshPin();
    }

    protected override RenderFragment PinContent => __builder =>
    {
        <div class="pin-body">
            @if (MovesForces)
            {
                foreach (var kvp in _fremenForces)
                {
                    var l = kvp.Key;
                    var b = kvp.Value;
                    <div class="pin-row">
                        @if (_fremenForces.Count > 1)
                        {
                            <span class="pin-from"><PlaceChip Place=@l/></span>
                        }
                        @if (Player.ForcesIn(l) > 0)
                        {
                            <MapForceStepper Value="@b.AmountOfForces" ValueChanged="@(v => SetFremenAmount(l, v, false))" Min="0" Max="@Player.ForcesIn(l)" Faction="Faction" Special="false"/>
                        }
                        @if (Player.SpecialForcesIn(l) > 0)
                        {
                            <MapForceStepper Value="@b.AmountOfSpecialForces" ValueChanged="@(v => SetFremenAmount(l, v, true))" Min="0" Max="@Player.SpecialForcesIn(l)" Faction="Faction" Special="true"/>
                        }
                    </div>
                }
                @PinActions("Move")
            }
            else
            {
                <div class="pin-row">
                    <MapForceStepper Value="@_guildForceAmount" ValueChanged="@SetGuildAmount" Min="0" Max="@AmbassadorActivated.ValidGuildMaxForces(Player)" Faction="Faction" Special="false"/>
                </div>
                @PinActions("Send")
            }
        </div>
    };

    protected override AmbassadorActivated ConfirmedResult => new(Game, Faction) { 
        BeneGesseritSelectedAmbassador = _actualAmbassador,  
        ChoamCards = _choamCards,
        EcazOfferAlliance = _ecazOfferAlliance, EcazGiveVidalToAlly = _ecazGiveVidal, EcazTakeVidal = _ecazTakeVidal,
        FremenOrGuildTo = Target, 
        FremenForceLocations = _fremenForces,
        GuildForceAmount = _guildForceAmount,
        IxianCard = _ixianCard,
        TleilaxuAmountOfForces = _tleilaxuAmountOfForces, TleilaxuHero = _tleilaxuHero, TleilaxuAssignSkill = _tleilaxuAssignSkill

    };

    protected override AmbassadorActivated PassedResult => new(Game, Faction) { Passed = true };

}
