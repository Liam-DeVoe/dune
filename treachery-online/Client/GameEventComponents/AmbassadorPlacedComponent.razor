@inherits MapPickComponent<AmbassadorPlaced>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>You may now place an Ambassador Token in a Stronghold</Header>
    <Body>

        <SelectFromImageComponent @bind-Value="_ambassador" Values="@AmbassadorPlaced.ValidAmbassadors(Player)" PopupsAsTooltip="true" Required="true">
            <Label>Which ambassador?</Label>
        </SelectFromImageComponent>

        <div class="small mt-1">Use the map to choose a stronghold.</div>

        <div>
            Cost: <SimpleNumberComponent Size="20">@(Game.AmbassadorsPlacedThisTurn + 1)</SimpleNumberComponent>
        </div>

    </Body>

</GameEventComponentLayout>

@code {

    protected override Faction IsFactionSpecific => Faction.Ecaz;

    private Ambassador _ambassador;

    protected override bool PickByTerritory => true;

    protected override IEnumerable<Location> PickTargets => SectorsOf(AmbassadorPlaced.ValidStrongholds(Game, Player));

    protected override AmbassadorPlaced ConfirmedResult => new(Game, Faction) { Ambassador = _ambassador, Stronghold = TargetTerritory };

    protected override RenderFragment PinContent => __builder =>
    {
        <div class="pin-body">
            <div class="pin-row">
                <Image Shown="@_ambassador" Width="28"/>
                <span>@Name(_ambassador) ambassador</span>
            </div>
            @PinActions("Place ambassador")
        </div>
    };
}
