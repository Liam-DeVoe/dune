@inherits MapPickComponent<BlueAccompanies>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Accompany the latest shipment?</Header>
    <Body>

        <div class="small">Use the map to choose a location.</div>

        <ButtonRowComponent Pass="Pass" PassText="Don't accompany" />

    </Body>

</GameEventComponentLayout>

@code {

    protected override bool IsUrgent => true;
    protected override Faction IsFactionSpecific => Faction.Blue;

    private bool addExtraAdvisor;

    protected override IEnumerable<Location> PickTargets => BlueAccompanies.ValidTargets(Game, Player);

    protected override BlueAccompanies ConfirmedResult => new(Game, Faction) { Location = Target, Accompanies = true, ExtraAdvisor = addExtraAdvisor };

    protected override BlueAccompanies PassedResult => new(Game, Faction) { Accompanies = false };

    private void SetExtraAdvisor(bool value)
    {
        addExtraAdvisor = value;
        RefreshPin();
    }

    protected override RenderFragment PinContent => __builder =>
    {
        var mayAddExtra = BlueAccompanies.MaySendExtraAdvisor(Game, Player, Target);
        if (!mayAddExtra) addExtraAdvisor = false;

        <div class="pin-body">
            @if (mayAddExtra)
            {
                <div class="pin-hint">How many <ForceToken Faction=@Player.Faction Special="true" Size="20"/> @Name(Player.SpecialForce)?</div>
                <div class="pin-choice">
                    <button type="button" class="@(addExtraAdvisor ? "" : "on")" @onclick="@(() => SetExtraAdvisor(false))">1</button>
                    <button type="button" class="@(addExtraAdvisor ? "on" : "")" @onclick="@(() => SetExtraAdvisor(true))">2</button>
                </div>
            }
            @PinActions("Accompany")
        </div>
    };
}
