@inherits MapPickComponent<BlueBattleAnnouncement>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Flip advisors to fighters</Header>
    <Body>

        <div class="small">Use the map to choose a territory.</div>

    </Body>

</GameEventComponentLayout>

@code {

    protected override Faction IsFactionSpecific => Faction.Blue;

    protected override bool PickByTerritory => true;

    protected override IEnumerable<Location> PickTargets => SectorsOf(BlueBattleAnnouncement.ValidTerritories(Game, Player));

    protected override BlueBattleAnnouncement ConfirmedResult => new(Game, Faction) { Territory = TargetTerritory };

    protected override RenderFragment PinContent => __builder =>
    {
        <div class="pin-body">
            @PinActions("Flip to fighters")
        </div>
    };
}
