@inherits MapPickComponent<BrownMovePrevention>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Use @if (CardToUse is { } card) { <RichText Shown=@card Game=Game/> } else { @("Nexus Cunning") } to prevent the current player from moving forces into a territory you occupy?</Header>

    <Body>

        <div class="small">Use the map to choose a territory.</div>

    </Body>

</GameEventComponentLayout>

@code {

    protected override Faction IsFactionSpecific => Faction.Brown;

    protected override string Background => Client.CurrentSkin.GetImageUrl(BrownMovePrevention.CardToUse(Player));

    protected override bool PickByTerritory => true;

    protected override IEnumerable<Location> PickTargets => SectorsOf(BrownMovePrevention.ValidTerritories(Player));

    protected override BrownMovePrevention ConfirmedResult => new(Game, Faction) { Territory = TargetTerritory };

    private TreacheryCard? CardToUse => BrownMovePrevention.CardToUse(Player);

    protected override RenderFragment PinContent => __builder =>
    {
        <div class="pin-body">
            @PinActions("Prevent move")
        </div>
    };
}
