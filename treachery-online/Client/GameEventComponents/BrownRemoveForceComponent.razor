@inherits MapPickComponent<BrownRemoveForce>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Use @if (CardToUse is { } card) { <RichText Shown=@card Game=Game/> } else { @("Nexus Cunning") } to force a player to send 1 force to their reserves?</Header>

    <Body>

        <div class="small">Use the map to choose a location.</div>

    </Body>

</GameEventComponentLayout>

@code {

    protected override Faction IsFactionSpecific => Faction.Brown;

    protected override string Background => BrownRemoveForce.CardToUse(Player) != null ? Client.CurrentSkin.GetImageUrl(BrownRemoveForce.CardToUse(Player)) : Client.CurrentSkin.GetImageUrl(Nexus.Brown);

    private Faction target;
    private bool special;

    protected override IEnumerable<Location> PickTargets => BrownRemoveForce.ValidLocations(Game);

    protected override BrownRemoveForce ConfirmedResult => new(Game, Faction) { Location = Target, Target = target, SpecialForce = special };

    // The pinned location decides whose forces are there, so the faction and force type follow it.
    protected override void OnPickChanged()
    {
        var factions = BrownRemoveForce.ValidFactions(Game, Player, Target).ToList();
        if (!factions.Contains(target)) target = factions.FirstOrDefault();
        var choices = BrownRemoveForce.ValidSpecialForceChoices(Game, Target, target).ToList();
        if (!choices.Contains(special)) special = choices.FirstOrDefault();
    }

    private void SetTarget(Faction f)
    {
        target = f;
        var choices = BrownRemoveForce.ValidSpecialForceChoices(Game, Target, target).ToList();
        if (!choices.Contains(special)) special = choices.FirstOrDefault();
        RefreshPin();
    }

    private void SetSpecial(bool value)
    {
        special = value;
        RefreshPin();
    }

    private TreacheryCard? CardToUse => BrownRemoveForce.CardToUse(Player);

    protected override RenderFragment PinContent => __builder =>
    {
        var factions = BrownRemoveForce.ValidFactions(Game, Player, Target).ToList();
        var choices = BrownRemoveForce.ValidSpecialForceChoices(Game, Target, target).ToList();
        var victim = Game.GetPlayer(target);

        <div class="pin-body">
            @if (factions.Count > 1)
            {
                <div class="pin-hint">Whose force?</div>
                <div class="pin-choice">
                    @foreach (var f in factions)
                    {
                        <button type="button" class="@(f == target ? "on" : "")" @onclick="@(() => SetTarget(f))">@Name(f)</button>
                    }
                </div>
            }
            else if (factions.Count == 1)
            {
                <div class="pin-hint"><FactionChip Faction=@factions[0] Game=Game/></div>
            }
            @if (choices.Count > 1 && victim != null)
            {
                <div class="pin-choice">
                    <button type="button" class="@(special ? "" : "on")" @onclick="@(() => SetSpecial(false))">@Name(victim.Force)</button>
                    <button type="button" class="@(special ? "on" : "")" @onclick="@(() => SetSpecial(true))">@Name(victim.SpecialForce)</button>
                </div>
            }
            @PinActions("Remove force")
        </div>
    };
}
