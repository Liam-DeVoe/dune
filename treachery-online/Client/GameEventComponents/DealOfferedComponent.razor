@inherits GameEventComponent<DealOffered>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()" Collapsed="CollapseState.Collapsed">

    <Header>Offer a Deal</Header>
    <Body>

        @* Every faction starts picked, which means the offer goes to everyone.
           Click drops a faction; shift-click offers to that faction alone. *@
        <SelectFromImageComponent Selected="to" Values="Targets" T="Faction" OnChanged="StateHasChanged" Required="false" ImageWidth="40">
            <Label>Offer to</Label>
        </SelectFromImageComponent>

        @* One payment, in one direction. The event keeps Price (they pay you) and
           Benefit (you pay them) as separate fields; only one of them is ever set here. *@
        <label class="d-block mt-1 mb-0">Payment on accepting</label>
        <div class="d-flex align-items-center flex-wrap gap-2">
            <SegmentedComponent @bind-Value="theyPay" Values="@(new[] { true, false })" ValueLabels="@(new[] { "They pay you", "You pay them" })" Class=""/>
            <SelectResourcesComponent @bind-Value="amount" Min="0" Max="50"/>
        </div>
        
        @{
            var dealTypes = DealOffered.GetStandardDealTypes(Game, Player).ToList();
            <SelectComponent @bind-Value="type" Values=@dealTypes ValueLabels=@dealTypes.Select(dt => Deal.Express(dt).ToString(Client.CurrentSkin))>
                <Label>Type of deal</Label>
            </SelectComponent>
        }

        <SegmentedComponent @bind-Value="until" Values="ApplicableEndPhases">
            <Label>Until</Label>
        </SegmentedComponent>

        <textarea class="form-control mt-1" rows="5" @bind="text" maxlength="512" placeholder="Deal description"></textarea>

        <ButtonRowComponent Confirm="ConfirmOffer" ConfirmText="Offer Deal" ConfirmError="@OfferError" />

    </Body>

</GameEventComponentLayout>

@code {

    private List<Faction>? _to;

    // Starts as every target. Kept across renders; a faction that stops being
    // a target (say, by becoming an ally) is ignored rather than removed.
    private List<Faction> to => _to ??= Targets.ToList();

    private IEnumerable<Faction> Targets => Game.PlayersOtherThan(Player).Where(p => p != Player.Ally);

    private Faction[] Picked => Targets.Where(to.Contains).ToArray();

    private Message OfferError => Picked.Length == 0 ? Message.Express("Pick at least one faction") : Validation;

    private bool theyPay = true;
    private int amount;
    private DealType type;
    private string text = "";
    private Phase until;

    private void OnChangeFactions()
    {
        StateHasChanged();
    }

    protected override DealOffered ConfirmedResult => new(Game, Faction) { To = Targets.All(to.Contains) ? Array.Empty<Faction>() : Picked, Price = theyPay ? amount : 0, Benefit = theyPay ? 0 : amount, Type = type, Text = text, EndPhase = until };

    private async Task ConfirmOffer()
    {
        await Confirm();
        text = "";
    }

    private IEnumerable<Phase> ApplicableEndPhases
    {
        get
        {
            return type switch
            {
                DealType.ShareStormPrescience => new[] { Phase.TurnConcluded },
                DealType.ShareBiddingPrescience => new[] { Phase.Bidding, Phase.BiddingReport },
                DealType.ShareResourceDeckPrescience => new[] { Phase.TurnConcluded },
                _ => new[] { Phase.TurnConcluded, Phase.GameEnded }
            };
        }
    }
}
