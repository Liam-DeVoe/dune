@inherits MapPickComponent<DiscoveryEntered>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Enter a discovered stronghold?</Header>
    <Body>

        <div class="small">Use the map to choose a location.</div>

        <ButtonRowComponent Pass="Pass" PassText="Don't enter" />

    </Body>

</GameEventComponentLayout>

@code {

    private Dictionary<Location, Battalion> forces = new();

    protected override IEnumerable<Location> PickTargets => DiscoveryEntered.ValidTargets(Game, Player);

    private DiscoveredLocation? To => Target as DiscoveredLocation;

    private IEnumerable<Location> Sources => To != null ? DiscoveryEntered.ValidSources(Player, To) : [];

    protected override void OnGameChanged()
    {
        forces.Clear();
    }

    // The forces that may enter are the ones next to the pinned stronghold; start with all of them.
    protected override void OnPickChanged()
    {
        forces.Clear();
        foreach (var l in Sources)
        {
            forces[l] = new Battalion(Faction, Player.ForcesIn(l), Player.SpecialForcesIn(l), l);
        }
    }

    protected override DiscoveryEntered ConfirmedResult => new(Game, Faction) { ForceLocations = forces, To = To, Passed = false };

    protected override DiscoveryEntered PassedResult => new(Game, Faction) { Passed = true };

    private void SetAmount(Location l, int amount, bool special)
    {
        if (!forces.TryGetValue(l, out var battalion)) return;
        if (special) battalion.AmountOfSpecialForces = amount;
        else battalion.AmountOfForces = amount;
        RefreshPin();
    }

    protected override RenderFragment PinContent => __builder =>
    {
        <div class="pin-body">
            @foreach (var kvp in forces)
            {
                var l = kvp.Key;
                var b = kvp.Value;
                <div class="pin-row">
                    @if (forces.Count > 1)
                    {
                        <span class="pin-from">@Name(l)</span>
                    }
                    @if (Player.ForcesIn(l) > 0)
                    {
                        <MapForceStepper Value="@b.AmountOfForces" ValueChanged="@(v => SetAmount(l, v, false))" Min="0" Max="@Player.ForcesIn(l)" Faction="Faction" Special="false"/>
                    }
                    @if (Player.SpecialForcesIn(l) > 0)
                    {
                        <MapForceStepper Value="@b.AmountOfSpecialForces" ValueChanged="@(v => SetAmount(l, v, true))" Min="0" Max="@Player.SpecialForcesIn(l)" Faction="Faction" Special="true"/>
                    }
                </div>
            }
            @PinActions("Enter")
        </div>
    };
}
