@inherits PlacementComponent<FremenRidesMonster>

@*
 The worm is ridden on the map: click the sector holding the forces that ride,
 then where they ride to. The Great Maker is ridden from reserves, so there is
 no source to click and the arrow starts at the Fremen token. The counters and
 the Ride button are pinned to the arrow. This panel names the worm and offers
 Pass.
*@

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header><ExpressionComponent Expression=@TitleMessage.Expression Game=Game Size="20"/></Header>
    <Body>

        <div class="small">Use the map to ride the worm.</div>

        <ButtonRowComponent Pass="Pass" PassText="Pass" />

    </Body>

</GameEventComponentLayout>

@code {

    protected override bool IsUrgent => true;

    protected override Faction IsFactionSpecific => Faction.Fremen;

    // The component can outlive the worm by a render, so every lookup copes with there being none.
    private MonsterAppearence? ToRide => FremenRidesMonster.ToRide(Game);

    private IEnumerable<Location> RideSources => ToRide != null ? FremenRidesMonster.ValidSources(Game) : [];

    protected override bool FromReserves => !RideSources.Any() && (MaxFromReserves(false) > 0 || MaxFromReserves(true) > 0);

    protected override int MaxFromReserves(bool special) => FremenRidesMonster.MaxForcesFromReserves(Game, Player, special);

    protected override IEnumerable<Territory> ValidSources => RideSources.Select(l => l.Territory).Distinct();

    protected override IEnumerable<Location> SelectableSources => RideSources;

    // Where the worm may go does not depend on which forces ride, but the
    // destinations only light up once there is something to ride with.
    protected override IEnumerable<Location> ValidTargets =>
        FromReserves || forces.Count > 0
            ? FremenRidesMonster.ValidTargets(Game, Player).OrderByDescending(l => l.IsStronghold).ThenBy(l => Client.CurrentSkin.Describe(l))
            : [];

    protected override FremenRidesMonster ConfirmedResult => new(Game, Faction) { ForceLocations = forces, To = toLocation, ForcesFromReserves = forcesFromReserves, SpecialForcesFromReserves = specialForcesFromReserves, Passed = false };

    protected override FremenRidesMonster PassedResult => new(Game, Faction) { Passed = true };

    protected override bool InformAboutCaravan => false;

    protected override string Title => TitleMessage.ToString(Client.CurrentSkin);

    // The header, with the worm and the territory drawn as in the log.
    private Message TitleMessage
    {
        get
        {
            var toRide = ToRide;
            if (toRide == null)
            {
                return Message.Express("Ride ", Concept.Monster, "?");
            }

            if (toRide.IsGreatMonster)
            {
                return Message.Express("Ride the ", Concept.GreatMonster, " with forces from your reserves?");
            }

            return Message.Express("Ride the Worm that appeared in ", toRide.Territory, "?");
        }
    }

    protected override string ConfirmLabel => "Ride!";

    protected override bool MayPass => true;
}
