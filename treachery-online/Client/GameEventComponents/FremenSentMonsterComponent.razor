@inherits MapPickComponent<FremenSentMonster>

@* No panel: the status line above says what to do, and the territory is picked on the map. *@

@code {

    protected override bool IsUrgent => true;
    protected override Faction IsFactionSpecific => Faction.Fremen;

    protected override bool PickByTerritory => true;

    protected override IEnumerable<Location> PickTargets => SectorsOf(FremenSentMonster.ValidTargets(Game));

    protected override FremenSentMonster ConfirmedResult => new(Game, Faction) { Territory = TargetTerritory };

    protected override RenderFragment PinContent => __builder =>
    {
        <div class="pin-body">
            @PinActions(Client.CurrentSkin.Format("Appear in {0}", TargetTerritory))
        </div>
    };
}
