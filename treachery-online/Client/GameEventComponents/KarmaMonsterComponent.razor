@inherits MapPickComponent<KarmaMonster>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Use @Client.CurrentSkin.Describe(TreacheryCardType.Karma) to make <MonsterIcon/> appear in a territory of choice</Header>
    <Body>

        <div class="small">Use the map to choose a territory.</div>

    </Body>

</GameEventComponentLayout>

@code {

    protected override Faction IsFactionSpecific => Faction.Fremen;

    protected override bool PickByTerritory => true;

    protected override IEnumerable<Location> PickTargets => SectorsOf(KarmaMonster.ValidTargets(Game));

    protected override KarmaMonster ConfirmedResult => new(Game, Faction) { Territory = TargetTerritory };

    protected override RenderFragment PinContent => __builder =>
    {
        <div class="pin-body">
            @PinActions(Client.CurrentSkin.Format("Use {0}", TreacheryCardType.Karma))
        </div>
    };
}
