@inherits MapPickComponent<NexusPlayed>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Nexus: Play <FactionChip Faction="@Player.Nexus" Game=Game/> @NexusTypeText</Header>
    <Body>

        @{
            var cunning = NexusPlayed.CanUseCunning(Player);
            var secretAlly = NexusPlayed.CanUseSecretAlly(Game, Player);
            var betrayal = NexusPlayed.CanUseBetrayal(Game, Player);

            switch (Player.Nexus)
            {
                case Faction.Atreides when betrayal:                    
                    <div>Prevent @Name(FactionAdvantage.AtreidesBattlePlanPrescience)?</div>
                    break;                
                    
                case Faction.Atreides when cunning || secretAlly:
                    <RadioComponent @bind-Value=@atreidesPrescienceAspect Values=@Prescience.ValidAspects(Game, Player)>
                        <Label>What should be foreseen?</Label>
                    </RadioComponent>
                    break;

                case Faction.Harkonnen when betrayal: 
                    <div>Cancel the revealed <FactionChip Faction=@Faction.Harkonnen Game=Game/> traitor?</div>
                    break;

                case Faction.Harkonnen when cunning:
                    <div>Draw a new Traitor card, then shufle one of your traitors back into the traitor deck?</div>
                    break;

                case Faction.Harkonnen when secretAlly:
                    <div>Draw two Traitor cards, then shufle two of your traitors back into the traitor deck?</div>
                    break;

                case Faction.Fremen when betrayal && Game.CurrentMainPhase == MainPhase.Blow:
                    <div>Prevent <FactionChip Faction=@Faction.Fremen Game=Game/> from riding <MonsterIcon/>?</div>
                    break;

                case Faction.Fremen when betrayal && Game.CurrentMainPhase == MainPhase.ShipmentAndMove:
                    <div>Prevent <FactionChip Faction=@Faction.Fremen Game=Game/> moving 2 territories?</div>
                    break;

                case Faction.Fremen when cunning:
                    <div>Let forces in another territory where <MonsterIcon/> appeared ride?</div>
                    break;

                case Faction.Fremen when secretAlly && Game.CurrentMainPhase == MainPhase.Blow:
                    <div>Avoid <MonsterIcon/> devouring your forces?</div>
                    break;

                case Faction.Fremen when secretAlly && Game.CurrentMainPhase == MainPhase.Resurrection:
                    <div>Get 3 free revivals?</div>
                    break;

                case Faction.Emperor when betrayal && Game.CurrentMainPhase == MainPhase.Bidding:
                    <div>Force <FactionChip Faction=@Faction.Emperor Game=Game/> to pay for the next card their ally buys?</div>
                    break;

                case Faction.Emperor when betrayal && Game.CurrentMainPhase == MainPhase.Battle:
                    <div>Let <ForceToken Faction=Faction.Emperor Special="true" Size="20"/> count as <ForceToken Faction=Faction.Emperor Size="20"/> in this battle?</div>
                    break;

                case Faction.Emperor when cunning:
                    <div>Let up to 5 <ForceToken Faction=Faction.Emperor Size="20"/> count as <ForceToken Faction=Faction.Emperor Special="true" Size="20"/> in this battle?</div>
                    break;

                case Faction.Guild when betrayal:
                    <div>Gain the payment for this shipment in full?</div>
                    break;

                case Faction.Guild when cunning:
                    <div>Make a second shipment after performing your move?</div>
                    break;

                case Faction.Guild when secretAlly:
                    <div>Ship at <FactionChip Faction=Faction.Guild Game=Game/> rates or perform a shipment cross-planet or to reserves?</div>
                    break;

                case Faction.BeneGesserit when betrayal:
                    <div>Prevent @Name(FactionAdvantage.BeneGesseritUsingVoice)?</div>
                    break;

                case Faction.BeneGesserit when cunning:
                    <div>Be able to flip advisor to fighters during @Name(MainPhase.ShipmentAndMove)?</div>
                    break;

                case Faction.Ixian when betrayal && Game.CurrentPhase < Phase.IxianSelectingCard:
                    <div>Prevent @Name(FactionAdvantage.IxianSelectingCardsOnAuction)?</div>
                    break;

                case Faction.Ixian when betrayal && Game.CurrentPhase > Phase.IxianSelectingCard:
                    <div>Prevent @Name(FactionAdvantage.IxianSwappingCard)?</div>
                    break;

                case Faction.Ixian when cunning:
                    <div>Let all <ForceToken Faction=Faction.Ixian Size="20"/> in this battle count full strength?</div>
                    break;

                case Faction.Tleilaxu when betrayal:
                    <div>Cancel the revealed <FactionChip Faction=@Faction.Tleilaxu Game=Game/> face dancer?</div>
                    break;

                case Faction.Tleilaxu when cunning:
                    <div>Replace your revealed face dancers?</div>
                    break;

                case Faction.Tleilaxu when secretAlly:
                    <div>Revive up to 5 forces for <SpiceComponent Amount="1"/> each and one leader for free?</div>
                    if (NexusPlayed.ValidTleilaxuMaxAmount(Game, Player, false) > 0)
                    {
                        <SelectForcesComponent @bind-Value="tleilaxuAmountOfForces" Min="0" Max="NexusPlayed.ValidTleilaxuMaxAmount(Game, Player, false)" Faction="Faction" Special="false" />
                    }
                    else
                    {
                        tleilaxuAmountOfForces = 0;
                    }

                    if (NexusPlayed.ValidTleilaxuMaxAmount(Game, Player, true) > 0)
                    {
                        <SelectForcesComponent @bind-Value="tleilaxuAmountOfSpecialForces" Min="0" Max="NexusPlayed.ValidTleilaxuMaxAmount(Game, Player, true)" Faction="Faction" Special="true" />
                    }
                    else
                    {
                        tleilaxuAmountOfSpecialForces = 0;
                    }

                    var maxSpecialForcesPlacedOnPlanet = Revival.ValidRevivedForceLocations(Game, Player).Any() ? Revival.NumberOfSpecialForcesThatMayBePlacedOnPlanet(Player, tleilaxuAmountOfSpecialForces) : 0;
                    if (maxSpecialForcesPlacedOnPlanet > 0)
                    {
                        <div>
                            <SelectForcesComponent Label="Place forces on the planet?" @bind-Value="tleilaxuAmountOfSpecialForcesToLocation" Min=0 Max=maxSpecialForcesPlacedOnPlanet Faction=Faction Special="true"/>
                        </div>
                    }
                    else
                    {
                        tleilaxuAmountOfSpecialForcesToLocation = 0;
                    }

                    if (tleilaxuAmountOfSpecialForcesToLocation > 0)
                    {
                        <div class="small">Use the map to choose where to place them.</div>
                    }

                    <SelectFromImageComponent Game="Game" @bind-Value="tleilaxuHero" Values="NexusPlayed.ValidTleilaxuHeroes(Game, Player)" Required="false" ImageWidth="80"/>

                    if (tleilaxuHero != null && Revival.MayAssignSkill(Game, Player, tleilaxuHero))
                    {
                        <RadioComponent @bind-Value="tleilaxuAssignSkill" Values="@(new[] {false,true})" ValueLabels="@(new[] {"No","Yes"})">
                            <Label>Do you wish to assign a skill to this leader?</Label>
                        </RadioComponent>
                    }
                    else
                    {
                        tleilaxuAssignSkill = false;
                    }

                    <div class="mt-1 text-end">Revival cost for you: <SimpleNumberComponent>@NexusPlayed.DetermineTleilaxuCost(tleilaxuAmountOfForces, tleilaxuAmountOfSpecialForces)</SimpleNumberComponent></div>

                    break;

                case Faction.Choam when betrayal:
                    <div>Force <FactionChip Faction=@Faction.Choam Game=Game/> to discard a random card from their hand?</div>
                    break;

                case Faction.Choam when secretAlly && Game.CurrentMainPhase == MainPhase.Collection:
                    <div>Discard a @Client.CurrentSkin.Describe(TreacheryCardType.Useless) card for <SpiceComponent Amount="2"/>?</div>
                    <SelectFromImageComponent @bind-Value=choamCard Values="NexusPlayed.ValidChoamCards(Player)" Required="true" ImageWidth="80" />
                    break;

                case Faction.Choam when secretAlly && Game.CurrentMainPhase == MainPhase.Battle:
                    <div>Look at a random card not used in battle owned by your opponent?</div>
                    break;

                case Faction.Richese when betrayal:
                    if (Game.GetPlayer(Faction.Richese).TreacheryCards.Contains(Game.CardJustWon))
                    {
                        <div>Force <FactionChip Faction=@Faction.Richese Game=Game/> to discard the <RichText Shown=@Game.CardJustWon Game=Game/> they just bought?</div>
                    }
                    else
                    {
                        <div>Prevent <FactionChip Faction=@Faction.Richese Game=Game/> from getting paid for a card they sold?</div>
                    }
                    break;

                case Faction.Ecaz when betrayal:
                    <div>Return all <FactionChip Faction=@Faction.Ecaz Game=Game/> forces <ForceToken Faction=@Faction.Ecaz Size="20"/> in a territory they occupy with their ally to reserves?</div>
                    <div class="small">Use the map to choose a territory.</div>
                    break;

                case Faction.Ecaz when cunning:
                    <div>Gain <Image Shown=Game.Vidal Width="30"/> this turn?</div>
                    break;

                case Faction.Ecaz when secretAlly:
                    <div>Force a faction to reveal whether or not they have any of your leaders as traitor?</div>
                    <SelectFromImageComponent @bind-Value=ecazFaction Values=@NexusPlayed.ValidEcazFactions(Game) ImageWidth="40" Required="true"/>
                    break;

                case Faction.Moritani when betrayal:
                    <div>Remove a Terror token from a stronghold?</div>
                    <div class="small">Use the map to choose a stronghold.</div>
                    break;

            }
        }

        <ButtonRowComponent Confirm="Confirm" ConfirmError="@Validation" />

    </Body>

</GameEventComponentLayout>

@code {

    protected override bool IsUrgent => true;
    protected override Faction IsFactionSpecific => Faction.Ecaz;

    private PrescienceAspect atreidesPrescienceAspect;

    private int tleilaxuAmountOfForces;
    private int tleilaxuAmountOfSpecialForces;
    private IHero? tleilaxuHero;
    private bool tleilaxuAssignSkill;
    private int tleilaxuAmountOfSpecialForcesToLocation;

    private TreacheryCard? choamCard;

    private Faction ecazFaction;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        BackgroundImage = Client.CurrentSkin.GetImageUrl(Player.Nexus.ToNexus());
    }

    // Which of the card's effects asks for a place on the map, if any.
    private enum MapChoice { None, TleilaxuLocation, EcazTerritory, MoritaniTerritory }

    private MapChoice CurrentPick => Player.Nexus switch
    {
        Faction.Tleilaxu when NexusPlayed.CanUseSecretAlly(Game, Player) && tleilaxuAmountOfSpecialForcesToLocation > 0 => MapChoice.TleilaxuLocation,
        Faction.Ecaz when NexusPlayed.CanUseBetrayal(Game, Player) => MapChoice.EcazTerritory,
        Faction.Moritani when NexusPlayed.CanUseBetrayal(Game, Player) => MapChoice.MoritaniTerritory,
        _ => MapChoice.None
    };

    protected override bool PickEnabled => CurrentPick != MapChoice.None;

    protected override bool PickByTerritory => CurrentPick is MapChoice.EcazTerritory or MapChoice.MoritaniTerritory;

    protected override IEnumerable<Location> PickTargets => CurrentPick switch
    {
        MapChoice.TleilaxuLocation => Revival.ValidRevivedForceLocations(Game, Player),
        MapChoice.EcazTerritory => SectorsOf(NexusPlayed.ValidEcazTerritories(Game)),
        MapChoice.MoritaniTerritory => SectorsOf(NexusPlayed.ValidMoritaniTerritories(Game)),
        _ => []
    };

    private Territory? ecazTerritory => CurrentPick == MapChoice.EcazTerritory ? TargetTerritory : null;

    private Territory? moritaniTerritory => CurrentPick == MapChoice.MoritaniTerritory ? TargetTerritory : null;

    private Location? tleilaxuLocation => CurrentPick == MapChoice.TleilaxuLocation ? Target : null;

    protected override RenderFragment PinContent => __builder =>
    {
        <div class="pin-body">
            @PinActions("Confirm")
        </div>
    };

    protected override NexusPlayed ConfirmedResult => new(Game, Faction)
    {
        Faction = Player.Nexus,
        AtreidesPrescienceAspect = atreidesPrescienceAspect,
        TleilaxuForces = tleilaxuAmountOfForces,
        TleilaxuSpecialForces = tleilaxuAmountOfSpecialForces,
        TleilaxuHero = tleilaxuHero,
        TleilaxuAssignSkill = tleilaxuAssignSkill,
        TleilaxuLocation = tleilaxuLocation,
        TleilaxuNumberOfSpecialForcesInLocation = tleilaxuAmountOfSpecialForcesToLocation,
        ChoamCard = choamCard,
        EcazTerritory = ecazTerritory,
        EcazFaction = ecazFaction,
        MoritaniTerritory = moritaniTerritory
    };

    private string NexusTypeText => NexusPlayed.CanUseCunning(Player) ? "Cunning" : NexusPlayed.CanUseSecretAlly(Game, Player) ? "Secret Ally" : "Betrayal";


}
