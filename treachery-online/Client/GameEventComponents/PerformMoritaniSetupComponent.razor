@inherits MapPickComponent<PerformMoritaniSetup>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Place 6 <ForceToken Faction=Faction Special="false" Size="20" Title="@Name(Player.Force)"/> in an empty territory of your choice.</Header>
    <Body>

        <div class="small">Use the map to choose a location.</div>

    </Body>

</GameEventComponentLayout>

@code {

    protected override bool IsUrgent => true;
    protected override Faction IsFactionSpecific => Faction.Moritani;

    protected override IEnumerable<Location> PickTargets => PerformMoritaniSetup.ValidLocations(Game);

    protected override PerformMoritaniSetup ConfirmedResult => new(Game, Faction) { Target = Target };

    protected override RenderFragment PinContent => __builder =>
    {
        <div class="pin-body">
            @PinActions("Place forces")
        </div>
    };
}
