@inherits StagedPlacementComponent<PerformSetup>
@implements IDisposable

@*
 Custom setup: the host places each faction's starting forces on the map in
 turn, and sets its starting spice. Click a sector for a force, shift-click
 for a special force, right-click to take one back. The list below the
 instructions is a fallback for people who cannot right-click.
*@

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>
        Set <FactionChip Faction="CurrentFaction" Game=Game/> initial @Client.CurrentSkin.Describe(Concept.Resource) and forces.
    </Header>

    <Body>

        <SelectResourcesComponent @bind-Value="resources" Min="0" Max="100" Label="@Client.CurrentSkin.Describe(Concept.Resource)" />

        <div class="small mt-2">Use the map to place forces.</div>
        <div class="small text-2">
            <div><ClickHintComponent Button="ClickHintButton.Lmb" /> place <ForceToken Faction="Placer.Faction" Size="18" ImgClass="setup-hint-force" Title="@Name(Placer.Force)"/></div>
            @if (MayStageSpecial)
            {
                <div><ClickHintComponent Button="ClickHintButton.Lmb" Modifier="ClickHintModifier.Shift" /> place <ForceToken Faction="Placer.Faction" Special="true" Size="18" ImgClass="setup-hint-force" Title="@Name(Placer.SpecialForce)"/></div>
            }
            <div><ClickHintComponent Button="ClickHintButton.Rmb" /> remove force</div>
        </div>

        @if (Staged.Any())
        {
            <div class="mt-2">
                @foreach (var kvp in Staged)
                {
                    var l = kvp.Key;
                    var b = kvp.Value;
                    <div class="d-flex align-items-center gap-1 mt-1 small">
                        <span class="flex-grow-1"><PlaceChip Place=@l/></span>
                        <MapForceStepper Value="@b.AmountOfForces" ValueChanged="@(v => Step(l, v, false))" Min="0" Max="@(b.AmountOfForces + Room(false))" Faction="CurrentFaction" Special="false" Label="@Name(Placer.Force)" />
                        @if (MayStageSpecial)
                        {
                            <MapForceStepper Value="@b.AmountOfSpecialForces" ValueChanged="@(v => Step(l, v, true))" Min="0" Max="@(b.AmountOfSpecialForces + Room(true))" Faction="CurrentFaction" Special="true" Label="@Name(Placer.SpecialForce)" />
                        }
                    </div>
                }
            </div>
        }

        @if (Validation is { } error)
        {
            <div class="small text-danger mt-2"><ExpressionComponent Expression=@(error.Expression) Game=Game/></div>
        }

        <ButtonRowComponent Confirm="Confirm" ConfirmText="Confirm" ConfirmError="@Validation" />

    </Body>

</GameEventComponentLayout>

@code {

    protected override bool IsUrgent => true;

    private Player? currentPlayer;
    private int resources;

    protected override PerformSetup ConfirmedResult => new(Game, Faction) { Passed = false, Resources = resources, ForceLocations = forces };

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        SyncPlacer();
    }

    // A game update does not reach OnParametersSet (this component has no
    // parameters), so the faction switch is also checked on every refresh.
    protected override void Redraw()
    {
        SyncPlacer();
        base.Redraw();
    }

    private void SyncPlacer()
    {
        var next = Game.NextFactionToPerformCustomSetup;
        if (next == Faction.None || currentPlayer?.Faction == next) return;

        currentPlayer = Game.GetPlayer(next);
        resources = 0;
        ResetStaging();
    }

    protected override Player Placer => currentPlayer ?? Game.GetPlayer(Game.NextFactionToPerformCustomSetup);

    // Richese's special forces are No-Field tokens, which are not placed this way.
    protected override bool MayStageSpecial => Placer.HasSpecialForces && !Placer.Is(Faction.Richese);

    protected override IEnumerable<Location> ValidLocations => Game.Map.Locations(false);

    private Faction CurrentFaction => Placer.Faction;

    private void Step(Location l, int value, bool special)
    {
        var current = special ? forces[l].AmountOfSpecialForces : forces[l].AmountOfForces;
        if (value > current) Add(l, special);
        else if (value < current) Remove(l, special);
    }
}
