@inherits StagedPlacementComponent<PerformYellowSetup>
@implements IDisposable

@*
 The Fremen place their starting forces on the map: click a sector for a
 force, shift-click for a Fedaykin, right-click to take one back. The list
 below the instructions is a fallback for people who cannot right-click.
*@

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>
        @if (Remaining > 0)
        {
            <text>Distribute @Remaining <ForceToken Faction="Player.Faction" Size="20" Title="@Name(Player.Force)"/> on <PlaceChip Place=@Game.Map.SietchTabr/>, <PlaceChip Place=@Game.Map.FalseWallSouth/>, and <PlaceChip Place=@Game.Map.FalseWallWest/>.</text>
        }
        else
        {
            <text>All forces placed.</text>
        }
    </Header>
    <Body>

        <div class="small">Use the map to place forces.</div>
        <div class="small text-2">
            <div><ClickHintComponent Button="ClickHintButton.Lmb" /> place <ForceToken Faction="Player.Faction" Size="18" ImgClass="setup-hint-force" Title="@Name(Player.Force)"/></div>
            @if (MayStageSpecial)
            {
                <div><ClickHintComponent Button="ClickHintButton.Lmb" Modifier="ClickHintModifier.Shift" /> place <ForceToken Faction="Player.Faction" Special="true" Size="18" ImgClass="setup-hint-force" Title="@Name(Player.SpecialForce)"/></div>
            }
            <div><ClickHintComponent Button="ClickHintButton.Rmb" /> remove force</div>
        </div>

        @if (Staged.Any())
        {
            <div class="mt-2">
                @foreach (var kvp in Staged)
                {
                    var l = kvp.Key;
                    var b = kvp.Value;
                    <div class="d-flex align-items-center gap-1 mt-1 small">
                        <span class="flex-grow-1"><PlaceChip Place=@l/></span>
                        <MapForceStepper Value="@b.AmountOfForces" ValueChanged="@(v => Step(l, v, false))" Min="0" Max="@(b.AmountOfForces + Room(false))" Faction="Faction" Special="false" Label="@Name(Player.Force)" />
                        @if (MayStageSpecial)
                        {
                            <MapForceStepper Value="@b.AmountOfSpecialForces" ValueChanged="@(v => Step(l, v, true))" Min="0" Max="@(b.AmountOfSpecialForces + Room(true))" Faction="Faction" Special="true" Label="@Name(Player.SpecialForce)" />
                        }
                    </div>
                }
            </div>
        }

        @if (Validation is { } error)
        {
            <div class="small text-danger mt-2"><ExpressionComponent Expression=@(error.Expression) Game=Game/></div>
        }

        <ButtonRowComponent Confirm="Confirm" ConfirmText="Confirm" ConfirmError="@Validation" />

    </Body>

</GameEventComponentLayout>

@code {

    protected override bool IsUrgent => true;
    protected override Faction IsFactionSpecific => Faction.Yellow;

    protected override PerformYellowSetup ConfirmedResult => new(Game, Faction) { ForceLocations = forces };

    protected override Player Placer => Player;

    protected override int MaxTotal => 10;

    private int Remaining => MaxTotal - StagedForces - StagedSpecialForces;

    protected override IEnumerable<Location> ValidLocations =>
        [Game.Map.SietchTabr, .. Game.Map.FalseWallSouth.Locations, .. Game.Map.FalseWallWest.Locations];

    private void Step(Location l, int value, bool special)
    {
        var current = special ? forces[l].AmountOfSpecialForces : forces[l].AmountOfForces;
        if (value > current) Add(l, special);
        else if (value < current) Remove(l, special);
    }
}
