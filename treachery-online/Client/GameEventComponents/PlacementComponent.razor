@using Treachery.Client.MapComponents
@inherits GameEventComponent<PlacementEventType>
@typeparam PlacementEventType

@*
 A move is made on the map: click the sector to move from, then the sector to
 move to. The force counter and the confirm button appear on the map, pinned
 to the arrow. This panel only explains the next step and offers Pass.
*@

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>@(Title)?</Header>
    <Body>

        @if (InformAboutCaravan)
        {
            <div class="text-info small">Note: if you wish to perform a @Client.CurrentSkin.Describe(TreacheryCardType.Caravan) this turn, you need to do that before performing your regular move.</div>
        }

        @if (ValidSources.Any())
        {
            @if (OwnsMap)
            {
                <div class="small">Use the map to move forces.</div>
                @if (!ClaimsMapByDefault)
                {
                    <button class="btn btn-secondary btn-sm mt-1" @onclick="ReleaseMap">Cancel</button>
                }
            }
            else if (ClaimsMapByDefault)
            {
                <div class="small text-2">Finish the extra move on the map first, or cancel it.</div>
            }
            else
            {
                <button class="btn btn-secondary btn-sm" @onclick="ClaimMap">@Client.CurrentSkin.Format("Play {0}", TreacheryCardType.Caravan)</button>
            }

            @if (MayPass)
            {
                <ButtonRowComponent Pass="Pass" PassText="Pass" />
            }
        }
        else if (MayPass)
        {
            <ButtonRowComponent Pass="Pass" PassText="Pass" />
        }

    </Body>

</GameEventComponentLayout>

@code {

    protected Location? toLocation;

    // A sector clicked while it could either join the sources or be the
    // destination. The map shows both choices there until the player picks.
    private Location? undecidedPick;
    protected Dictionary<Location, Battalion> forces = new();
    protected bool asAdvisors;
    protected int forcesFromReserves;
    protected int specialForcesFromReserves;
    private Game? selectionGame;
    private MapInteraction? localMap;

    // The regular move takes the map as soon as it appears. An optional extra
    // move (the Caravan card) waits until the player asks for it.
    protected virtual bool ClaimsMapByDefault => true;

    // Some placements bring forces from reserves instead of from a sector,
    // such as the Fremen riding the Great Maker. There is nothing to click as
    // a source: the arrow starts at the player's token and the counters in
    // the pinned panel draw from reserves.
    protected virtual bool FromReserves => false;

    protected virtual int MaxFromReserves(bool special) => 0;

    // The header shows Title as a question; the pinned confirm button shows this.
    protected virtual string ConfirmLabel => Title;

    private MapInteraction Map => Client.MapInteraction ?? (localMap ??= new MapInteraction());

    protected bool OwnsMap => Map.IsOwnedBy(this);

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (ReferenceEquals(selectionGame, Game))
            return;

        selectionGame = Game;
        ResetSelection();

        if (OwnsMap) PushToMap();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Client.OnLocationSelected += HandleLocationSelected;
            Map.Changed += HandleMapChanged;
            if (ClaimsMapByDefault) ClaimIfFree();
        }
    }

    public override void Dispose()
    {
        base.Dispose();
        Client.OnLocationSelected -= HandleLocationSelected;
        Map.Changed -= HandleMapChanged;
        Map.Release(this);
    }

    protected virtual IEnumerable<Territory> ValidSources => PlacementEvent.ValidMovementSources(Game, Player);

    protected virtual IEnumerable<Location> ValidTargets
    {
        get
        {
            if (forces.Sum(kvp => kvp.Value.TotalAmountOfForces) > 0)
            {
                return PlacementEvent.ValidTargets(Game, Player, forces).OrderByDescending(l => l.IsStronghold).ThenBy(l => Client.CurrentSkin.Describe(l));
            }

            return Array.Empty<Location>();
        }
    }

    // The sectors that may be clicked as a source.
    protected virtual IEnumerable<Location> SelectableSources =>
        ValidSources.SelectMany(t => t.Locations).Where(l => Player.AnyForcesIn(l) > 0 && !Game.IsInStorm(l));

    private bool MayMoveFromTwoTerritories =>
        Game.CurrentPlanetology != null && Game.CurrentPlanetology.MoveFromTwoTerritories && Game.CurrentPlanetology.Initiator == Faction;

    private int SelectedTerritoryCount => forces.Keys.Select(l => l.Territory).Distinct().Count();

    private bool MayAddSource(Location l) =>
        forces.Count == 0 ||
        forces.Keys.Any(k => k.Territory == l.Territory) ||
        (MayMoveFromTwoTerritories && SelectedTerritoryCount < 2);

    private void ResetSelection()
    {
        forces.Clear();
        toLocation = null;
        undecidedPick = null;
        asAdvisors = false;
        forcesFromReserves = 0;
        specialForcesFromReserves = 0;
    }

    // Like a shipment, a ride from reserves opens with one force selected.
    private void InitializeReserveAmounts()
    {
        forcesFromReserves = Math.Min(1, MaxFromReserves(false));
        specialForcesFromReserves = forcesFromReserves == 0 ? Math.Min(1, MaxFromReserves(true)) : 0;
    }

    private void ClaimIfFree()
    {
        if (!Map.IsFree) return;
        Map.Claim(this);
        PushToMap();
    }

    private void ClaimMap()
    {
        Map.Claim(this);
        PushToMap();
    }

    private void ReleaseMap()
    {
        ResetSelection();
        Map.Release(this);
    }

    private void HandleMapChanged()
    {
        if (Map.IsFree && ClaimsMapByDefault)
        {
            ClaimIfFree();
        }
        else if (!OwnsMap && (forces.Count > 0 || toLocation != null))
        {
            // Another action took the map; a half-made selection would be stale.
            ResetSelection();
        }
        StateHasChanged();
    }

    private void PushToMap()
    {
        Map.Faction = Faction;
        Map.Selectable.Clear();
        foreach (var l in SelectableSources) Map.Selectable.Add(l);
        Map.Selected.Clear();
        Map.Selected.AddRange(forces.Keys);
        Map.Targets.Clear();
        foreach (var l in ValidTargets) Map.Targets.Add(l);
        Map.Target = toLocation;
        Map.Origin = FromReserves ? SectorGeometry.PlayerTokenPosition(Client.CurrentSkin, Game, Player.Seat) : null;
        Map.EndPoint = undecidedPick != null ? Client.CurrentSkin.GetCenter(undecidedPick, Game.Map) : null;
        Map.Pin = toLocation != null ? PinContent : undecidedPick != null ? ChoiceContent : null;
        Map.OnCancel = ClearSelection;
        Map.Refresh();
    }

    private void HandleLocationSelected(object? sender, Location l)
    {
        if (!OwnsMap) return;

        undecidedPick = null;

        if (forces.ContainsKey(l))
        {
            forces.Remove(l);
            toLocation = null;
        }
        else if (toLocation == l)
        {
            toLocation = null;
        }
        else if (ValidTargets.Contains(l) && SelectableSources.Contains(l) && forces.Keys.Any(k => k.Territory == l.Territory))
        {
            // Another sector of a source territory that holds your forces
            // could join the sources, gathering up a territory split by the
            // storm, or be the destination, pulling the sources into it. The
            // click alone cannot tell which, so the map asks.
            undecidedPick = l;
        }
        else if (ValidTargets.Contains(l))
        {
            // With a source chosen, a click means "move here", even on a
            // sector holding more of your forces elsewhere.
            SetDestination(l);
        }
        else if (SelectableSources.Contains(l))
        {
            if (!MayAddSource(l))
            {
                forces.Clear();
            }
            AddSource(l);
        }
        else
        {
            return;
        }

        PushToMap();
        StateHasChanged();
    }

    private void SetDestination(Location l)
    {
        var firstPick = toLocation == null;
        toLocation = l;
        if (FromReserves && firstPick) InitializeReserveAmounts();
    }

    private void AddSource(Location l)
    {
        toLocation = null;
        forces[l] = new Battalion(Faction, Player.ForcesIn(l), Player.SpecialForcesIn(l), l);
    }

    private void DecidePick(bool asDestination)
    {
        var l = undecidedPick;
        undecidedPick = null;
        if (l == null) return;
        if (asDestination) SetDestination(l);
        else AddSource(l);
        PushToMap();
        StateHasChanged();
    }

    private void SetAmount(Location l, int amount, bool special)
    {
        if (!forces.TryGetValue(l, out var battalion)) return;
        if (special) battalion.AmountOfSpecialForces = amount;
        else battalion.AmountOfForces = amount;
        PushToMap();
    }

    private void SetReserveAmount(int amount, bool special)
    {
        if (special) specialForcesFromReserves = amount;
        else forcesFromReserves = amount;
        PushToMap();
    }

    private void SetAsAdvisors(bool value)
    {
        asAdvisors = value;
        PushToMap();
    }

    private void ClearSelection()
    {
        ResetSelection();
        PushToMap();
    }

    private RenderFragment ChoiceContent => __builder =>
    {
        <div class="pin-body">
            <div class="pin-from"><PlaceChip Place=@(undecidedPick!)/></div>
            <div class="pin-actions">
                <button type="button" class="btn btn-secondary" @onclick="@(() => DecidePick(false))">Add as source</button>
                <button type="button" class="btn btn-primary" @onclick="@(() => DecidePick(true))">Move here</button>
            </div>
        </div>
    };

    private RenderFragment PinContent => __builder =>
    {
        var to = toLocation!;
        var showAdvisorChoice = false;

        if (Faction == Faction.BeneGesserit)
        {
            var mayMoveAsAdvisors = PlacementEvent.MayMoveAsAdvisors(Game, Player, to.Territory, forces.Values.Any(b => b.AmountOfSpecialForces > 0));
            showAdvisorChoice = mayMoveAsAdvisors && PlacementEvent.MayMoveAsBeneGesseritFighters(Player, to.Territory);
            if (!showAdvisorChoice) asAdvisors = mayMoveAsAdvisors;
        }
        else
        {
            asAdvisors = false;
        }

        var validation = Validation;

        <div class="pin-body">
            @foreach (var kvp in forces)
            {
                var l = kvp.Key;
                var b = kvp.Value;
                <div class="pin-row">
                    @if (forces.Count > 1)
                    {
                        <span class="pin-from"><PlaceChip Place=@l/></span>
                    }
                    @if (Player.ForcesIn(l) > 0)
                    {
                        <MapForceStepper Value="@b.AmountOfForces" ValueChanged="@(v => SetAmount(l, v, false))" Min="0" Max="@Player.ForcesIn(l)" Faction="Faction" Special="false"/>
                    }
                    @if (Player.SpecialForcesIn(l) > 0)
                    {
                        <MapForceStepper Value="@b.AmountOfSpecialForces" ValueChanged="@(v => SetAmount(l, v, true))" Min="0" Max="@Player.SpecialForcesIn(l)" Faction="Faction" Special="true"/>
                    }
                </div>
            }

            @if (FromReserves)
            {
                <div class="pin-row">
                    @if (MaxFromReserves(false) > 0)
                    {
                        <MapForceStepper Value="@forcesFromReserves" ValueChanged="@(v => SetReserveAmount(v, false))" Min="0" Max="@MaxFromReserves(false)" Faction="Faction" Special="false"/>
                    }
                    @if (MaxFromReserves(true) > 0)
                    {
                        <MapForceStepper Value="@specialForcesFromReserves" ValueChanged="@(v => SetReserveAmount(v, true))" Min="0" Max="@MaxFromReserves(true)" Faction="Faction" Special="true"/>
                    }
                </div>
            }

            @if (showAdvisorChoice)
            {
                <div class="pin-choice">
                    <button type="button" class="@(asAdvisors ? "" : "on")" @onclick="@(() => SetAsAdvisors(false))">Fighters</button>
                    <button type="button" class="@(asAdvisors ? "on" : "")" @onclick="@(() => SetAsAdvisors(true))">Advisors</button>
                </div>
            }

            @if (Game.ContainsConflictingAlly(Player, to))
            {
                <div class="pin-warn">Your ally is there: all your forces there at the end of your move will be destroyed.</div>
            }

            @if (validation != null)
            {
                <div class="pin-error"><ExpressionComponent Expression=@(validation.Expression) Game=Game/></div>
            }

            <div class="pin-actions">
                <button type="button" class="btn btn-secondary" @onclick="ClearSelection">Cancel</button>
                <button type="button" class="btn btn-primary" disabled="@(validation != null)" @onclick="Confirm">@ConfirmLabel</button>
            </div>
        </div>
    };
}
