@inherits MapPickComponent<Retreat>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>You may retreat from the battle any number of undialed forces to an adjacent empty non-stronghold territory</Header>
    <Body>

        <div class="small">Use the map to choose a location.</div>

        <ButtonRowComponent Pass="Pass" PassText="Pass" />

    </Body>

</GameEventComponentLayout>

@code {

    protected override bool IsUrgent => true;

    private int forces;
    private int specialForces;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        BackgroundImage = Client.CurrentSkin.GetImageUrl(LeaderSkill.Diplomat);
    }

    // Start with everything that may retreat, trimmed to what the leader allows.
    protected override void OnGameChanged()
    {
        forces = Retreat.MaxForces(Game, Player);
        specialForces = Retreat.MaxSpecialForces(Game, Player);
        var max = Retreat.MaxTotalForces(Game, Player);
        while (forces + specialForces > max)
        {
            if (specialForces > 0) specialForces--;
            else forces--;
        }
    }

    protected override IEnumerable<Location> PickTargets => Retreat.ValidTargets(Game, Player);

    protected override Retreat ConfirmedResult => new(Game, Faction) { Location = Target, Forces = forces, SpecialForces = specialForces };

    // Passing still names a location, because the event insists on a valid one.
    protected override Retreat PassedResult => new(Game, Faction) { Location = Target ?? Retreat.ValidTargets(Game, Player).FirstOrDefault(), Forces = 0, SpecialForces = 0 };

    private void SetForces(int amount, bool special)
    {
        if (special) specialForces = amount;
        else forces = amount;
        RefreshPin();
    }

    protected override RenderFragment PinContent => __builder =>
    {
        <div class="pin-body">
            <div class="pin-row">
                @if (Retreat.MaxForces(Game, Player) > 0)
                {
                    <MapForceStepper Value="@forces" ValueChanged="@(v => SetForces(v, false))" Min="0" Max="@Retreat.MaxForces(Game, Player)" Faction="Faction" Special="false"/>
                }
                @if (Retreat.MaxSpecialForces(Game, Player) > 0)
                {
                    <MapForceStepper Value="@specialForces" ValueChanged="@(v => SetForces(v, true))" Min="0" Max="@Retreat.MaxSpecialForces(Game, Player)" Faction="Faction" Special="true"/>
                }
            </div>
            @PinActions("Retreat")
        </div>
    };
}
