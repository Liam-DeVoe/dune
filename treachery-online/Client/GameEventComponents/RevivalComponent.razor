@inherits MapPickComponent<Revival>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Select forces and/or leaders to revive</Header>
    <Body>

        @{
            if (Player.Nexus == Faction.Emperor && NexusPlayed.CanUseSecretAlly(Game, Player))
            {
                <CheckboxComponent @bind-Value=@useEmperorSecretAlly>Use your Nexus card to get 3 additional free revivals beyond your revival limit?</CheckboxComponent>
            }
            else
            {
                useEmperorSecretAlly = false;
            }

            if (Revival.ValidMaxRevivals(Game, Player, false, useEmperorSecretAlly) > 0)
            {
                <SelectForcesComponent @bind-Value="amountOfForces" Min="0" Max="Revival.ValidMaxRevivals(Game, Player, false, useEmperorSecretAlly)" Faction="Faction" Special="false" />
            }
            else
            {
                amountOfForces = 0;
            }

            if (Revival.ValidMaxRevivals(Game, Player, true, useEmperorSecretAlly) > 0)
            {
                <SelectForcesComponent @bind-Value="amountOfSpecialForces" Min="0" Max="Revival.ValidMaxRevivals(Game, Player, true, useEmperorSecretAlly)" Faction="Faction" Special="true" />
            }
            else
            {
                amountOfSpecialForces = 0;
            }

            if (Revival.ValidMaxRevivalsByEmperor(Game, Player) > 0)
            {
                <div class="mt-2">You may select up to <SimpleNumberComponent>@Revival.ValidMaxRevivalsByEmperor(Game, Player)</SimpleNumberComponent> <ForceToken Faction=Faction Special="false" Size="20" Title="@Name(Player.Force)"/> to be revived by your ally:</div>

                if (Revival.ValidMaxRevivals(Game, Player, false, useEmperorSecretAlly) > 0)
                {
                    <SelectForcesComponent @bind-Value="forcesPaidByEmperor" Min="0" Max="Revival.ValidMaxRevivalsByEmperor(Game, Player)" Faction="Faction" Special="false" />
                }
                else
                {
                    forcesPaidByEmperor = 0;
                }

                if (Revival.ValidMaxRevivals(Game, Player, true, useEmperorSecretAlly) > 0)
                {
                    <SelectForcesComponent @bind-Value="specialForcesPaidByEmperor" Min="0" Max="Revival.ValidMaxRevivalsByEmperor(Game, Player)" Faction="Faction" Special="true" />
                }
                else
                {
                    specialForcesPaidByEmperor = 0;
                }
            }
            else
            {
                forcesPaidByEmperor = 0;
                specialForcesPaidByEmperor = 0;
            }

            var maxForcesPlacedOnPlanet = Revival.ValidRevivedForceLocations(Game, Player).Any() ? Revival.NumberOfForcesThatMayBePlacedOnPlanet(Game, Player, useEmperorSecretAlly, amountOfForces + forcesPaidByEmperor) : 0;
            var maxSpecialForcesPlacedOnPlanet = Revival.ValidRevivedForceLocations(Game, Player).Any() ? Revival.NumberOfSpecialForcesThatMayBePlacedOnPlanet(Player, amountOfSpecialForces + specialForcesPaidByEmperor) : 0;

            if (maxForcesPlacedOnPlanet > 0)
            {
                <div>
                    <SelectForcesComponent Label="Place forces on the planet?" @bind-Value="amountOfForcesToLocation" Min=0 Max=maxForcesPlacedOnPlanet Faction=Faction Special="false"/>
                </div>
            }
            else
            {
                amountOfForcesToLocation = 0;
            }

            if (maxSpecialForcesPlacedOnPlanet > 0)
            {
                <div>
                    <SelectForcesComponent Label="Place forces on the planet?" @bind-Value="amountOfSpecialForcesToLocation" Min=0 Max=maxSpecialForcesPlacedOnPlanet Faction=Faction Special="true"/>
                </div>
            }
            else
            {
                amountOfSpecialForcesToLocation = 0;
            }

            if (amountOfForcesToLocation > 0 || amountOfSpecialForcesToLocation > 0)
            {
                <div class="small">Use the map to choose where to place them.</div>
            }

            @if (Revival.ValidRevivalHeroes(Game, Player).Any())
            {
                <SelectFromImageComponent Game="Game" @bind-Value="hero" Values="Revival.ValidRevivalHeroes(Game, Player)" Required="false" ImageWidth="80"/>                
            }
            else
            {
                hero = null;
            }

            if (hero != null && Revival.MayAssignSkill(Game, Player, hero))
            {
                <RadioComponent @bind-Value="assignSkill" Values="@(new[] {false,true})" ValueLabels="@(new[] {"No","Yes"})">
                    <Label>Do you wish to assign a skill to this leader?</Label>
                </RadioComponent>
            }
            else
            {
                assignSkill = false;
            }

            <div class="mt-1 text-end">Revival cost for you: <SimpleNumberComponent>@(CostOfRevival.TotalCostForPlayer)</SimpleNumberComponent></div>

            if (Player.Ally == Faction.Emperor)
            {
                <div class="mt-1 text-end">Revival cost for <FactionChip Faction=Faction.Emperor Game=Game/>: <SimpleNumberComponent>@(CostOfRevival.CostForEmperor)</SimpleNumberComponent></div>
            }

            <ButtonRowComponent Confirm="Confirm" ConfirmText="Revive" ConfirmError=@Validation />
        }
    </Body>

</GameEventComponentLayout>

@code {

    private int amountOfForces;
    private int amountOfSpecialForces;
    private int forcesPaidByEmperor;
    private int specialForcesPaidByEmperor;
    private IHero? hero;
    private bool assignSkill;
    private bool useEmperorSecretAlly;
    private int amountOfForcesToLocation;
    private int amountOfSpecialForcesToLocation;

    // The map is only needed while some revived forces go onto the planet.
    protected override bool PickEnabled => amountOfForcesToLocation > 0 || amountOfSpecialForcesToLocation > 0;

    protected override IEnumerable<Location> PickTargets => Revival.ValidRevivedForceLocations(Game, Player);

    protected override RenderFragment PinContent => __builder =>
    {
        <div class="pin-body">
            @PinActions("Revive")
        </div>
    };

    protected override Revival ConfirmedResult => new(Game, Faction)
    {
        AmountOfForces = amountOfForces, 
        AmountOfSpecialForces = amountOfSpecialForces, 
        ExtraForcesPaidByEmperor = forcesPaidByEmperor, 
        ExtraSpecialForcesPaidByEmperor = specialForcesPaidByEmperor, 
        Hero = hero, 
        AssignSkill = assignSkill,
        NumberOfForcesInLocation = amountOfForcesToLocation,
        NumberOfSpecialForcesInLocation = amountOfSpecialForcesToLocation,
        Location = Target,
        UsesEmperorSecretAlly = useEmperorSecretAlly
    };

    private RevivalCost CostOfRevival => Revival.DetermineCost(Game, Player, hero, amountOfForces, amountOfSpecialForces, forcesPaidByEmperor, specialForcesPaidByEmperor, useEmperorSecretAlly);
}
