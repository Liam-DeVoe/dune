@inherits MapPickComponent<TerrorPlanted>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>@HeaderMessage</Header>
    <Body>

        @if (Removing)
        {
            <SelectComponent @bind-Value="_type" Values="@TerrorPlanted.ValidTerrorTypes(Game, true)">
                <Label>Token</Label>
            </SelectComponent>

            <div class="text-info">
                @Client.CurrentSkin.GetTerrorTypeDescription(_type)
            </div>

            <ButtonRowComponent Pass="Pass" Confirm="Confirm" ConfirmText="Remove token" ConfirmError="@Validation" />
        }
        else
        {
            <div class="small">Use the map to choose a stronghold.</div>

            <ButtonRowComponent Pass="Pass" PassText="Pass" />
        }

    </Body>

</GameEventComponentLayout>

@code {

    protected override Faction IsFactionSpecific => Faction.Cyan;

    private TerrorType _type;

    private bool Removing => TerrorPlanted.MayRemoveTokens(Game, Player);

    // Removing a token names no stronghold, so the map is left alone.
    protected override bool PickEnabled => !Removing;

    protected override bool PickByTerritory => true;

    protected override IEnumerable<Location> PickTargets => SectorsOf(TerrorPlanted.ValidStrongholds(Game, Player));

    protected override TerrorPlanted ConfirmedResult => new(Game, Faction) { Type = _type, Stronghold = TargetTerritory };

    protected override TerrorPlanted PassedResult => new(Game, Faction) { Passed = true };

    private void SetType(TerrorType type)
    {
        _type = type;
        RefreshPin();
    }

    private string ConfirmLabel => Game.UnplacedTerrorTokens.Contains(_type) ? "Place token" : "Move token";

    private string HeaderMessage => Removing ? "You may now remove Terror" : "You may now place Terror";

    protected override RenderFragment PinContent => __builder =>
    {
        var types = TerrorPlanted.ValidTerrorTypes(Game, false).ToList();
        if (!types.Contains(_type)) _type = types.FirstOrDefault();

        <div class="pin-body">
            <div class="pin-choice wrap">
                @foreach (var t in types)
                {
                    <button type="button" class="@(t == _type ? "on" : "")" @onclick="@(() => SetType(t))">@Name(t)</button>
                }
            </div>
            <div class="pin-text">@Client.CurrentSkin.GetTerrorTypeDescription(_type)</div>
            @PinActions(ConfirmLabel)
        </div>
    };
}
