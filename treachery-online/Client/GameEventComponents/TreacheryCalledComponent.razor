@inherits GameEventComponent<TreacheryCalled>

@if (TreacheryCalled.MayCallTreachery(Game, Player))
{
    <GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

        <Header>Call TREACHERY?</Header>
        <Body>
            <ButtonRowComponent Confirm="Confirm" ConfirmText="TREACHERY!" ConfirmError=@Validation Pass="Pass" PassText="Pass" />
        </Body>

    </GameEventComponentLayout>
}

@code {

    protected override bool IsUrgent => true;

    protected override TreacheryCalled ConfirmedResult => new(Game, Faction) { TraitorCalled = true };

    protected override TreacheryCalled PassedResult => new(Game, Faction) { TraitorCalled = false };

    // A player who cannot call treachery has nothing to decide, so pass for them
    // without showing the prompt. Once per battle.
    private BattleInitiated? _passedFor;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Game.CurrentBattle == null || TreacheryCalled.MayCallTreachery(Game, Player) || _passedFor == Game.CurrentBattle)
            return;

        _passedFor = Game.CurrentBattle;
        await Pass();
    }
}
