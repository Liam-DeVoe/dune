@inherits MapPickComponent<YellowSentMonster>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Select where to make <MonsterIcon/> appear</Header>
    <Body>

        <div class="small">Use the map to choose a territory.</div>

    </Body>

</GameEventComponentLayout>

@code {

    protected override bool IsUrgent => true;
    protected override Faction IsFactionSpecific => Faction.Yellow;

    protected override bool PickByTerritory => true;

    protected override IEnumerable<Location> PickTargets => SectorsOf(YellowSentMonster.ValidTargets(Game));

    protected override YellowSentMonster ConfirmedResult => new(Game, Faction) { Territory = TargetTerritory };

    protected override RenderFragment PinContent => __builder =>
    {
        <div class="pin-body">
            @PinActions(Client.CurrentSkin.Format("Appear in {0}", TargetTerritory))
        </div>
    };
}
