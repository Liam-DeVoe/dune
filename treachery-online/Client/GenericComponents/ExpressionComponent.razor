@if (Expression is { } expression)
{
    @foreach (var part in expression.Elements)
    {
        switch (part)
        {
            case null:
                <span class="fw-bold">none</span>
                break;

            case string:
                <span style=@TextBorder>@part</span>
                break;

            case IEnumerable e:
                foreach (var nestedExpression in DetermineElements(e))
                {
                    <ExpressionComponent Expression="@nestedExpression" Size=@Size Game=Game TextBorder=@TextBorder LogStyle=@LogStyle/>
                }
                break;

            case Message m:
                <ExpressionComponent Expression=m.Expression Size=@Size Game=Game LogStyle=@LogStyle/>
                break;

            case MessagePart mp:
                <ExpressionComponent Expression=mp.Expression Size=@Size Game=Game LogStyle=@LogStyle/>
                break;

            case int i:
                <SimpleNumberComponent Size=@Size>@i</SimpleNumberComponent>
                break;

            case float f:
                <SimpleNumberComponent Size=@Size>@Support.Round(f)</SimpleNumberComponent>
                break;

            case double d:
                <SimpleNumberComponent Size=@Size>@Support.Round(d)</SimpleNumberComponent>
                break;

            case Payment payment:
                <SpiceComponent Amount="@payment.Amount.ToString()" Size=@Size/>
                if (payment.By != Faction.None)
                {
                    <span> by <FactionChip Faction=payment.By Game=Game/></span>
                }
                break;

            case Faction faction:
                <FactionChip Faction=faction Game=Game/>
                break;

            case TreacheryCard card when LogStyle:
                <RichText Shown=@card Game=@Game Class="card-chip"><img src="@Client.CurrentSkin.GetImageUrl(card)" alt=""/>@Client.CurrentSkin.Describe(card)</RichText>
                break;

            case Leader leader when LogStyle:
                <Image Shown=@leader Game=@Game Width=@(Size * 1.3f) Class="leader-disc" NoShadow/>
                break;

            case TreacheryCard or ResourceCard or LeaderSkill or TechToken or DiscoveryToken or IHero or TerrorType when Game is { } game:
                <RichText Shown=@part Game=game Style=@TextBorder/>
                break;

            case TreacheryCard or ResourceCard or LeaderSkill or TechToken or DiscoveryToken or IHero or TerrorType:
                <span style=@TextBorder>@Client.CurrentSkin.Describe(part)</span>
                break;

            case Concept monster when monster == Concept.Monster:
                <MonsterIcon Size=@Size/>
                break;
    
            case FactionForce or FactionSpecialForce or Ambassador:
                <Image Shown=@part Width=@Size/>
                break;

            case Location or Territory:
                <PlaceChip Place=@part/>
                break;

            case AuctionType or ChoamEconomicsStatus or TreacheryCardType or StrongholdAdvantage or FactionAdvantage or Ruleset or Rule:
                <span class="fw-bold" style=@TextBorder>@((MarkupString)Client.CurrentSkin.WithSpiceIcons(Client.CurrentSkin.Describe(part), Size))</span>
                break;

            default:
                <span style=@TextBorder>@Client.CurrentSkin.Describe(part)</span>
                break;
        }
    }
}

@code {

    [Parameter]
    public Game? Game { get; set; }

    [Parameter]
    public Expression? Expression { get; set; }

    [Parameter]
    public int Size { get; set; } = 14;

    [Parameter]
    public string TextBorder { get; set; } = "";

    // The log's way of showing things: a leader as their disc, with the name
    // in its popover, and a treachery card as a chip with its art.
    [Parameter]
    public bool LogStyle { get; set; }

    private List<Expression> DetermineElements(IEnumerable e)
    {
        var result = new List<Expression>();
        var useSeparators = false;
        var firstItem = true;

        foreach (var elt in e)
        {
            if (firstItem) {

                useSeparators = ShowWithSeparator(elt);
            }

            if (useSeparators && !firstItem)
            {
                result.Add(new Expression(", ", elt));
            }
            else
            {
                result.Add(new Expression(elt));
            }

            firstItem = false;
        }

        return result;
    }

    private static bool ShowWithSeparator(object e) 
        => !(e is Faction || e is MessagePart || e is FactionForce || e is FactionSpecialForce || e is Leader);

}