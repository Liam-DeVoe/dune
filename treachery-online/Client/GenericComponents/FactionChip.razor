@*
 A faction named in a sentence: its sigil and its name in a pill, the name
 in gold when it is the viewing player's own faction. While the mouse is over it, the hover script in
 index.html tints every sector holding the faction's forces
 (data-ref-locations) and marks anything on the page tagged
 data-faction-of with this faction, such as a traitor card of theirs.
*@

<span class="chip faction @(IsYou ? "you" : "")" data-ref-faction="@Faction" data-ref-locations="@LocationIds"
      style="--fc:@Client.CurrentSkin.GetFactionColor(Faction)" title="@Client.CurrentSkin.Describe(Faction)">
    <img src="@Client.CurrentSkin.GetImageUrl(Faction)" alt=""/>
    <span class="name">@Client.CurrentSkin.Describe(Faction)</span>
</span>

@code {

    [Parameter, EditorRequired]
    public Faction Faction { get; set; }

    [Parameter]
    public Game? Game { get; set; }

    private bool IsYou => !Client.IsObserver && Client.Faction == Faction;

    private string LocationIds =>
        Game?.GetPlayer(Faction) is { } player
            ? string.Join(",", player.ForcesOnPlanet.Keys.Select(l => l.Id))
            : "";
}
