@* A faction's force or special force token. Starred special forces (see Support.HasStarredSpecialForce) get a star badge on the edge. *@
<span class="force-token @(Starred ? "starred" : "") @Class" style="--d:@(Size)px; @Style" title="@Title">
    <img src="@Src" width="@Size" height="@Size" alt="@Title" class="@ImgClass" style="@ImgStyle" />
</span>

@code {

    [Parameter]
    public Faction Faction { get; set; }

    [Parameter]
    public bool Special { get; set; }

    [Parameter]
    public int Size { get; set; } = 24;

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string Class { get; set; } = "";

    [Parameter]
    public string Style { get; set; } = "";

    [Parameter]
    public string ImgClass { get; set; } = "";

    [Parameter]
    public string ImgStyle { get; set; } = "";

    private bool Starred => Special && Support.HasStarredSpecialForce(Faction);

    private string Src => Special ? Client.CurrentSkin.GetFactionSpecialForceImageUrl(Faction) : Client.CurrentSkin.GetFactionForceImageUrl(Faction);
}
