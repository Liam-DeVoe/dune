@inherits GameComponent

@* A small force counter for panels pinned on the map. *@

<div class="pin-step" title="@Title">
    <span class="ic" style="background:@Background"><img src="@Src" alt=""/></span>
    <button type="button" tabindex="-1" aria-label="Fewer" disabled="@(Value <= Min)" @onclick="@(() => Change(-1))">−</button>
    <span class="val">@Value</span>
    <button type="button" tabindex="-1" aria-label="More" disabled="@(Value >= Max)" @onclick="@(() => Change(1))">+</button>
</div>

@code {

    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    [Parameter]
    public int Min { get; set; }

    [Parameter]
    public int Max { get; set; }

    [Parameter]
    public Faction Faction { get; set; }

    [Parameter]
    public bool Special { get; set; }

    // Counts spice instead of forces.
    [Parameter]
    public bool Spice { get; set; }

    [Parameter]
    public string? Label { get; set; }

    private string Src => Spice ? Client.CurrentSkin.Resource_URL : Special ? Client.CurrentSkin.GetFactionSpecialForceImageUrl(Faction) : Client.CurrentSkin.GetFactionForceImageUrl(Faction);

    private string Background => Spice ? "transparent" : Client.CurrentSkin.GetFactionColor(Faction);

    private string Title => Label ?? (Spice ? Name(Concept.Resource) : Special ? Name(Player.SpecialForce) : Name(Player.Force));

    private async Task Change(int delta)
    {
        var next = Math.Clamp(Value + delta, Min, Max);
        if (next == Value) return;
        Value = next;
        await ValueChanged.InvokeAsync(next);
    }
}
