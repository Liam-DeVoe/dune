@inherits GameEventComponent<T>
@typeparam T

@*
 Base for actions that pick one location or territory on the map. Every valid
 choice is outlined; clicking one pins it and shows a panel with the action's
 remaining inputs and its confirm button. Subclasses say what may be clicked
 and what the panel holds; MapPicker handles who owns the map.
*@

@code {

    private MapPicker? _pick;
    private Game? _pickGame;

    protected MapPicker Pick => _pick ??= new MapPicker(Client)
    {
        Sources = () => PickSources,
        Targets = () => PickTargets,
        Enabled = () => PickEnabled,
        ByTerritory = () => PickByTerritory,
        Pin = () => PinContent,
        Changed = HandlePickChanged
    };

    // Sectors to click before the destination, for actions that move forces.
    protected virtual IEnumerable<Location> PickSources => [];

    protected virtual IEnumerable<Location> PickTargets => [];

    // False while the action does not need a location, so other actions can use the map.
    protected virtual bool PickEnabled => true;

    protected virtual bool PickByTerritory => false;

    protected virtual RenderFragment? PinContent => null;

    protected Location? Target => Pick.Target;

    protected Territory? TargetTerritory => Pick.Target?.Territory;

    protected IReadOnlyList<Location> SelectedSources => Pick.Selected;

    protected bool OwnsMap => Pick.OwnsMap;

    protected static IEnumerable<Location> SectorsOf(IEnumerable<Territory> territories) => territories.SelectMany(t => t.Locations);

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (ReferenceEquals(_pickGame, Game)) return;

        _pickGame = Game;
        Pick.Reset();
        OnGameChanged();
    }

    // The game state was replaced; forget anything that referred to the old one.
    protected virtual void OnGameChanged()
    {
    }

    // The selection on the map changed, or the map changed hands.
    protected virtual void OnPickChanged()
    {
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        Pick.Sync();
    }

    public override void Dispose()
    {
        base.Dispose();
        _pick?.Dispose();
    }

    protected void ClearPick() => Pick.Clear();

    // Redraws the pinned panel after one of its inputs changed.
    protected void RefreshPin() => Pick.Push();

    private void HandlePickChanged()
    {
        OnPickChanged();
        StateHasChanged();
    }

    // Cancel and the confirm button, with the reason the event is not yet valid.
    protected RenderFragment PinActions(string confirmLabel) => __builder =>
    {
        var validation = Validation;

        @if (validation != null)
        {
            <div class="pin-error">@validation.ToString(Client.CurrentSkin)</div>
        }

        <div class="pin-actions">
            <button type="button" class="btn btn-secondary" @onclick="ClearPick">Cancel</button>
            <button type="button" class="btn btn-primary" disabled="@(validation != null)" @onclick="Confirm">@confirmLabel</button>
        </div>
    };
}
