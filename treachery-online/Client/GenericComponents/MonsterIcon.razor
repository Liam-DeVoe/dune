@* The worm, named in a sentence: its icon, as in the log. *@
<img src="@Client.CurrentSkin.Monster_URL" alt="@Label" width="@Size" height="@Size" title="@Label" style="filter: drop-shadow(2px 2px 2px black); vertical-align: middle;"/>

@code {

    [Parameter]
    public int Size { get; set; } = 20;

    private string Label => Client.CurrentSkin.Describe(Concept.Monster);
}
