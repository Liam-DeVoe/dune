<div class="num @SizeClass @DisabledClass" title="@Title">

    @if (SymbolSrc != null)
    {
        <span class="ic @IconClass" style="@IconStyle">
            @if (SymbolStarred)
            {
                <span class="force-token starred" style="--d:18px"><img src="@SymbolSrc" alt="" /></span>
            }
            else
            {
                <img src="@SymbolSrc" alt="" />
            }
        </span>
    }

    <button type="button" tabindex="-1" aria-label="Decrease" disabled="@(!MayDecrease)" @onclick="Decrease">−</button>

    <input type="text" inputmode="numeric" value="@_text" disabled="@Disabled" aria-label="@Title"
           @onchange="OnInputChanged" @onkeydown="OnKeyDown" />

    <button type="button" tabindex="-1" aria-label="Increase" disabled="@(!MayIncrease)" @onclick="Increase">+</button>

</div>

@code {

    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<int> OnChanged { get; set; }

    [Parameter]
    public EventCallback OnUp { get; set; }

    [Parameter]
    public EventCallback OnDown { get; set; }

    [Parameter]
    public int Min { get; set; }

    [Parameter]
    public int Max { get; set; } = 10;

    [Parameter]
    public int StepUp { get; set; } = 1;

    [Parameter]
    public int StepDown { get; set; } = 1;

    [Parameter]
    public string? SymbolSrc { get; set; }

    // The symbol is a starred special force (see Support.HasStarredSpecialForce) and gets the star badge.
    [Parameter]
    public bool SymbolStarred { get; set; }

    [Parameter]
    public string? SymbolBackgroundFillColor { get; set; }

    [Parameter]
    public string? SymbolBackgroundBorderColor { get; set; }

    // The parameters below are accepted for compatibility with existing call sites but no longer affect rendering.

    [Parameter]
    public string NumberColor { get; set; } = "black";

    [Parameter]
    public NumberAlignment NumberAlignment { get; set; } = NumberAlignment.Center;

    [Parameter]
    public string? NumberBackgroundFillColor { get; set; }

    [Parameter]
    public string? NumberBackgroundBorderColor { get; set; }

    [Parameter]
    public string? BehindNumberSrc { get; set; }

    [Parameter]
    public string ArrowColor { get; set; } = "#FF5400";

    [Parameter]
    public string DisabledColor { get; set; } = "#FF540080";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public int Size { get; set; } = 36;

    [Parameter]
    public string Title { get; set; } = "";

    // What the text box shows. Kept separate from Value so a rejected entry can be reset in the DOM.
    private string _text = "0";

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Value < Min)
        {
            await SetValue(Min);
        }
        else if (Value > Max)
        {
            await SetValue(Max);
        }

        _text = Value.ToString();
    }

    private async Task Increase()
    {
        if (!Disabled && Value < Max)
        {
            await SetValue(Value + StepUp);
            await OnUp.InvokeAsync();
        }
    }

    private async Task Decrease() {

        if (!Disabled && Value > Min)
        {
            await SetValue(Value - StepDown);
            await OnDown.InvokeAsync();
        }
    }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        if (Disabled) return;

        // Render the typed text once so that the renderer knows what the DOM holds;
        // otherwise resetting to an unchanged Value would leave the typed text in place.
        _text = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();

        if (int.TryParse(_text.Trim(), out var typed))
        {
            await SetValue(Normalize(typed));
        }

        _text = Value.ToString();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowUp":
                await Increase();
                break;
            case "ArrowDown":
                await Decrease();
                break;
        }
    }

    // Clamp to [Min, Max] and, when stepping by more than one, snap to the nearest step from Min.
    private int Normalize(int value)
    {
        value = Math.Clamp(value, Min, Max);

        if (StepUp > 1)
        {
            value = Min + (int)Math.Round((value - Min) / (double)StepUp, MidpointRounding.AwayFromZero) * StepUp;
            value = Math.Clamp(value, Min, Max);
        }

        return value;
    }

    private bool MayIncrease => !Disabled && Value < Max;

    private bool MayDecrease => !Disabled && Value > Min;

    private string SizeClass => Size <= 30 ? "sm" : "";

    private string DisabledClass => Disabled ? "off" : "";

    private bool IsSpice => string.Equals(SymbolBackgroundBorderColor, "#FF5400", StringComparison.OrdinalIgnoreCase);

    private string IconClass => IsSpice ? "spice" : "force";

    private string IconStyle =>
        !IsSpice && SymbolBackgroundFillColor != null && !string.Equals(SymbolBackgroundFillColor, "white", StringComparison.OrdinalIgnoreCase)
            ? $"--fc:{SymbolBackgroundFillColor}"
            : "";

    private async Task SetValue(int newValue) {

        if (Value != newValue)
        {
            Value = newValue;
            _text = newValue.ToString();
            await ValueChanged.InvokeAsync(newValue);
            await OnChanged.InvokeAsync(newValue);
        }
    }
}
