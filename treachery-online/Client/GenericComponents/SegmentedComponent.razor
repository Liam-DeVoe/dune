@inherits GameComponent;
@typeparam T

@*
    The design language's segmented control: a row of buttons where one is
    on. Same parameters as SelectComponent, for choices with two to four
    fixed options, where the guide says a dropdown is the wrong widget.
*@

<div class="@Class">

    @if (Label != null)
    {
        <label class="mb-0 d-block" id="@Id-label">@Label</label>
    }

    <div class="seg" role="radiogroup" aria-labelledby="@(Label != null ? $"{Id}-label" : null)">

        @foreach (var item in ValuesToShow)
        {
            var selected = Equals(item, Value);
            <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")" class="@(selected ? "on" : "")"
                    disabled="@Disabled" @onclick="@(_ => SetValue(item))">
                @GetLabel(item)
            </button>
        }

    </div>

</div>

@code {

    [Parameter]
    public IEnumerable<T>? Values { get; set; }

    [Parameter]
    public T? Value { get; set; }

    [Parameter]
    public IEnumerable<string>? ValueLabels { get; set; }

    [Parameter]
    public EventCallback<T> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<T> OnChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string Class { get; set; } = "mt-1";

    [Parameter]
    public RenderFragment? Label { get; set; }

    [Parameter]
    public bool Required { get; set; } = true;

    private T[] ValuesToShow { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        ValuesToShow = Values?.ToArray() ?? [];

        if (!ValuesToShow.Contains(Value))
        {
            await SetValue(Required ? ValuesToShow.FirstOrDefault() : default);
        }
    }

    private async Task SetValue(T? newValue)
    {
        if (!Equals(Value, newValue))
        {
            Value = newValue;
            await ValueChanged.InvokeAsync(newValue);
            await OnChanged.InvokeAsync(newValue);
        }
    }

    private string GetLabel(T value)
    {
        if (ValueLabels != null && ValueLabels.Count() == ValuesToShow.Length)
        {
            var index = Array.IndexOf(ValuesToShow, value);
            if (index >= 0) return ValueLabels.ElementAt(index);
        }

        return Client.CurrentSkin.Describe(value);
    }
}
