@* A spice amount: the digits drawn on the harvester icon. Every spice amount in
   the client takes this form; Support.SpiceHtml gives the same markup as a string. *@
<span class="spice-amt" style="--s:@(Size)px" title="@Client.CurrentSkin.Describe(Concept.Resource)"><img src="@Client.CurrentSkin.Harvester_URL" alt="@Client.CurrentSkin.Describe(Concept.Resource)"/><b>@Amount</b></span>

@code {

    [Parameter, EditorRequired]
    public string Amount { get; set; } = "";

    [Parameter]
    public int Size { get; set; } = 20;
}
