@* An outlined trash can drawn as an svg, in the stroke style of CancelIcon.
   Used as the label of delete buttons, which used to be the emoji U+1F5D1.
   That emoji is drawn by the OS font and ignores the button colour. *@

<svg width="1.2em" height="1.2em" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Delete" style="vertical-align: -0.2em;">
    <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2.5 4h11"/>
        <path d="M6 4V2.5h4V4"/>
        <path d="M3.8 4l.7 9.5h7l.7-9.5"/>
        <path d="M6.6 6.5v4.5M9.4 6.5v4.5"/>
    </g>
</svg>
