@inherits MapComponent

@{

    var cardWidth = Client.CurrentSkin.CardSize.X;
    var cardHeight = Client.CurrentSkin.CardSize.Y;

    var x = Client.CurrentSkin.SpiceDeckLocation.X;
    var y = 1.02f * Client.CurrentSkin.SpiceDeckLocation.Y;

    double cardspacing = 1f;

    if (Which == Pile.Spice)
    {

    //Resource cards
    @if (!Game.ResourceCardDeck.IsEmpty)
    {
        // The deck has a popover only while the player can see its top card.
        var topIsVisible = Game.CurrentMainPhase == MainPhase.ShipmentAndMove && Game.HasResourceDeckPrescience(Client.Player);
        var cardImageToShow = topIsVisible ? Client.CurrentSkin.GetImageUrl(Game.ResourceCardDeck.Top) : Client.CurrentSkin.CardBack_ResourceCard_URL;
        <MapImage X="@(x)" Y="@(y)" Width=@(cardWidth) Height="@(cardHeight)" Src="@cardImageToShow" 
           ShadowColor="@Client.CurrentSkin.SHADOW" ShadowX="2" ShadowY="2" ShadowBlur="2" 
           Popover="@(topIsVisible ? Client.CurrentSkin.GetPopup(Game.ResourceCardDeck.Top) : null)" PopoverStyle=""/>

        <MapText ToShow="@Game.ResourceCardDeck.Items.Count.ToString()"
             X="@(x + cardWidth / 2)" Y="@(y + cardHeight / 1.5f)"
             Font="@Client.CurrentSkin.CARDPILE_FONT" FontColor="@Client.CurrentSkin.CARDPILE_FONTCOLOR"
             BorderWidth="@Client.CurrentSkin.CARDPILE_FONT_BORDERWIDTH" BorderColor="@Client.CurrentSkin.CARDPILE_FONT_BORDERCOLOR"
             Align="@TextAlignment.Center" />
    }

    x += cardWidth + cardspacing;
    if (Game.LatestSpiceCardA != null)
    {
        <MapImage X="@(x)" Y="@(y)" Width=@(cardWidth) Height="@(cardHeight)" Src="@Client.CurrentSkin.GetImageUrl(Game.LatestSpiceCardA)" 
               ShadowColor="@Client.CurrentSkin.SHADOW" ShadowX="2" ShadowY="2" ShadowBlur="1" 
               Popover="@IntelOfResourceDiscardPile(Game.ResourceCardDiscardPileA, Game.LatestSpiceCardA, "A")" PopoverStyle=""/>
    }

    if (Game.Applicable(Rule.IncreasedResourceFlow))
    {
        <MapText ToShow="A"
                 X="@(x + cardWidth / 2)" Y="@(y + cardHeight / 1.5f)"
                 Font="@Client.CurrentSkin.CARDPILE_FONT" FontColor="@Client.CurrentSkin.CARDPILE_FONTCOLOR"
                 BorderWidth="@Client.CurrentSkin.CARDPILE_FONT_BORDERWIDTH" BorderColor="@Client.CurrentSkin.CARDPILE_FONT_BORDERCOLOR"
                 Align="@TextAlignment.Center" />

        x += cardWidth + cardspacing;
        if (Game.LatestSpiceCardB != null)
        {
            <MapImage X="@(x)" Y="@(y)" Width=@(cardWidth) Height="@(cardHeight)" Src="@Client.CurrentSkin.GetImageUrl(Game.LatestSpiceCardB)" 
                   ShadowColor="@Client.CurrentSkin.SHADOW" ShadowX="2" ShadowY="2" ShadowBlur="1" 
                   Popover="@IntelOfResourceDiscardPile(Game.ResourceCardDiscardPileB, Game.LatestSpiceCardB, "B")" PopoverStyle=""/>
        }

        <MapText ToShow="B"
                 X="@(x + cardWidth / 2)" Y="@(y + cardHeight / 1.5f)"
                 Font="@Client.CurrentSkin.CARDPILE_FONT" FontColor="@Client.CurrentSkin.CARDPILE_FONTCOLOR"
                 BorderWidth="@Client.CurrentSkin.CARDPILE_FONT_BORDERWIDTH" BorderColor="@Client.CurrentSkin.CARDPILE_FONT_BORDERCOLOR"
                 Align="@TextAlignment.Center" />
    }

    if (Game.SandTroutOccured)
    {
        x += cardWidth + cardspacing;
        <MapImage X="@(x)" Y="@(y)" Width=@(cardWidth) Height="@(cardHeight)" Src="@Client.CurrentSkin.GetImageUrl(Game.SandTrout)"
            ShadowColor="@Client.CurrentSkin.SHADOW" ShadowX="2" ShadowY="2" ShadowBlur="1" Popover=@Client.CurrentSkin.GetPopup(Game.SandTrout) PopoverStyle=""/>
    }

    }

    //Treachery cards
    if (Which == Pile.Treachery)
    {
    x = Client.CurrentSkin.TreacheryDeckLocation.X;
    y = 1.02f * Client.CurrentSkin.TreacheryDeckLocation.Y;

    if (Game.TreacheryDeck.Items.Count > 0)
    {
        <MapImage X="@(x)" Y=@y Width=@(cardWidth) Height="@(cardHeight)" Src="@Client.CurrentSkin.CardBack_TreacheryCard_URL" 
               ShadowColor="@Client.CurrentSkin.SHADOW" ShadowX="2" ShadowY="2" ShadowBlur="1"/>
    }

    <MapText ToShow="@Game.TreacheryDeck.Items.Count.ToString()"
             X="@(x + cardWidth / 2)" Y="@(y + cardHeight / 1.5f)"
             Font="@Client.CurrentSkin.CARDPILE_FONT" FontColor="@Client.CurrentSkin.CARDPILE_FONTCOLOR"
             BorderWidth="@Client.CurrentSkin.CARDPILE_FONT_BORDERWIDTH" BorderColor="@Client.CurrentSkin.CARDPILE_FONT_BORDERCOLOR"
             Align="@TextAlignment.Center" />

    if (!Game.TreacheryDiscardPile.IsEmpty)
    {
        x += cardWidth + cardspacing;
        <MapImage X="@(x)" Y=@y Width=@(cardWidth) Height="@(cardHeight)" Src="@Client.CurrentSkin.GetImageUrl(Game.TreacheryDiscardPile.Top)" 
               ShadowColor="@Client.CurrentSkin.SHADOW" ShadowX="2" ShadowY="2" ShadowBlur="1" 
               Popover="@IntelOfTreacheryDiscardPile()"
               PopoverStyle=""/>

        <MapText ToShow="@Game.TreacheryDiscardPile.Items.Count.ToString()"
                 X="@(x + cardWidth / 2)" Y="@(y + cardHeight / 1.5f)"
                 Font="@Client.CurrentSkin.CARDPILE_FONT" FontColor="@Client.CurrentSkin.CARDPILE_FONTCOLOR"
                 BorderWidth="@Client.CurrentSkin.CARDPILE_FONT_BORDERWIDTH" BorderColor="@Client.CurrentSkin.CARDPILE_FONT_BORDERCOLOR"
                 Align="@TextAlignment.Center" />
    }

    if (Game.RicheseCache.Count > 0)
    {
        x = Client.CurrentSkin.TreacheryDeckLocation.X - cardWidth - cardspacing;

        <MapImage X="@(x)" Y=@y Width=@(cardWidth) Height="@(cardHeight)" Src="@Client.CurrentSkin.CardBack_TreacheryCard_URL" 
               ShadowColor="@Client.CurrentSkin.SHADOW" ShadowX="2" ShadowY="2" ShadowBlur="1" 
               Popover="@IntelOfRicheseCardPile()" PopoverStyle=""/>

        <MapImage X="@(x + cardWidth / 3)" Y="@(y + cardHeight / 8)" Diameter="@(cardWidth / 3)" Src="@Client.CurrentSkin.GetImageUrl(Faction.Richese)" ShadowColor="@Client.CurrentSkin.SHADOW" ShadowX="1" ShadowY="1" ShadowBlur="0" />

        <MapText ToShow="@Game.RicheseCache.Count.ToString()"
                 X="@(x + cardWidth / 2)" Y="@(y + cardHeight / 1.5f)"
                 Font="@Client.CurrentSkin.CARDPILE_FONT" FontColor="@Client.CurrentSkin.CARDPILE_FONTCOLOR"
                 BorderWidth="@Client.CurrentSkin.CARDPILE_FONT_BORDERWIDTH" BorderColor="@Client.CurrentSkin.CARDPILE_FONT_BORDERCOLOR"
                 Align="@TextAlignment.Center" />
    }
    }
}

@code {

    // The two piles are drawn separately so the board can move them apart:
    // the spice deck to the bottom-left edge, the treachery deck to the
    // bottom-right (see .map-corner in _map.scss).
    public enum Pile { Spice, Treachery }

    [Parameter]
    public Pile Which { get; set; }

    // The top card's own popover. With note-keeping on, every card in the
    // pile instead, newest first, with the ones this player hasn't seen face
    // down. Both bring their own frame, so the map's popover frame is off.
    private string IntelOfTreacheryDiscardPile()
    {
        if (!Client.Game.AssistedNoteKeepingEnabled(Player))
        {
            return Client.CurrentSkin.GetPopup(Client.Game.TreacheryDiscardPile.Top);
        }

        var known = Game.KnownCards(Player);
        var heading = Client.CurrentSkin.Format("Discard pile · {0}", Client.Game.TreacheryDiscardPile.Items.Count);
        var images = Client.Game.TreacheryDiscardPile.Items.Select(c => known.Contains(c)
            ? $"<img src=\"{Client.CurrentSkin.GetImageUrl(c)}\"/>"
            : $"<img class=\"face-down\" src=\"{Client.CurrentSkin.CardBack_TreacheryCard_URL}\"/>");

        return PileHtml(heading, images);
    }

    // A discard pile's popover with note-keeping on: a heading and every card
    // as a thumbnail, newest first. Styled by .pop-pile in _pop.scss.
    private static string PileHtml(string heading, IEnumerable<string> images)
        => $"<div class=\"pop-pile\"><h6>{heading}</h6><div class=\"pop-pile-cards\">{string.Concat(images)}</div></div>";

    // Richese's cards are known only to Richese, who sees them as thumbnails.
    // Other players get no popover, as with the treachery deck.
    private string? IntelOfRicheseCardPile()
    {
        if (Client.Faction != Faction.Richese || Client.Game.RicheseCache.Count == 0) return null;

        var heading = $"{Client.CurrentSkin.FactionChipHtml(Faction.Richese, Client.Faction == Faction.Richese)} cards · {Client.Game.RicheseCache.Count}";
        return PileHtml(heading, Client.Game.RicheseCache.Select(c => $"<img src=\"{Client.CurrentSkin.GetImageUrl(c)}\"/>"));
    }

    // The latest card's own popover. With note-keeping on, every card in the
    // pile instead, all face up since spice cards are discarded openly. The
    // pile letter is only shown when there are two piles.
    private string IntelOfResourceDiscardPile(Deck<ResourceCard> pile, ResourceCard? latest, string letter)
    {
        if (!Client.Game.AssistedNoteKeepingEnabled(Player))
        {
            return Client.CurrentSkin.GetPopup(latest);
        }

        var name = Client.Game.Applicable(Rule.IncreasedResourceFlow) ? $"Discard pile {letter}" : "Discard pile";
        var images = pile.Items.Select(c => $"<img src=\"{Client.CurrentSkin.GetImageUrl(c)}\"/>");
        return PileHtml($"{name} · {pile.Items.Count}", images);
    }

}