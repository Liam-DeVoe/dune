@inherits MapComponent

<div id="planetmap" style="position:absolute; left:0px">

    <div id="planetmap_inner" style="position:absolute; width:@Px(Client.CurrentSkin.MapDimensions.X); height:@Px(Client.CurrentSkin.MapDimensions.Y);" data-view-top="@Round(ViewTop)" data-view-bottom="@Round(ViewBottom)">

        <BackgroundImage X="0" Y="0" Width="@Client.CurrentSkin.MapDimensions.X" Height="@Client.CurrentSkin.MapDimensions.Y" Src="@Client.CurrentSkin.Map_URL"/>

        @if (Client.Game.CurrentPhase > Phase.AwaitingPlayers)
        {
            <div style="width:100%; height:100%;">

                <SSW  />
                <RecentBlows />
                <ResourcesOnPlanet  />
                <Monsters  />
                <div class="map-corner tr"><Phases /></div>
                <div class="map-corner bl"><CardPiles Which="CardPiles.Pile.Spice" /></div>
                <div class="map-corner br"><CardPiles Which="CardPiles.Pile.Treachery" /></div>
                <Planet  OnLocationClick="@OnLocationClick"/>
                <MapHover />
                <MapSelectionHighlights />
                <RecentMoves  />
                <ForcesOnPlanet  OnLocationClick="@OnLocationClick" />
                <StagedForces />
                <Players  OnLocationClick="@OnLocationClick" />
                <Bids  />
                <div class="map-corner tl"><Tanks /></div>
                <Disconnection  />
                <BattlePlans  />
                <MapRefArrows />
                <MapSelectionOverlay />

            </div>
        }

    </div>

</div>

<div id="planetmap-filler" style="display:block" />

@code {

    [Parameter]
    public Action<LocationEventArgs>? OnLocationClick { get; set; }

    // On desktop the board is scaled to fit the window's height, cropped to
    // the ring and the seat tokens around it. These are the crop's top and
    // bottom in map units; SetPlanetMapScale in index.html reads them.
    private double ViewTop => Client.CurrentSkin.PlanetCenter.Y - Client.CurrentSkin.MapRadius - 3 * Client.CurrentSkin.PlayerTokenRadius - 3;

    private double ViewBottom => Client.CurrentSkin.PlanetCenter.Y + Client.CurrentSkin.MapRadius + 3 * Client.CurrentSkin.PlayerTokenRadius + 1;
}
