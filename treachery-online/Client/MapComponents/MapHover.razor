@inherits MapComponent

@*
 The shape of the sector under the mouse, in every phase. Every sector gets a
 hidden shape here and StartMapHover in index.html shows the one matching the
 hovered Planet location, so a mouse move never reaches Blazor. The shapes
 also carry the sector's centre, which UpdateMapCursorArrows points the cursor arrow at.
*@

@{
    var skin = Client.CurrentSkin;
    var locations = Game.Map.Locations(false).Where(HasBorder).ToList();
}

<svg class="maphover" width="@skin.MapDimensions.X" height="@skin.MapDimensions.Y" viewBox="0 0 @skin.MapDimensions.X @skin.MapDimensions.Y"
     style="position:absolute; left:0; top:0; width:100%; height:100%;" pointer-events="none">

    <defs>
        @foreach (var territory in locations.Select(l => l.Territory).Distinct())
        {
            <clipPath id="maphover-t-@territory.Id">
                <path d="@skin.GetTerritoryBorder(territory)"/>
            </clipPath>
        }
    </defs>

    @foreach (var location in locations)
    {
        var border = skin.GetTerritoryBorder(location.Territory);
        var sectorClip = SectorGeometry.SectorClipId(location.Sector);

        @* The centre is where a pinned arrow ends, so the cursor arrow can snap to it. *@
        var center = SectorGeometry.HasCenter(skin, location) ? skin.GetCenter(location, Game.Map) : (PointD?)null;

        @* The outline is clipped to the sector's own area, so every stroke
           shows only its inner half and the band is the same width along a
           border and along a sector line, meeting cleanly at the corners.
           Stroke widths in CSS are twice the visible width for this. *@
        <g class="hover-shape" data-location-id="@location.Id" data-cx="@(center is { } c ? Round(c.X) : null)" data-cy="@(center is { } d ? Round(d.Y) : null)">
            <g clip-path="url(#@sectorClip)">
                <path d="@border" class="fill"/>
                <g clip-path="url(#maphover-t-@location.Territory.Id)">
                    <path d="@border" class="core"/>
                    <path d="@border" class="edge"/>
                    @if (location.Sector >= 0)
                    {
                        <path d="@SectorGeometry.WedgePath(skin, location.Sector)" class="core radial"/>
                        <path d="@SectorGeometry.WedgePath(skin, location.Sector)" class="edge radial"/>
                    }
                </g>
            </g>
        </g>
    }
</svg>

@code {

    private Situation situation = new();

    protected override bool ShouldRender()
    {
        return Client.InGame && situation.RequiresUpdate(Client);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The shapes are new elements after every render, so the hover script
        // has to find them again.
        await Browser.StartMapHover();
    }

    private bool HasBorder(Location l) =>
        l is not HiddenMobileStronghold && l is not DiscoveredLocation && !l.IsHomeworld && Client.CurrentSkin.GetTerritoryBorder(l.Territory) != "";
}
