@* An invisible rectangle on the map that opens one popover for everything under it, so a group of
   pieces reads as one thing. Laid over the pieces, it keeps their own popovers from opening. *@
@inherits MapComponent
@implements IDisposable

<div @ref="@Element" @attributes="_attributes"
     style=@($"position:absolute;left:{Px(X)};top:{Px(Y)};width:{Px(Width)};height:{Px(Height)};pointer-events:all;")></div>

@code {

    [Parameter, EditorRequired]
    public string Popover { get; set; } = "";

    [Parameter]
    public string Placement { get; set; } = "right";

    private string? _popover;
    private bool _popoverNeedsRefresh;
    private Dictionary<string, object> _attributes = [];

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (_popover != Popover)
        {
            _popover = Popover;
            _popoverNeedsRefresh = true;
        }

        _attributes = new Dictionary<string, object>
        {
            { "data-bs-trigger", "hover" },
            { "data-bs-toggle", "popover" },
            { "data-bs-html", "true" },
            { "data-bs-animation", "false" },
            { "data-bs-delay", "100" },
            { "data-bs-placement", Placement },
            { "data-container", "body" },
            { "data-bs-content", Popover },
            { "data-bs-template", PopoverTemplate }
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _popoverNeedsRefresh = false;
            await Browser.EnablePopover(Element);
        }
        else if (_popoverNeedsRefresh)
        {
            _popoverNeedsRefresh = false;
            await Browser.RefreshPopover(Element);
        }
    }

    public new void Dispose()
    {
        _ = Browser.RemovePopover(Element);
        base.Dispose();
    }
}
