@inherits MapComponent

@*
 The arrows for a log line the mouse is over. The layer is empty; the hover
 script in index.html fills it from the line's data-ref-arrow and empties it
 again. Nothing here changes after the first render, so the script's
 elements survive.
*@

@{
    var skin = Client.CurrentSkin;
}

<svg class="maprefs" width="@skin.MapDimensions.X" height="@skin.MapDimensions.Y" viewBox="0 0 @skin.MapDimensions.X @skin.MapDimensions.Y"
     style="position:absolute; left:0; top:0; width:100%; height:100%;" pointer-events="none">
    <defs>
        @* One head, filled in the faction colour and outlined, rather than a dark head under a coloured one. *@
        <marker id="mapref-head" viewBox="0 0 12 12" refX="9" refY="6" markerWidth="4" markerHeight="4" orient="auto-start-reverse" markerUnits="strokeWidth" overflow="visible">
            <path d="M0,0 L12,6 L0,12 Z" class="head"/>
        </marker>
    </defs>
    <g class="lines"></g>
</svg>

@code {
    protected override bool ShouldRender() => false;
}
