@inherits MapComponent
@implements IDisposable

@*
 Marks the sectors that take part in the current map-driven action. Sits
 below the force tokens so nothing here covers them.

 Destinations are shown as one contour around the whole reachable region,
 with a light wash inside it, so the map's own sector lines do the work of
 showing the sectors and the contour only says where reach ends. Sources get
 a thin outline in the faction's colour. The selected source and the pinned
 destination keep a strong outline. Locations without a territory border on
 the map, such as homeworlds and the hidden mobile stronghold, get a circle
 instead.

 The contour is the region within the line's width of the reachable region,
 minus the reachable region itself. The near region is built in a mask as the
 union of every destination's border and wedge, stroked to twice the visible
 width, so overlapping strokes merge instead of poking out at junctions. A
 border stroke is limited to its sector's wedge grown by the same width,
 which keeps the outer half of a border that lies on a sector line or on the
 planet's rim, where a plain clip would cut it off. There is one such mask
 for the line and one for the dark halo outside it.
*@

@{
    var map = Client.MapInteraction;
    var skin = Client.CurrentSkin;
    var faction = skin.GetFactionColor(map.Faction);
}

@if (map.Owner != null && (map.Selectable.Count > 0 || map.Selected.Count > 0 || map.Targets.Count > 0))
{
    // The pinned destination stays in the contour, so pinning it doesn't cut it out of the reachable region.
    var destinations = map.Targets.Where(l => !map.Selected.Contains(l) && SectorGeometry.HasCenter(skin, l)).ToList();
    var traced = destinations.Where(HasBorder).ToList();

    <svg class="mapsel" width="@skin.MapDimensions.X" height="@skin.MapDimensions.Y" viewBox="0 0 @skin.MapDimensions.X @skin.MapDimensions.Y"
         style="position:absolute; left:0; top:0; width:100%; height:100%; --c:@faction" pointer-events="none">

        <defs>
            @foreach (var territory in Involved(map).Select(l => l.Territory).Distinct())
            {
                <clipPath id="mapsel-t-@territory.Id">
                    <path d="@skin.GetTerritoryBorder(territory)"/>
                </clipPath>
            }

            @foreach (var kind in new[] { "line", "halo" })
            {
                @foreach (var sector in traced.Select(l => l.Sector).Where(s => s >= 0).Distinct())
                {
                    <mask id="mapsel-grow-@kind-@sector" maskUnits="userSpaceOnUse" x="0" y="0" width="@skin.MapDimensions.X" height="@skin.MapDimensions.Y">
                        <path d="@SectorGeometry.WedgePath(skin, sector)" class="near-@kind"/>
                    </mask>
                }
                <mask id="mapsel-near-@kind" maskUnits="userSpaceOnUse" x="0" y="0" width="@skin.MapDimensions.X" height="@skin.MapDimensions.Y">
                    @foreach (var l in traced)
                    {
                        <g mask="url(#mapsel-grow-@kind-@l.Sector)">
                            <path d="@skin.GetTerritoryBorder(l.Territory)" class="near-@kind"/>
                        </g>
                        @if (l.Sector >= 0)
                        {
                            <g clip-path="url(#mapsel-t-@l.Territory.Id)">
                                <path d="@SectorGeometry.WedgePath(skin, l.Sector)" class="near-@kind"/>
                            </g>
                        }
                    }
                </mask>
            }
            <mask id="mapsel-outside" maskUnits="userSpaceOnUse" x="0" y="0" width="@skin.MapDimensions.X" height="@skin.MapDimensions.Y">
                <rect x="0" y="0" width="@skin.MapDimensions.X" height="@skin.MapDimensions.Y" fill="#fff"/>
                @foreach (var l in traced) { @Shape(l, "#000") }
            </mask>
        </defs>

        @foreach (var location in map.Selectable.Where(l => !map.Selected.Contains(l) && SectorGeometry.HasCenter(skin, l)))
        {
            @Highlight(location, "mapsel-selectable")
        }

        <g class="mapsel-contour">
            @foreach (var l in traced) { @Shape(l, "#fff", "wash") }
            <g mask="url(#mapsel-outside)">
                <rect x="0" y="0" width="@skin.MapDimensions.X" height="@skin.MapDimensions.Y" class="halo" mask="url(#mapsel-near-halo)"/>
                <rect x="0" y="0" width="@skin.MapDimensions.X" height="@skin.MapDimensions.Y" class="line" mask="url(#mapsel-near-line)"/>
            </g>
        </g>
        @foreach (var location in destinations.Where(l => l != map.Target && !HasBorder(l)))
        {
            @Highlight(location, "mapsel-target")
        }

        @foreach (var location in map.Selected.Where(l => SectorGeometry.HasCenter(skin, l)))
        {
            @Highlight(location, "mapsel-selected")
        }
        @if (map.Target != null && SectorGeometry.HasCenter(skin, map.Target))
        {
            @Highlight(map.Target, "mapsel-pinned")
        }
    </svg>
}

@code {

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Client.MapInteraction.Changed += StateHasChanged;
    }

    public new void Dispose()
    {
        Client.MapInteraction.Changed -= StateHasChanged;
        base.Dispose();
    }

    private static IEnumerable<Location> Involved(MapInteraction map) =>
        map.Selectable.Concat(map.Selected).Concat(map.Targets).Concat(map.Target != null ? [map.Target] : []);

    private bool HasBorder(Location l) =>
        l is not HiddenMobileStronghold && l is not DiscoveredLocation && !l.IsHomeworld && Client.CurrentSkin.GetTerritoryBorder(l.Territory) != "";

    // The sector's area with a plain fill, for the masks and the wash.
    private RenderFragment Shape(Location l, string fill, string cls = "") => __builder =>
    {
        var skin = Client.CurrentSkin;
        <g clip-path="url(#@SectorGeometry.SectorClipId(l.Sector))">
            <path d="@skin.GetTerritoryBorder(l.Territory)" fill="@fill" class="@cls"/>
        </g>
    };

    private RenderFragment Highlight(Location l, string cls) => __builder =>
    {
        var skin = Client.CurrentSkin;

        if (HasBorder(l))
        {
            var border = skin.GetTerritoryBorder(l.Territory);
            var sectorClip = SectorGeometry.SectorClipId(l.Sector);

            <g class="@cls">
                <g clip-path="url(#@sectorClip)">
                    <path d="@border" class="fill"/>
                    <path d="@border" class="core"/>
                    <path d="@border" class="edge"/>
                </g>
                @if (l.Sector >= 0)
                {
                    @* Clipped by both shapes, so only the inner half of the stroke shows; .radial doubles the width to make up for it. *@
                    <g clip-path="url(#mapsel-t-@l.Territory.Id)">
                        <g clip-path="url(#@sectorClip)">
                            <path d="@SectorGeometry.WedgePath(skin, l.Sector)" class="core radial"/>
                            <path d="@SectorGeometry.WedgePath(skin, l.Sector)" class="edge radial"/>
                        </g>
                    </g>
                }
            </g>
        }
        else
        {
            var center = skin.GetCenter(l, Game.Map);
            var radius = l is HiddenMobileStronghold ? skin.HmsRadius : 2.2f * skin.PlayerTokenRadius;
            <g class="@cls">
                <circle cx="@Round(center.X)" cy="@Round(center.Y)" r="@Round(radius)" class="fill"/>
                <circle cx="@Round(center.X)" cy="@Round(center.Y)" r="@Round(radius)" class="edge"/>
            </g>
        }
    };
}
