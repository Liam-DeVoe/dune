@inherits MapComponent
@implements IDisposable

@*
 Arrows from the selected sources to the cursor or to the pinned destination,
 plus the pinned panel (force counter, confirm). Sits above the force tokens.
 The cursor arrow is positioned by UpdateMapCursorArrows in index.html, not
 by Blazor, so hovering never causes a render. It points at the last valid
 destination the mouse was over, at that sector's centre and trimmed like a
 pinned arrow, so it ends where the pinned arrow would end if that sector
 were clicked. Until a destination has been hovered there is no arrow. The
 valid destinations are passed along in data-targets; a selected source is
 left out because clicking it deselects.
 While something is selected, Escape or a right click on the map cancels it;
 ListenForMapCancel in index.html calls back into CancelMapInteraction.
*@

@{
    var map = Client.MapInteraction;
    var skin = Client.CurrentSkin;
    var faction = skin.GetFactionColor(map.Faction);
}

@{
    var starts = map.Selected.Where(l => SectorGeometry.HasCenter(skin, l)).Select(l => skin.GetCenter(l, Game.Map)).ToList();
    if (starts.Count == 0 && map.Origin is { } origin) starts.Add(origin);
    PointD? end = map.Target != null && SectorGeometry.HasCenter(skin, map.Target) ? skin.GetCenter(map.Target, Game.Map) : map.EndPoint;
    var showPin = map.Pin != null && (end != null || map.Selected.Count > 0);
}

@if (map.Owner != null && starts.Count > 0 && (end != null || map.Selected.Count > 0))
{
    var cursorTargets = string.Join(",", map.Targets.Where(l => !map.Selected.Contains(l)).Select(l => l.Id));
    <svg class="maparrows" width="@skin.MapDimensions.X" height="@skin.MapDimensions.Y" viewBox="0 0 @skin.MapDimensions.X @skin.MapDimensions.Y"
         style="position:absolute; left:0; top:0; width:100%; height:100%; --c:@faction" pointer-events="none" data-targets="@cursorTargets">

        <defs>
            @* One head, filled in the faction colour and outlined, the same as the journey arrows in MapRefArrows. *@
            <marker id="mapsel-head" viewBox="0 0 12 12" refX="9" refY="6" markerWidth="4" markerHeight="4" orient="auto-start-reverse" markerUnits="strokeWidth" overflow="visible">
                <path d="M0,0 L12,6 L0,12 Z" class="head"/>
            </marker>
        </defs>

        @foreach (var a in starts)
        {
            if (end is { } b)
            {
                var (p, q) = Trim(a, b, 10, 12);
                <line class="arrow-outline" x1="@Round(p.X)" y1="@Round(p.Y)" x2="@Round(q.X)" y2="@Round(q.Y)"/>
                <line class="arrow" x1="@Round(p.X)" y1="@Round(p.Y)" x2="@Round(q.X)" y2="@Round(q.Y)" marker-end="url(#mapsel-head)"/>
            }
            else if (map.ShowCursorArrow)
            {
                @* Hidden until the script points it at a hovered target. data-x1/y1 keep the untrimmed start, which the script trims. *@
                <line class="arrow-outline mapsel-cursor" visibility="hidden" data-x1="@Round(a.X)" data-y1="@Round(a.Y)" x1="@Round(a.X)" y1="@Round(a.Y)" x2="@Round(a.X)" y2="@Round(a.Y)"/>
                <line class="arrow mapsel-cursor" visibility="hidden" data-x1="@Round(a.X)" data-y1="@Round(a.Y)" x1="@Round(a.X)" y1="@Round(a.Y)" x2="@Round(a.X)" y2="@Round(a.Y)" marker-end="url(#mapsel-head)"/>
            }
        }
    </svg>
}

@if (map.Owner != null && showPin)
{
    var (anchor, below) = PinAnchor(starts, end);
    <div class="map-pin @(below ? "below" : "")" style="left:@Px(anchor.X); top:@Px(anchor.Y); --c:@faction">
        @map.Pin
    </div>
}

@code {

    private bool _popoversSuppressed;
    private bool _cancelable;
    private DotNetObjectReference<MapSelectionOverlay>? _self;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Client.MapInteraction.Changed += StateHasChanged;
    }

    public new void Dispose()
    {
        Client.MapInteraction.Changed -= StateHasChanged;
        if (_popoversSuppressed) _ = Browser.SetMapPopoversEnabled(true);
        if (_cancelable) _ = Browser.ListenForMapCancel(null);
        _self?.Dispose();
        base.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var map = Client.MapInteraction;
        // The hover shape shows which sector the mouse is on, so intel popovers
        // only need to stay out of the way of the pinned panel.
        var pinned = map.Owner != null && map.Target != null;
        if (pinned != _popoversSuppressed)
        {
            _popoversSuppressed = pinned;
            await Browser.SetMapPopoversEnabled(!pinned);
        }

        // The panel's width is only known once rendered, and it changes as
        // options come and go, so it is measured after every render.
        if (map.Owner != null && map.Pin != null) await Browser.ClampMapPin();

        var cancelable = map.CanCancel;
        if (cancelable != _cancelable)
        {
            _cancelable = cancelable;
            _self ??= DotNetObjectReference.Create(this);
            await Browser.ListenForMapCancel(cancelable ? _self : null);
        }

        // The cursor arrows are new elements after every render, so they are
        // pointed at the last hovered target again, or hidden if there is none.
        var cursorArrows = map.Owner != null && map.Selected.Count > 0 && map.Target == null && map.EndPoint == null && map.ShowCursorArrow;
        if (cursorArrows) await Browser.UpdateMapCursorArrows();
    }

    [JSInvokable]
    public void CancelMapInteraction() => Client.MapInteraction.Cancel();

    // Shortens a segment so the arrow does not sit on top of the tokens at
    // either end. TrimMapArrow in index.html does the same for the cursor arrow.
    private static (PointD, PointD) Trim(PointD a, PointD b, double fromStart, double fromEnd)
    {
        var dx = b.X - a.X;
        var dy = b.Y - a.Y;
        var length = Math.Sqrt(dx * dx + dy * dy);
        if (length < fromStart + fromEnd + 1) return (a, b);
        var ux = dx / length;
        var uy = dy / length;
        return (new PointD(a.X + ux * fromStart, a.Y + uy * fromStart), new PointD(b.X - ux * fromEnd, b.Y - uy * fromEnd));
    }

    // The panel hangs above the destination, in line with it, so the caret
    // points at the sector being moved to. A selected source sitting where
    // the panel would be pushes it up until the token shows. Near the top of
    // the map the panel sits below the destination instead, and a source in
    // the way pushes it down. Before a destination is picked the panel sits
    // above the selected sources. A start on the ring around the planet is
    // not a token on the map and is ignored. Keeping the panel on the page
    // is left to ClampMapPin in index.html, which knows the rendered width.
    private (PointD, bool) PinAnchor(List<PointD> starts, PointD? end)
    {
        var skin = Client.CurrentSkin;
        var radius = skin.FORCETOKEN_RADIUS;
        var clearance = 1.5 * radius;

        if (end is not { } e)
        {
            var x = starts.Average(p => p.X);
            var top = starts.Min(p => p.Y) - clearance;
            if (top > 110) return (new PointD(x, top), false);
            return (new PointD(x, starts.Max(p => p.Y) + clearance), true);
        }

        // The panel's size in map units, with room to spare: the move panel
        // measures about 200 by 100. Only used to tell whether a source
        // token would end up underneath the panel.
        const double halfWidth = 110;
        const double height = 110;
        var sources = Client.MapInteraction.Selected.Count > 0 ? starts : new List<PointD>();
        var inColumn = sources.Where(p => Math.Abs(p.X - e.X) < halfWidth + radius).ToList();

        var above = e.Y - clearance;
        foreach (var p in inColumn.Where(p => p.Y < e.Y).OrderByDescending(p => p.Y))
        {
            if (p.Y - radius < above && p.Y + radius > above - height) above = p.Y - clearance;
        }
        if (above > 110) return (new PointD(e.X, above), false);

        var below = e.Y + clearance;
        foreach (var p in inColumn.Where(p => p.Y >= e.Y).OrderBy(p => p.Y))
        {
            if (p.Y + radius > below && p.Y - radius < below + height) below = p.Y + clearance;
        }
        return (new PointD(e.X, below), true);
    }
}
