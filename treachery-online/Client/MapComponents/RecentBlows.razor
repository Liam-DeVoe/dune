@inherits MapComponent

@*
 Tints the sector where spice blew this turn, for the whole blow phase, so the
 new pile does not have to be found among the older ones. Sits under the spice
 tokens so the tint never dims the pile it points at.
*@

@if (Game.CurrentMainPhase == MainPhase.Blow && Blown.Count > 0)
{
    var skin = Client.CurrentSkin;

    <svg class="mapblow" width="@skin.MapDimensions.X" height="@skin.MapDimensions.Y" viewBox="0 0 @skin.MapDimensions.X @skin.MapDimensions.Y"
         style="position:absolute; left:0; top:0; width:100%; height:100%;" pointer-events="none">

        <defs>
            @foreach (var territory in Blown.Select(l => l.Territory).Distinct())
            {
                <clipPath id="mapblow-t-@territory.Id">
                    <path d="@skin.GetTerritoryBorder(territory)"/>
                </clipPath>
            }
        </defs>

        @foreach (var location in Blown)
        {
            var border = skin.GetTerritoryBorder(location.Territory);
            var sectorClip = SectorGeometry.SectorClipId(location.Sector);

            <g clip-path="url(#@sectorClip)">
                <path d="@border" class="fill"/>
                <path d="@border" class="core"/>
                <path d="@border" class="edge"/>
            </g>
            @if (location.Sector >= 0)
            {
                @* Clipped by both shapes, so only the inner half of the stroke shows; .radial doubles the width to make up for it. *@
                <g clip-path="url(#mapblow-t-@location.Territory.Id)">
                    <g clip-path="url(#@sectorClip)">
                        <path d="@SectorGeometry.WedgePath(skin, location.Sector)" class="core radial"/>
                        <path d="@SectorGeometry.WedgePath(skin, location.Sector)" class="edge radial"/>
                    </g>
                </g>
            }
        }
    </svg>
}

@code {

    // Where the spice cards drawn this turn point. A card that blew in the
    // storm is still marked: the player wants to see where the spice went.
    private List<Location> Blown =>
        new[] { Game.LatestSpiceCardA, Game.LatestSpiceCardB }
            .Select(card => card?.Location)
            .Where(l => l != null && l.SpiceBlowAmount > 0 && HasBorder(l))
            .Select(l => l!)
            .ToList();

    private bool HasBorder(Location l) =>
        l is not HiddenMobileStronghold && l is not DiscoveredLocation && !l.IsHomeworld && Client.CurrentSkin.GetTerritoryBorder(l.Territory) != "";
}
