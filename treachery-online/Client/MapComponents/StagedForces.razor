@inherits MapComponent
@implements IDisposable

@*
 Forces staged on the map during setup but not yet confirmed. Drawn to the
 right of the real tokens in the sector so both stay visible.
*@

@{
    var map = Client.MapInteraction;
    var skin = Client.CurrentSkin;
    var diameter = 2 * skin.FORCETOKEN_RADIUS;
}

@if (map.Owner != null)
{
    foreach (var (location, staged) in map.Staged.Where(kvp => kvp.Value.TotalAmountOfForces > 0 && SectorGeometry.HasCenter(skin, kvp.Key)))
    {
        var center = skin.GetCenter(location, Game.Map);
        // Real tokens start half a token left of the centre, one column per
        // force type present; the staged ones start a fifth of a token further right.
        var columns = Game.BattalionsIn(location).Select(b => (b.AmountOfForces > 0 ? 1 : 0) + (b.AmountOfSpecialForces > 0 ? 1 : 0)).DefaultIfEmpty(1).Max();
        var x = center.X - 0.5 * diameter + Math.Max(1, columns) * diameter + 0.2 * diameter;
        var y = center.Y - 0.5 * diameter;

        if (staged.AmountOfForces > 0)
        {
            @Token(skin.GetFactionForceImageUrl(staged.Faction), staged.AmountOfForces, x, y, diameter)
            x += 1.2 * diameter;
        }

        if (staged.AmountOfSpecialForces > 0)
        {
            @Token(skin.GetFactionSpecialForceImageUrl(staged.Faction), staged.AmountOfSpecialForces, x, y, diameter)
        }
    }
}

@code {

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Client.MapInteraction.Changed += StateHasChanged;
    }

    public new void Dispose()
    {
        Client.MapInteraction.Changed -= StateHasChanged;
        base.Dispose();
    }

    private RenderFragment Token(string src, int amount, double x, double y, double diameter) => __builder =>
    {
        <div class="staged-force" style=@($"left:{Px(x)};top:{Px(y)};width:{Px(diameter)};height:{Px(diameter)}")>
            <img src="@src" alt="Staged force"/>
            <span class="count" style=@($"font:{Client.CurrentSkin.FORCETOKEN_FONT}")>@amount</span>
        </div>
    };
}
