@inherits MapComponent
@using System.Net
@using System.Text

@if (Client.Game.CurrentPhase >= Phase.MetheorAndStormSpell)
{
    var y = 1.75f * Client.CurrentSkin.FORCETOKEN_RADIUS;
    var x = 1.5f * Client.CurrentSkin.FORCETOKEN_RADIUS;
    var leaderDiameter = 3.2f * Client.CurrentSkin.FORCETOKEN_RADIUS;
    var leaderPctHeight = .25f * leaderDiameter * Client.CurrentSkin.BattleWheelHeroHeight / Client.CurrentSkin.BattleWheelHeroWidth;
    var forceDiameter = 2 * Client.CurrentSkin.FORCETOKEN_RADIUS;
    var bounds = new Bounds();
    
    foreach (var p in Client.Game.Players)
    {
        if (p.ForcesKilled > 0 || p.SpecialForcesKilled > 0)
        {
            if (p.ForcesKilled > 0)
            {
                <MapForce X=@x Y=@y Special=@false Amount=@p.ForcesKilled Faction=@p.Faction ShowPopover="false" />
                bounds.AddStack(x, y, forceDiameter, p.ForcesKilled);
            }

            if (p.SpecialForcesKilled > 0)
            {
                var dX = p.ForcesKilled > 0 ? 2 * Client.CurrentSkin.FORCETOKEN_RADIUS : 0;
                <MapForce X=@(x + dX) Y=@y Special=@true Amount=@p.SpecialForcesKilled Faction=@p.Faction ShowPopover="false" />
                bounds.AddStack(x + dX, y, forceDiameter, p.SpecialForcesKilled);
            }

            y += Spacing * 2 * Client.CurrentSkin.FORCETOKEN_RADIUS;
        }

        var corpses = p.Leaders
            .Where(l => !Client.Game.IsAlive(l))
            .Select(l => new Tuple<Leader, LeaderState>(l, Client.Game.LeaderState[l]))
            .OrderBy(l => l.Item2.TimeOfDeath).Select(l => l.Item1)
            .ToArray();

        if (corpses.Any())
        {
            y += Spacing * (leaderPctHeight * (corpses.Count() - 1));
            var dy = 0;
            var displaceX = (int)(0.2f * leaderDiameter);
            foreach (var leader in corpses)
            {
                var l = new PointD(x, y - dy);

                if (Client.Game.LeaderState[leader].IsFaceDownDead)
                {
                    <MapImage X="@(l.X + displaceX)" Y="@(l.Y)" Diameter="@(leaderDiameter)"
                           Src="@Client.CurrentSkin.GetFactionFaceDownImageUrl(p.Faction)"
                           ShadowColor="@Client.CurrentSkin.SHADOW" ShadowX="2" ShadowY="2" ShadowBlur="1" />
                }
                else
                {
                    <MapLeader ToShow="leader" X=@(l.X + displaceX) Y=@(l.Y) Diameter="leaderDiameter" ShowPopover="false"/>
                }

                bounds.Add(l.X + displaceX, l.Y, leaderDiameter, leaderDiameter);

                displaceX *= -1;
                dy += (int)leaderPctHeight;
            }

            y += Spacing * leaderDiameter;
        }

        if (p.Faction == Faction.Green && !Client.Game.MessiahIsAlive)
        {
            <MapImage X="@(x)" Y="@(y)" Diameter="@(0.5f * leaderDiameter)"
                   Src="@Client.CurrentSkin.Messiah_URL"
                   ShadowColor="@Client.CurrentSkin.SHADOW" ShadowX="2" ShadowY="2" ShadowBlur="1"/>

            bounds.Add(x, y, 0.5f * leaderDiameter, 0.5f * leaderDiameter);
            
            y += Spacing * leaderDiameter;
        }

        NextColumnIfNecessary(ref y, ref x, Spacing);
    }

    @* One popover for the whole tanks area, laid over the pieces, listing what each faction has in it. *@
    if (bounds.IsSet)
    {
        <MapPopoverArea X="@bounds.MinX" Y="@bounds.MinY" Width="@(bounds.MaxX - bounds.MinX)" Height="@(bounds.MaxY - bounds.MinY)" Popover="@PanelHtml()"/>
    }
}

@code 
{
    const float Spacing = 0.85f;
    private Situation _situation = new();
    
    protected override bool ShouldRender()
    {
        return Client.InGame && _situation.RequiresUpdate(Client);
    }

    private void NextColumnIfNecessary(ref float y, ref float x, float spacing)
    {
        if (!(y > 15 * Client.CurrentSkin.FORCETOKEN_RADIUS - 0.8f * x)) 
            return;
        
        y = 1.75f * Client.CurrentSkin.FORCETOKEN_RADIUS;
        x += 4.25f * Client.CurrentSkin.FORCETOKEN_RADIUS;
    }

    // A face-down leader's identity is known only to its owner and to Tleilaxu.
    private bool MayIdentify(Leader l) => Player != null && (Player.Is(l.Faction) || Player.Is(Faction.Purple));

    // The popover: one row per faction with anything in the tanks. The faction chip, its forces and
    // special forces as token and count, and its dead leaders in order of death.
    private string PanelHtml()
    {
        var skin = Client.CurrentSkin;
        var rows = new StringBuilder();

        foreach (var p in Game.Players)
        {
            var corpses = p.Leaders
                .Where(l => !Game.IsAlive(l))
                .OrderBy(l => Game.LeaderState[l].TimeOfDeath)
                .ToArray();

            var messiahDead = p.Faction == Faction.Green && !Game.MessiahIsAlive;

            if (p.ForcesKilled == 0 && p.SpecialForcesKilled == 0 && corpses.Length == 0 && !messiahDead) continue;

            var you = !Client.IsObserver && Client.Faction == p.Faction;
            rows.Append("<tr>");
            rows.Append($"<td>{skin.FactionChipHtml(p.Faction, you, p.ForcesOnPlanet.Keys.Select(l => l.Id))}</td>");

            rows.Append("<td class='forces'>");
            if (p.ForcesKilled > 0)
            {
                rows.Append($"<span class='count'>{Support.ForceTokenHtml(skin, p.Faction, false, 28, Encode(skin.Describe(p.Force)))}<b>{p.ForcesKilled}</b></span>");
            }
            rows.Append("</td>");

            rows.Append("<td>");
            if (p.SpecialForcesKilled > 0)
            {
                // As on the map, the number of No-Field tokens stays hidden.
                var amount = p.Faction == Faction.White ? "" : $"<b>{p.SpecialForcesKilled}</b>";
                rows.Append($"<span class='count'>{Support.ForceTokenHtml(skin, p.Faction, true, 28, Encode(skin.Describe(p.SpecialForce)))}{amount}</span>");
            }
            rows.Append("</td>");

            rows.Append("<td><div class='leaders'>");
            foreach (var l in corpses)
            {
                if (!Game.LeaderState[l].IsFaceDownDead)
                {
                    rows.Append($"<img src='{skin.GetImageUrl(l)}' title='{Encode(skin.Describe(l))}' alt=''/>");
                }
                else if (MayIdentify(l))
                {
                    rows.Append($"<img class='face-down' src='{skin.GetImageUrl(l)}' title='{Encode(skin.Describe(l))} (face down)' alt=''/>");
                }
                else
                {
                    rows.Append($"<img src='{skin.GetFactionFaceDownImageUrl(p.Faction)}' title='Face down' alt=''/>");
                }
            }
            if (messiahDead)
            {
                rows.Append($"<img src='{skin.Messiah_URL}' title='{Encode(skin.Describe(Concept.Messiah))}' alt=''/>");
            }
            rows.Append("</div></td>");

            rows.Append("</tr>");
        }

        return $"<div class='tanks-pop'><h6>{Encode(skin.Describe(Concept.Graveyard))}</h6>" +
               $"<table><tr><th>Faction</th><th colspan='2'>Forces</th><th>Leaders</th></tr>{rows}</table></div>";
    }

    // Values go into the popover's HTML, which itself sits in a single-quoted attribute.
    private static string Encode(string s) => WebUtility.HtmlEncode(s);

    // The rectangle around every piece drawn in the tanks, in map units.
    private class Bounds
    {
        public bool IsSet { get; private set; }
        public double MinX { get; private set; } = double.MaxValue;
        public double MinY { get; private set; } = double.MaxValue;
        public double MaxX { get; private set; } = double.MinValue;
        public double MaxY { get; private set; } = double.MinValue;

        public void Add(double x, double y, double w, double h)
        {
            IsSet = true;
            MinX = Math.Min(MinX, x);
            MinY = Math.Min(MinY, y);
            MaxX = Math.Max(MaxX, x + w);
            MaxY = Math.Max(MaxY, y + h);
        }

        // A force stack: MapForce draws each further token up and to the left of the first.
        public void AddStack(double x, double y, double d, int amount)
        {
            var n = Math.Max(amount - 1, 0);
            Add(x - 0.07 * n * d, y - 0.08 * n * d, d + 0.07 * n * d, d + 0.08 * n * d);
        }
    }

}
