@inherits GameComponent
@inject MenuState Menu

<div class="card mb-2" style="@(InPopover ? "" : "animation:fadeIn 1s;")">

    @{
        var acceptableDeals = DealAccepted.AcceptableDeals(Game, Player).ToArray();
        var cancellableDeals = DealAccepted.CancellableDeals(Game, Player).ToArray();
        var currentDeals = DealAccepted.CurrentDeals(Game).ToArray();

        <div class="card-header" @onclick=@(e => _collapsed = !_collapsed) style="cursor:pointer">
            Deals
            @if (acceptableDeals.Any())
            {
                <span class="badge bg-warning" title="Deals offered to you">@acceptableDeals.Length</span>
            }
            @if (cancellableDeals.Any())
            {
                <span class="badge bg-success" title="Your deal offers">@cancellableDeals.Length</span>
            }
            @if (currentDeals.Any())
            {
                <span class="badge bg-primary" title="Current deals">@currentDeals.Length</span>
            }

            <CollapseButton Collapsed=@_collapsed />
        </div>

        @if (!_collapsed)
        {
            <div class="card-body">

                @if (!Client.IsObserver && (acceptableDeals.Any() || cancellableDeals.Any())) 
                {
                    <label>Deal offers</label>
                    <table class="table table-sm">

                        <tbody>

                            @foreach (var offer in acceptableDeals) 
                            {
                                var offerToShow = offer;
                                var validity = offer.Acceptance(Faction).Validate();

                                <tr class="table-dark @(Menu.MarkedDeal == offer ? "deal-marked" : "")">
                                    <td><FactionChip Faction=@offer.Initiator Game=Game/></td>
                                    <td><SpiceComponent Amount="@offer.Price.ToString()"/></td>
                                    <td class="text-break"><ExpressionComponent Expression=@(offer.GetDealDescription().Expression) Game=Game/></td>
                                    <td>
                                        <button class="btn btn-primary btn-sm" @onclick="e => Accept(offerToShow)" disabled=@(validity != null)>Accept</button>
                                        <button class="btn btn-secondary btn-sm ms-1" @onclick="e => Decline(offerToShow)">Decline</button>
                                    </td>
                                </tr>
                            }

                            @foreach (var offer in cancellableDeals)
                            {
                                var offerToShow = offer;

                                <tr class="table-dark">
                                    <td><FactionChip Faction=@offer.Initiator Game=Game/></td>
                                    <td><SpiceComponent Amount="@offer.Price.ToString()"/></td>
                                    <td class="text-break">
                                        <ExpressionComponent Expression=@(offer.GetDealDescription().Expression) Game=Game/>
                                        @{
                                            var recipients = Game.DealRecipients(offer).ToArray();
                                        }
                                        <div class="deal-answers">
                                            @foreach (var recipient in recipients)
                                            {
                                                var answer = Game.DealResponse(offer, recipient) switch { true => "accepted", false => "declined", null => "deciding" };
                                                <span class="deal-answer @answer" title="@Client.CurrentSkin.Describe(recipient): @answer">
                                                    <img width="18" height="18" src="@Client.CurrentSkin.GetImageUrl(recipient)" alt="@Client.CurrentSkin.Describe(recipient)" />@answer
                                                </span>
                                            }
                                            @if (recipients.Any() && recipients.All(r => Game.DealResponse(offer, r) == false))
                                            {
                                                <span class="deal-answer-none">Declined by everyone</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <button class="btn btn-secondary btn-sm" @onclick="e => Cancel(offerToShow)">Withdraw</button>
                                    </td>
                                </tr>

                            }

                        </tbody>

                    </table>
                }

                @if (currentDeals.Any())
                {
                    <label>Current deals</label>
                    <table class="table table-sm">
                        <tbody>
                            @foreach (var deal in currentDeals)
                            {
                                <tr class="table-dark">
                                    <td class="p-0">
                                        <FactionChip Faction=@deal.BoundFaction Game=Game/>
                                        ⇒
                                        <FactionChip Faction=@deal.ConsumingFaction Game=Game/>
                                    </td>
                                    <td class="text-break"><ExpressionComponent Expression=@(deal.DealContentsDescription(Game).Expression) Game=Game/></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    }
</div>

@code {
    
    private bool _collapsed = true;

    // Opened up when shown in a popover from the menu bar (TradePopover).
    [CascadingParameter(Name = "InPopover")]
    public bool InPopover { get; set; }

    private bool _openedInPopover;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (InPopover && !_openedInPopover)
        {
            _openedInPopover = true;
            _collapsed = false;
        }
    }

    private async Task Accept(DealOffered offered)
    {
        await Request(offered.Acceptance(Faction));
    }

    private async Task Cancel(DealOffered offered)
    {
        await Request(offered.Cancellation());
    }

    private async Task Decline(DealOffered offered)
    {
        await Request(offered.Rejection(Faction));
    }

}
