@using Treachery.Client.MapComponents
@inherits GameComponent

@*
 The in-game columns, for Main.razor and Scene.razor: the board with the menu
 bar in its corner, then one column holding your faction, what you're asked
 to do now, and the log. Layout in _game-screen.scss.
*@

<!--Map Column-->
<div id="mapdiv" class="col-sm-12">
    <div class="board-area">
        <GameBoard OnLocationClick="@Client.LocationClick" />
        <MenuComponent/>
        <RedoToast/>
    </div>
    @if (Client.UndoSession != null)
    {
        <UndoTimeline/>
    }
</div>

<!--Faction, actions and log-->
<div class="col-sm-12 cursor-hand side-column">
    <MenuPanels/>
    @if (!Client.IsObserver && Client.CurrentPhase > Phase.TradingFactions)
    {
        if (Client.Player.Faction is Faction.None)
        {
            foreach (var p in Client.Game.Players)
            {
                <PlayerPanel ShownPlayer="p" ShowHeader="true" />
            }
        }
        else
        {
            <PlayerPanel ShownPlayer="Client.Player" />
        }
    }
    <div class="act-stack">
        <GameStatusComponent CanEndPhase="@Client.Actions.Contains(typeof(EndPhase))" />
        <ActionPanel/>
    </div>
    <ReportComponent/>
</div>

<CardPlayPopover/>
<ImageFlashComponent />
