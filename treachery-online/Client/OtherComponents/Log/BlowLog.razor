@using Treachery.Client.MapComponents
@inherits PhaseLogBase

@*
 The Spice Blow's log (design/battle-log/log-matrix.html, Spice Blow, column A).
 Each spice card drawn is shown as the card, with its amount and place beside
 it. A worm is an aside holding what it devoured, and the Nexus after it an
 aside with the alliance changes and the Fremen ride. An alliance change is two
 faction chips with a glyph between them (design/battle-log/nexus.html, column
 C); an offer that was accepted is folded into its alliance. With Increased Spice Flow
 a small caps label heads each deck. Every other message is a plain line in
 its place.
*@

@foreach (var item in Items())
{
    switch (item)
    {
        case DeckItem deck:
            <div class="log-label blow-deck">Deck @deck.Log.Deck</div>
            break;

        case CardItem card:
            @Card(card.Message, card.Log)
            break;

        case NoteItem note:
            <div class="blow-note"><ExpressionComponent Expression="@note.Message.Expression" Game="@Game" Size="18" LogStyle/></div>
            break;

        case WormItem worm:
            <div class="log-aside blow-worm" data-ref-locations="@Locations(worm.Territory)">
                @foreach (var message in worm.Messages)
                {
                    @WormLine(message)
                }
            </div>
            break;

        case NexusItem nexus:
            <div class="log-aside blow-nexus">
                <div class="log-label">Nexus</div>
                @if (nexus.Messages.Count == 0)
                {
                    <div class="blow-none">No alliance changes</div>
                }
                @foreach (var message in nexus.Messages.Where(m => !Accepted(m, nexus.Messages)))
                {
                    @NexusLine(message, nexus.Messages)
                }
            </div>
            break;

        case LineItem line:
            @Line(line.Message)
            break;
    }
}

@code {

    private abstract record Item;

    private sealed record LineItem(Message Message) : Item;

    private sealed record DeckItem(BlowDeckLog Log) : Item;

    private sealed record CardItem(Message Message, BlowCardLog Log) : Item;

    // A small line of its own: a worm ignored on turn 1, the deck reshuffled.
    private sealed record NoteItem(Message Message) : Item;

    private sealed record WormItem(Territory? Territory, List<Message> Messages) : Item;

    private sealed record NexusItem(List<Message> Messages) : Item;

    // The messages as the design's pieces, in the game's order.
    //
    // A worm's aside opens at its first line and holds the lines right after it
    // about the same worm. The Nexus aside holds a deck's Nexus lines and
    // whatever was logged between them (a Nexus card discarded as an alliance
    // is made). The Nexus itself logs nothing, so a deck where a worm appeared
    // but no alliance changed gets an aside saying so after its last worm or
    // card line, once the Nexus has begun.
    private List<Item> Items()
    {
        var items = new List<Item>();
        var sections = Sections();

        for (var s = 0; s < sections.Count; s++)
        {
            var section = sections[s];
            var firstNexus = section.FindIndex(m => m.Log is NexusLog);
            var hadWorm = section.Any(m => m.Log is WormAppearedLog or WormSentLog);
            var lastBlowItem = -1;
            WormItem? worm = null;
            NexusItem? nexus = null;

            for (var i = 0; i < section.Count; i++)
            {
                var message = section[i];

                // A Nexus line, or a line logged between two of them.
                if (message.Log is NexusLog || (nexus != null && message.Log is not BlowCardLog && !IsWorm(message) && NexusContinues(section, i)))
                {
                    if (nexus == null)
                    {
                        nexus = new NexusItem([]);
                        items.Add(nexus);
                    }

                    nexus.Messages.Add(message);
                    worm = null;
                    continue;
                }

                switch (message.Log)
                {
                    case BlowDeckLog deck:
                        items.Add(new DeckItem(deck));
                        break;

                    case BlowCardLog card:
                        items.Add(new CardItem(message, card));
                        lastBlowItem = items.Count - 1;
                        worm = null;
                        nexus = null;
                        break;

                    case WormAppearedLog appeared:
                        worm = new WormItem(appeared.Territory, [message]);
                        items.Add(worm);
                        lastBlowItem = items.Count - 1;
                        nexus = null;
                        break;

                    // The Fremen choosing where a later worm goes, right after the
                    // game says it appears again: one worm, one aside, and the send
                    // line stands in for "appears a second time" (as in the mockup).
                    case WormSentLog sent when worm != null && ReferenceEquals(items[^1], worm) && worm.Messages[^1].Log is WormAppearedLog:
                        worm.Messages[^1] = message;
                        items[^1] = worm = worm with { Territory = sent.Territory };
                        break;

                    case WormSentLog sent:
                        worm = new WormItem(sent.Territory, [message]);
                        items.Add(worm);
                        lastBlowItem = items.Count - 1;
                        nexus = null;
                        break;

                    case WormDevouredForcesLog or WormSurvivedLog or WormDevouredSpiceLog:
                        if (worm == null || !ReferenceEquals(items[^1], worm))
                        {
                            worm = new WormItem(null, []);
                            items.Add(worm);
                        }

                        worm.Messages.Add(message);
                        lastBlowItem = items.Count - 1;
                        break;

                    case WormIgnoredLog or BlowReshuffleLog:
                        items.Add(new NoteItem(message));
                        break;

                    default:
                        items.Add(new LineItem(message));
                        worm = null;
                        break;
                }
            }

            if (hadWorm && firstNexus < 0 && lastBlowItem >= 0 && NexusBegun(s == sections.Count - 1))
                items.Insert(lastBlowItem + 1, new NexusItem([]));
        }

        return items;
    }

    private static bool IsWorm(Message m) =>
        m.Log is WormAppearedLog or WormSentLog or WormDevouredForcesLog or WormSurvivedLog or WormDevouredSpiceLog;

    // Whether another Nexus line comes after message i before the next card or worm.
    private static bool NexusContinues(List<Message> section, int i) =>
        section.Skip(i + 1).FirstOrDefault(m => m.Log is NexusLog or BlowCardLog || IsWorm(m))?.Log is NexusLog;

    // The messages split at each deck heading.
    private List<List<Message>> Sections()
    {
        var sections = new List<List<Message>> { new() };
        foreach (var message in Messages)
        {
            if (message.Log is BlowDeckLog && sections[^1].Count > 0) sections.Add([]);
            sections[^1].Add(message);
        }

        return sections;
    }

    // Whether a deck's Nexus has started. Only the deck being drawn in the
    // phase going on now can still be waiting for its card or a worm sent by
    // the Fremen.
    private bool NexusBegun(bool lastSection)
    {
        if (!lastSection || Game.CurrentMainPhase != MainPhase.Blow) return true;
        if (Messages.Count == 0 || Game.Reports.LastOrDefault()?.Messages.Contains(Messages[0]) != true) return true;

        return Game.CurrentPhase is not (Phase.Thumper or Phase.BlowA or Phase.BlowB or Phase.HarvesterA or Phase.HarvesterB
            or Phase.YellowSendingMonsterA or Phase.YellowSendingMonsterB);
    }

    // The card as a card. Beside it the amount, then where, or that the storm took it.
    private RenderFragment Card(Message message, BlowCardLog card) =>
        @<div class="blow-card" data-ref-locations="@card.Location.Id">
            <img class="card @(card.Lost ? "lost" : "")" src="@Client.CurrentSkin.GetImageUrl(card.Card)" alt="@Client.CurrentSkin.Describe(card.Card)" title="@Client.CurrentSkin.Describe(card.Card)"/>
            <div>
                <div class="big">
                    <SpiceComponent Amount="@card.Amount.ToString()" Size="34"/>
                    @if (!card.Lost)
                    {
                        <span>detected in</span>
                    }
                </div>
                <div class="where">
                    @if (card.Lost)
                    {
                        <span>in </span><PlaceChip Place="@card.Location"/><span> is lost in the storm</span>
                    }
                    else
                    {
                        <PlaceChip Place="@card.Location"/>
                        @if (card.Doubled)
                        {
                            <span>, doubled by @Client.CurrentSkin.Describe(Concept.BabyMonster)</span>
                        }
                    }
                </div>
            </div>
        </div>;

    // A line inside a worm's aside. The aside's first line names the place, so
    // what the worm devours doesn't repeat it.
    private RenderFragment WormLine(Message message) => message.Log switch
    {
        WormDevouredForcesLog d =>
            @<div class="blow-line"><MonsterIcon/> devours <FactionChip Faction="@d.Faction" Game="@Game"/> @Forces(d.Faction, d.Forces, d.SpecialForces)</div>,
        WormSurvivedLog s =>
            @<div class="blow-line"><FactionChip Faction="@s.Faction" Game="@Game"/> survive <MonsterIcon/></div>,
        WormDevouredSpiceLog sp =>
            @<div class="blow-line"><MonsterIcon/> devours <SpiceComponent Amount="@sp.Amount.ToString()" Size="20"/></div>,
        _ =>
            @<div class="blow-line"><ExpressionComponent Expression="@message.Expression" Game="@Game" Size="20" LogStyle/></div>
    };

    // A line inside the Nexus aside: the game's sentence, with ridden forces
    // drawn as number and token. Other messages logged during the Nexus are
    // plain lines.
    private RenderFragment NexusLine(Message message, List<Message> nexus) => message.Log switch
    {
        NexusLog { Alliance: { Change: NexusAllianceChange.Made } made } =>
            AllianceMade(made, nexus),
        NexusLog { Alliance: { } change } =>
            AllianceStep(change.Change, change.From, change.To),
        NexusLog { Ride: { } ride } =>
            @<div class="blow-line" style="--fc:@Client.CurrentSkin.GetFactionColor(ride.Faction)" data-ref-locations="@RouteLocations(message.Route)" data-ref-arrow="@RouteArrow(message.Route)">
                <FactionChip Faction="@ride.Faction" Game="@Game"/> ride @Forces(ride.Faction, ride.Forces, ride.SpecialForces)
                @if (ride.From != null)
                {
                    <span>from </span><PlaceChip Place="@ride.From"/><span> to </span><PlaceChip Place="@ride.To"/>
                }
                else
                {
                    <span>from their reserves to </span><PlaceChip Place="@ride.To"/>
                }
            </div>,
        NexusLog =>
            @<div class="blow-line"><ExpressionComponent Expression="@message.Expression" Game="@Game" Size="20" LogStyle/></div>,
        _ => Line(message)
    };

    // One alliance change as two faction chips with a glyph for the verb
    // between them (design/battle-log/nexus.html, column C).
    private RenderFragment AllianceStep(NexusAllianceChange change, Faction from, Faction to) =>
        @<div class="blow-line nexus-step">
            <FactionChip Faction="@from" Game="@Game"/>
            @AllianceGlyph(change)
            <FactionChip Faction="@to" Game="@Game"/>
        </div>;

    // The faction that made the offer goes first, so the row reads in the order it happened.
    private RenderFragment AllianceMade(NexusAlliance made, List<Message> nexus)
    {
        var first = Offerer(made, nexus);
        return AllianceStep(NexusAllianceChange.Made, first, first == made.From ? made.To : made.From);
    }

    private static RenderFragment AllianceGlyph(NexusAllianceChange change) => change switch
    {
        NexusAllianceChange.Made =>
            @<svg class="nexus-glyph" viewBox="0 0 22 22" role="img" aria-label="allied with"><title>allied with</title>
                <circle cx="8" cy="11" r="5"/><path d="M14 6a5 5 0 1 1 0 10"/><path d="M14 16a5 5 0 0 1-4.6-3"/><path d="M9.4 9A5 5 0 0 1 14 6"/>
            </svg>,
        NexusAllianceChange.Offered =>
            @<svg class="nexus-glyph" viewBox="0 0 22 22" role="img" aria-label="offer an alliance to"><title>offer an alliance to</title>
                <path d="M3 11h11" stroke-dasharray="2.2 2.6"/><path d="M13 6.5l5 4.5-5 4.5"/>
            </svg>,
        _ =>
            @<svg class="nexus-glyph" viewBox="0 0 22 22" role="img" aria-label="ended their alliance with"><title>ended their alliance with</title>
                <path d="M8.5 7.2A4.2 4.2 0 1 0 8.5 14.8"/><path d="M13.5 7.2A4.2 4.2 0 1 1 13.5 14.8"/><path d="M11 5.5v2.2M11 14.3v2.2M11 10v2"/>
            </svg>
    };

    // An offer that an alliance later in the same Nexus answered. The
    // alliance's row stands for it.
    private static bool Accepted(Message message, List<Message> nexus) =>
        message.Log is NexusLog { Alliance: { Change: NexusAllianceChange.Offered } offer } &&
        nexus.Skip(nexus.IndexOf(message) + 1).Any(m => m.Log is NexusLog { Alliance: { Change: NexusAllianceChange.Made } made } && SamePair(made, offer));

    // Who made the offer an alliance accepted. An alliance without an offer in
    // this Nexus keeps the game's order.
    private static Faction Offerer(NexusAlliance made, List<Message> nexus) =>
        nexus.Select(m => m.Log).OfType<NexusLog>().Select(l => l.Alliance)
            .FirstOrDefault(a => a is { Change: NexusAllianceChange.Offered } && SamePair(a, made))?.From ?? made.From;

    private static bool SamePair(NexusAlliance a, NexusAlliance b) =>
        (a.From == b.From && a.To == b.To) || (a.From == b.To && a.To == b.From);

    // Forces as number and token, special forces after.
    private RenderFragment Forces(Faction faction, int forces, int specialForces) =>
        @<span class="blow-forces">
            @if (forces > 0)
            {
                <SimpleNumberComponent Size="20">@forces</SimpleNumberComponent><ForceToken Faction="@faction" Size="20"/>
            }
            @if (specialForces > 0)
            {
                <SimpleNumberComponent Size="20">@specialForces</SimpleNumberComponent><ForceToken Faction="@faction" Special Size="20"/>
            }
        </span>;

    private static string Locations(Territory? territory) =>
        territory == null ? "" : string.Join(",", territory.Locations.Select(l => l.Id));

    // The places a ride touches and its arrows, as the report's plain line draws them.
    private static string RouteLocations(Route? route) =>
        route == null ? "" : string.Join(",", route.From.Concat(route.To != null ? [route.To] : []).Select(l => l.Id));

    private string RouteArrow(Route? route)
    {
        if (route == null) return "";
        var skin = Client.CurrentSkin;
        var token = Game.GetPlayer(route.Faction) is { } player ? SectorGeometry.PlayerTokenPosition(skin, Game, player.Seat) : (PointD?)null;
        var end = route.To != null && SectorGeometry.HasCenter(skin, route.To) ? skin.GetCenter(route.To, Game.Map) : token;
        if (end == null) return "";
        var starts = route.From.Where(l => SectorGeometry.HasCenter(skin, l)).Select(l => skin.GetCenter(l, Game.Map)).ToList();
        if (starts.Count == 0 && token is { } t) starts.Add(t);
        return string.Join(";", starts.Select(p => $"{Support.Round(p.X)},{Support.Round(p.Y)},{Support.Round(end.Value.X)},{Support.Round(end.Value.Y)}"));
    }
}
