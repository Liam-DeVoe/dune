@inherits PhaseLogBase

@*
 The CHOAM Charity log: one row per claim, faction pills down the left and
 the amounts lined up down the right. Other lines (Karama, Choam's controlled
 charity, tech token income) keep their place: those before the first claim
 above the table, the rest below it.
*@
@{
    var first = Messages.FindIndex(m => m.Log is CharityClaim);
}
@for (var i = 0; i < Messages.Count; i++)
{
    var message = Messages[i];
    if (i == first)
    {
        <div class="log-cols">
            @foreach (var claim in Messages.Select(m => m.Log).OfType<CharityClaim>())
            {
                <div><FactionChip Faction="@claim.Faction" Game="@Game"/></div>
                <div><SpiceComponent Amount="@claim.Amount.ToString()"/></div>
            }
        </div>
    }
    else if (message.Log is not CharityClaim)
    {
        @Line(message)
    }
}
