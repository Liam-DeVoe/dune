@inherits PhaseLogBase

@*
 The Mentat log. Bribes collected are one row per faction: pill on the left,
 amount on the right. When the game ends, a result block says so, names the
 winners and gives the game's reason line. If a Bene Gesserit prediction took
 over the win, the earlier reason stays a plain line where it was. Other
 lines keep their place.
*@
@{
    var firstBribe = Messages.FindIndex(m => m.Log is BribesCollected);
    var ended = Messages.FindIndex(m => m.Log is GameEnded);
    var reason = ended < 0 ? -1 : Messages.FindLastIndex(ended, m => m.Log is WinReason);
}
@for (var i = 0; i < Messages.Count; i++)
{
    var message = Messages[i];
    if (i == firstBribe)
    {
        <div class="log-label mentat-bribes-label">Bribes collected</div>
        <div class="log-cols mentat-bribes">
            @foreach (var bribe in Messages.Select(m => m.Log).OfType<BribesCollected>())
            {
                <div><FactionChip Faction="@bribe.Faction" Game="@Game"/></div>
                <div><SpiceComponent Amount="@bribe.Amount.ToString()"/></div>
            }
        </div>
    }
    else if (i == ended && message.Log is GameEnded result)
    {
        <div class="mentat-result">
            <div class="title">@message.ToString(Client.CurrentSkin)</div>
            @if (result.Winners.Count > 0)
            {
                <div class="winners">
                    @foreach (var winner in result.Winners)
                    {
                        <span class="winner"><FactionChip Faction="@winner" Game="@Game"/> win!</span>
                    }
                </div>
            }
            @if (reason >= 0)
            {
                <div class="reason">
                    <ExpressionComponent Expression="@Messages[reason].Expression" Game="@Game" Size="20" LogStyle/>
                </div>
            }
        </div>
    }
    else if (message.Log is not (BribesCollected or GameWinner) && i != reason)
    {
        @Line(message)
    }
}
