@inherits PhaseLogBase

@*
 The Revival log: one table, a row per revival. Faction pill, then what came
 back (leader disc, Kwisatz Haderach, a token per force), then the cost on the
 right: nothing when free, the card when a card did it, and who paid when
 someone else did. Other lines keep their place: those before the first
 revival above the table, the rest below it. The discard of the card that did
 a revival is shown by the card in its row, so that line is left out.
*@
@{
    var first = Messages.FindIndex(m => m.Log is RevivalRow);
    var rows = Messages.Select(m => m.Log).OfType<RevivalRow>().ToList();
}
@for (var i = 0; i < Messages.Count; i++)
{
    var message = Messages[i];
    if (i == first)
    {
        <div class="log-table revival-table">
            @for (var r = 0; r < rows.Count; r++)
            {
                var row = rows[r];
                var edge = r == 0 ? "first" : "";
                <div class="cell @edge"><FactionChip Faction="@row.Faction" Game="@Game"/></div>
                <div class="cell what @edge">
                    @if (row.Hero is Leader leader)
                    {
                        <Image Shown="@leader" Game="@Game" Width="26" Class="leader-disc" NoShadow/>
                    }
                    else if (row.Hero is Messiah)
                    {
                        <img class="kh" src="@Client.CurrentSkin.Messiah_URL" alt="@Client.CurrentSkin.Describe(Concept.Messiah)" title="@Client.CurrentSkin.Describe(Concept.Messiah)"/>
                    }
                    @if (row.AsGhola)
                    {
                        <span class="note">as Ghola</span>
                    }
                    @for (var n = 0; n < row.Forces; n++)
                    {
                        <ForceToken Faction="@row.Faction" Size="18"/>
                    }
                    @for (var n = 0; n < row.SpecialForces; n++)
                    {
                        <ForceToken Faction="@row.Faction" Special Size="18"/>
                    }
                </div>
                <div class="cell cost end @edge">
                    @if (row.Card != null)
                    {
                        <ExpressionComponent Expression="@(new Expression(row.Card))" Game="@Game" Size="20" LogStyle/>
                    }
                    else if (row.Cost > 0)
                    {
                        <SpiceComponent Amount="@row.Cost.ToString()"/>
                    }
                    @if (row.PaidByOther > 0)
                    {
                        <div class="by">
                            @if (row.PaidByOther < row.Cost)
                            {
                                <SpiceComponent Amount="@row.PaidByOther.ToString()" Size="16"/>
                            }
                            paid by @Sigil(row.Payer)
                        </div>
                    }
                    @if (row.TleilaxuIncome > 0)
                    {
                        <div class="by">→ @Sigil(Faction.Tleilaxu) get <SpiceComponent Amount="@row.TleilaxuIncome.ToString()" Size="16"/></div>
                    }
                </div>
            }
        </div>
    }
    else if (message.Log is not RevivalRow && !DiscardOfRevivalCard(i))
    {
        @Line(message)
    }
}

@code {

    // A faction's sigil, small, named on hover.
    private RenderFragment Sigil(Faction faction) =>
        @<img class="sig" src="@Client.CurrentSkin.GetImageUrl(faction)" alt="@Client.CurrentSkin.Describe(faction)" title="@Client.CurrentSkin.Describe(faction)"/>;

    // The discard straight after a revival done by that card.
    private bool DiscardOfRevivalCard(int i) =>
        i > 0 &&
        Messages[i].Fact is { Kind: BattleFactKind.Discard, Card: { } card } fact &&
        Messages[i - 1].Log is RevivalRow { Card: { } used } row &&
        used == card && row.Faction == fact.Faction;
}
