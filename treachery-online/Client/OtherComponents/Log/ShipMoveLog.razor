@inherits PhaseLogBase
@using Treachery.Client.MapComponents

@*
 The Ship & Move log: one block per faction turn, in acting order.
 Each block has a Ship (or Rally) row and a Move row, "passed" when the
 faction did nothing; a Hajr move gets its own row. Bene Gesserit answers and
 forces lost follow the row that caused them, marked +. The game logs storm
 losses before the shipment or move that caused them, so they wait for it.
 Lines the design doesn't draw keep their place: inside the block while the
 turn is under way, between blocks otherwise.
*@
@foreach (var item in Build())
{
    switch (item)
    {
        case Message message:
            @Line(message)
            break;

        case Delay delay:
            <div class="shipmove-delay">
                <ExpressionComponent Expression="@delay.Messages[0].Expression" Game="@Game" Size="20" LogStyle/>
                @if (delay.Messages.Count > 1)
                {
                    <span>×@delay.Messages.Count</span>
                }
            </div>
            break;

        case Turn turn:
            <div class="log-box shipmove-turn">
                <div class="head">
                    <FactionChip Faction="@turn.Faction" Game="@Game"/>
                </div>
                <div class="rows">
                    @foreach (var row in turn.Rows)
                    {
                        @Row(turn.Faction, row)
                    }
                </div>
            </div>
            break;
    }
}

@code {

    private enum RowKind { Ship, Move, Passed, Plus, Other }

    private sealed record RowData(RowKind Kind, List<Message> Messages);

    private sealed class Turn(Faction faction)
    {
        public Faction Faction { get; } = faction;
        public List<RowData> Rows { get; } = [];

        // The faction's move is over: lines that aren't theirs go between blocks.
        public bool Closed { get; set; }

        // "pass movement" was logged before the shipment (the game skips the
        // move when nothing can move): the Move row goes last.
        public bool PassPending { get; set; }
    }

    private sealed record Delay(List<Message> Messages);

    // The log as a list of plain lines (Message), Guild delays and turn blocks.
    private List<object> Build()
    {
        var items = new List<object>();
        Turn? turn = null;
        var storm = new List<Message>();
        var early = new List<Message>();
        var afterMove = false;

        void FlushStorm()
        {
            if (turn != null)
                foreach (var m in storm) turn.Rows.Add(new RowData(RowKind.Plus, [m]));
            else
                items.AddRange(storm);
            storm.Clear();
        }

        void Close()
        {
            if (turn == null) return;
            if (turn.PassPending && !turn.Rows.Any(r => r.Kind is RowKind.Move or RowKind.Passed))
                turn.Rows.Add(new RowData(RowKind.Passed, []));
            turn.PassPending = false;
        }

        foreach (var message in Messages)
        {
            // Storm losses on the way wait until every line of the move is in.
            if (afterMove && !(message.Log is MoveLogged next && turn?.Rows.LastOrDefault() is { Kind: RowKind.Move } last && ((MoveLogged)last.Messages[0].Log!).Move == next.Move))
            {
                afterMove = false;
                FlushStorm();
            }

            switch (message.Log)
            {
                case GuildDelayed:
                    Close();
                    turn = null;
                    if (items.LastOrDefault() is Delay delay) delay.Messages.Add(message);
                    else items.Add(new Delay([message]));
                    break;

                case ShipLogged ship:
                    Close();
                    // The Karama card shows in the Ship row; its discard line goes.
                    if (ship.Karama != null && items.LastOrDefault() is Message discarded && IsDiscardOf(discarded, Faction.None, c => c == ship.Karama))
                        items.RemoveAt(items.Count - 1);
                    turn = new Turn(ship.Faction);
                    items.Add(turn);
                    turn.Rows.Add(new RowData(RowKind.Ship, [message]));
                    FlushStorm();
                    foreach (var m in early.Where(m => FactionOf(m) == ship.Faction).ToList())
                    {
                        early.Remove(m);
                        if (m.Log is MovePassed) turn.PassPending = turn.Closed = true;
                        else turn.Rows.Add(new RowData(RowKind.Plus, [m]));
                    }
                    break;

                case MoveLogged move:
                    // The HAJR label names the card; its discard line goes.
                    if (move.Hajr && turn?.Rows.LastOrDefault() is { Kind: RowKind.Other } hajr && IsDiscardOf(hajr.Messages[0], move.Faction, c => c.Type == TreacheryCardType.Caravan))
                        turn.Rows.Remove(hajr);
                    else if (move.Hajr && items.LastOrDefault() is Message discard && IsDiscardOf(discard, move.Faction, c => c.Type == TreacheryCardType.Caravan))
                        items.RemoveAt(items.Count - 1);

                    if (turn == null || turn.Faction != move.Faction)
                    {
                        Close();
                        turn = new Turn(move.Faction);
                        items.Add(turn);
                    }

                    if (turn.Rows.LastOrDefault() is { Kind: RowKind.Move } previous && ((MoveLogged)previous.Messages[0].Log!).Move == move.Move)
                        previous.Messages.Add(message);
                    else
                        turn.Rows.Add(new RowData(RowKind.Move, [message]));

                    if (!move.Hajr) turn.Closed = true;
                    afterMove = true;
                    break;

                case MovePassed passed when turn?.Faction == passed.Faction:
                    turn.Rows.Add(new RowData(RowKind.Passed, []));
                    turn.Closed = true;
                    break;

                case MovePassed:
                    early.Add(message);
                    break;

                case BeneGesseritReaction when turn != null:
                    turn.Rows.Add(new RowData(RowKind.Plus, [message]));
                    break;

                case ShipMoveLoss { Storm: true }:
                    storm.Add(message);
                    break;

                case ShipMoveLoss loss when turn?.Faction == loss.Faction:
                    turn.Rows.Add(new RowData(RowKind.Plus, [message]));
                    break;

                case ShipMoveLoss:
                    early.Add(message);
                    break;

                default:
                    if (turn is { Closed: false })
                        turn.Rows.Add(new RowData(RowKind.Other, [message]));
                    else
                        items.Add(message);
                    break;
            }
        }

        Close();
        FlushStorm();
        items.AddRange(early);
        return items;
    }

    // The game's "X discard [card]" line (faction None: anyone).
    private static bool IsDiscardOf(Message m, Faction faction, Func<TreacheryCard, bool> card) =>
        m.Fact is { Kind: BattleFactKind.Discard, Card: { } c } fact && card(c) && (faction == Faction.None || fact.Faction == faction);

    private static Faction FactionOf(Message m) => m.Log switch
    {
        MovePassed p => p.Faction,
        ShipMoveLoss l => l.Faction,
        _ => Faction.None
    };

    private RenderFragment Row(Faction faction, RowData row) => row.Kind switch
    {
        RowKind.Ship => ShipRow(faction, row.Messages[0]),
        RowKind.Move => MoveRow(faction, row.Messages),
        RowKind.Passed =>
            @<text>
                <span class="log-label">Move</span>
                <span class="route">passed</span>
            </text>,
        RowKind.Plus =>
            @<text>
                <span class="log-label plus">+</span>
                <span class="route">@PlusText(row.Messages[0])</span>
            </text>,
        _ => @<div class="other">@Line(row.Messages[0])</div>
    };

    private RenderFragment ShipRow(Faction faction, Message message)
    {
        var s = (ShipLogged)message.Log!;
        var rally = s.Kind == ShipKind.Normal && s.Cost == 0;
        return
            @<text>
                <span class="log-label">@(rally ? "Rally" : "Ship")</span>
                <span class="route" @attributes="RouteAttributes(message.Route)">
                    @if (s.Plain)
                    {
                        <ExpressionComponent Expression="@message.Expression" Game="@Game" Size="20" LogStyle/>
                    }
                    else if (s.Kind == ShipKind.Passed)
                    {
                        if (s.Blocked)
                        {
                            <span>blocked by</span>
                            @Card(s.BlockedBy)
                        }
                        else
                        {
                            <span>passed</span>
                        }
                    }
                    else
                    {
                        @Forces(faction, s.Forces, s.SpecialForces)
                        @if (s.From != null)
                        {
                            <PlaceChip Place="@s.From"/>
                        }
                        <span>→</span>
                        @if (s.Kind == ShipKind.BackToReserves)
                        {
                            <span>reserves</span>
                        }
                        else if (s.To != null)
                        {
                            <PlaceChip Place="@s.To"/>
                        }
                        @if (s.Cost > 0)
                        {
                            <SpiceComponent Amount="@s.Cost.ToString()"/>
                            @if (s.AllyShare >= s.Cost)
                            {
                                <span class="small">paid by</span>
                                <FactionChip Faction="@s.Ally" Game="@Game"/>
                            }
                            else if (s.AllyShare > 0)
                            {
                                <span class="small">(<SpiceComponent Amount="@s.AllyShare.ToString()"/> paid by</span>
                                <FactionChip Faction="@s.Ally" Game="@Game"/>
                                <span class="small">)</span>
                            }
                        }
                        @if (s.GuildPaid)
                        {
                            <span class="small">→</span>
                            <FactionChip Faction="Faction.Guild" Game="@Game"/>
                        }
                        @if (s.Karama != null)
                        {
                            @Card(s.Karama)
                        }
                    }
                </span>
            </text>;
    }

    private RenderFragment MoveRow(Faction faction, List<Message> messages)
    {
        var moves = messages.Select(m => (MoveLogged)m.Log!).ToList();
        var first = moves[0];
        var route = new Route(faction, messages.SelectMany(m => m.Route?.From ?? []).ToList(), first.To);
        return
            @<text>
                <span class="log-label">@(first.Hajr ? "Hajr" : "Move")</span>
                <span class="route" @attributes="RouteAttributes(route)">
                    @for (var i = 0; i < moves.Count; i++)
                    {
                        if (i > 0)
                        {
                            <span>+</span>
                        }
                        @Forces(faction, moves[i].Forces, moves[i].SpecialForces)
                        <PlaceChip Place="@moves[i].From"/>
                    }
                    <span>→</span>
                    <PlaceChip Place="@first.To"/>
                    @if (first.AsAdvisors is { } advisors)
                    {
                        <span>as</span>
                        <ForceToken Faction="@faction" Special="@advisors" Size="20"/>
                    }
                </span>
            </text>;
    }

    private RenderFragment PlusText(Message message) => message.Log switch
    {
        BeneGesseritReaction { Kind: BeneGesseritReactionKind.Accompany } r =>
            @<text><FactionChip Faction="Faction.BeneGesserit" Game="@Game"/><span>accompany to</span><PlaceChip Place="@(r.Place!)"/></text>,
        BeneGesseritReaction { Kind: BeneGesseritReactionKind.DontAccompany } =>
            @<text><FactionChip Faction="Faction.BeneGesserit" Game="@Game"/><span>don't accompany</span></text>,
        BeneGesseritReaction r =>
            @<text>
                <FactionChip Faction="Faction.BeneGesserit" Game="@Game"/>
                <span>@(r.Kind == BeneGesseritReactionKind.Become ? "become" : "stay as")</span>
                <ForceToken Faction="Faction.BeneGesserit" Special="@r.Advisors" Size="20"/>
                <span>in</span>
                <PlaceChip Place="@(r.Place!)"/>
            </text>,
        ShipMoveLoss { Storm: true } l =>
            @<text>
                <FactionChip Faction="@l.Faction" Game="@Game"/>
                @Forces(l.Faction, l.Forces, 0)
                <span>are killed by the storm@(l.Travelling ? " while travelling" : "")</span>
            </text>,
        ShipMoveLoss l =>
            @<text>
                <span>All</span>
                <FactionChip Faction="@l.Faction" Game="@Game"/>
                <span>forces in</span>
                <PlaceChip Place="@(l.Territory!)"/>
                <span>were killed due to ally presence</span>
            </text>,
        _ => @<ExpressionComponent Expression="@message.Expression" Game="@Game" Size="20" LogStyle/>
    };

    private static RenderFragment Forces(Faction faction, int forces, int specialForces) =>
        @<text>
            @if (forces > 0)
            {
                <span class="forces"><SimpleNumberComponent Size="20">@forces</SimpleNumberComponent><ForceToken Faction="@faction" Size="20"/></span>
            }
            @if (specialForces > 0)
            {
                <span class="forces"><SimpleNumberComponent Size="20">@specialForces</SimpleNumberComponent><ForceToken Faction="@faction" Special Size="20"/></span>
            }
        </text>;

    private RenderFragment Card(TreacheryCard? card) =>
        @<ExpressionComponent Expression="@(new Expression(card ?? (object)TreacheryCardType.Karma))" Game="@Game" Size="20" LogStyle/>;

    // The hover attributes of the report's route lines: the places involved
    // and one map arrow per source (see ReportComponent.RouteArrow).
    private Dictionary<string, object> RouteAttributes(Route? route)
    {
        if (route == null) return [];
        var skin = Client.CurrentSkin;
        var token = Game.GetPlayer(route.Faction) is { } player ? SectorGeometry.PlayerTokenPosition(skin, Game, player.Seat) : (PointD?)null;
        var end = route.To != null && SectorGeometry.HasCenter(skin, route.To) ? skin.GetCenter(route.To, Game.Map) : token;
        var starts = route.From.Where(l => SectorGeometry.HasCenter(skin, l)).Select(l => skin.GetCenter(l, Game.Map)).ToList();
        if (starts.Count == 0 && token is { } t) starts.Add(t);
        var arrow = end is { } e
            ? string.Join(";", starts.Select(p => $"{Support.Round(p.X)},{Support.Round(p.Y)},{Support.Round(e.X)},{Support.Round(e.Y)}"))
            : "";
        return new()
        {
            ["style"] = $"--fc:{skin.GetFactionColor(route.Faction)}",
            ["data-ref-locations"] = string.Join(",", route.From.Concat(route.To != null ? [route.To] : []).Select(l => l.Id)),
            ["data-ref-arrow"] = arrow
        };
    }
}
