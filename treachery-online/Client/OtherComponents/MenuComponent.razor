@inherits GameComponent

@*
 The toolbar above the player panel: players, a menu, and leave. The menu
 holds everything else. Rules and sound expand in place; the host's tools sit
 in their own section at the bottom. A click outside or Escape closes the
 menu. The menu stays in the page while closed, because the music player
 lives inside it with the volume sliders.
*@

<div class="menu-bar">

    @if (BotsPaused)
    {
        <button class="badge spice" title="Bots are paused. Click to resume." @onclick="@(() => Client.RequestSetBotSpeed(1))">Bots paused</button>
    }

    <div class="toolbar">
        @if (Started)
        {
            <button class="@(IsVisible(Players) ? "on" : "")" title="Players" @onclick="@(() => { CloseMenus(); SetVisible(Players); })">
                <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2 20c0-4 3-6 7-6s7 2 7 6"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14c3 0 5 1.5 5 5"/></svg>
            </button>
        }
        <button class="@(_menuOpen ? "on" : "")" title="Menu" @onclick="ToggleMenu">
            <svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.2"/><circle cx="12" cy="12" r="1.2"/><circle cx="19" cy="12" r="1.2"/></svg>
        </button>
        @if (Client.InGame)
        {
            <button class="@(_leaveOpen ? "on" : "")" title="To main screen" @onclick="ToggleLeave">
                <svg viewBox="0 0 24 24"><path d="M10 4H5v16h5M14 8l4 4-4 4M18 12H9"/></svg>
            </button>
        }
    </div>

    @if (_menuOpen || _leaveOpen)
    {
        <div class="menu-scrim" @onclick="CloseMenus"></div>
    }

    <ul class="menu-overflow @(_menuOpen ? "show" : "")">

        <li>
            <button class="dropdown-item" @onclick="@(() => _rulesOpen = !_rulesOpen)">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>Rules &amp; help<span class="trail"><span class="chev">@(_rulesOpen ? "▾" : "▸")</span></span>
            </button>
        </li>
        @if (_rulesOpen)
        {
            <li class="nested">
                @if (Client.InGame)
                {
                    <button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#mentatModal" @onclick="CloseMenus">List of Cards</button>
                }
                <a class="dropdown-item" href="docs/Dune-Rulebook.pdf" target="_blank">Dune Rulebook</a>
                <a class="dropdown-item" href="docs/Dune-IxianAndTleilaxu-Rulebook.pdf" target="_blank">Ixian &amp; Tleilaxu Rulebook</a>
                <a class="dropdown-item" href="docs/Dune-ChoamAndRichese-Rulebook.pdf" target="_blank">CHOAM &amp; Richese Rulebook</a>
                <a class="dropdown-item" href="docs/Dune-EcazAndMoritani-Rulebook.pdf" target="_blank">Ecaz &amp; Moritani Rulebook</a>
                <a class="dropdown-item" href="docs/Dune-FAQ-Nov-2020.pdf" target="_blank">Dune FAQ</a>
                <a class="dropdown-item" href="https://www.gf9games.com/dune/classic-dune/" target="_blank">Buy boardgame from GF9</a>
                <a class="dropdown-item" href="https://dune.games" target="_blank">Dune Dashboard</a>
                <button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#creditModal" @onclick="CloseMenus">Credits</button>
            </li>
        }

        <li>
            <button class="dropdown-item" @onclick="@(() => _soundOpen = !_soundOpen)">
                <svg viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9z"/><path d="M16 9a4 4 0 0 1 0 6"/></svg>Sound<span class="trail"><span class="chev">@(_soundOpen ? "▾" : "▸")</span></span>
            </button>
        </li>
        <li class="sliders">
            <MusicComponent Visible="_soundOpen"/>
        </li>

        <li>
            <button class="dropdown-item" @onclick="ToggleFullScreen">
                <svg viewBox="0 0 24 24"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/></svg>Fullscreen<span class="trail">@if (_fullscreen) { <span class="check"></span> }</span>
            </button>
        </li>
        <li>
            <a class="dropdown-item" href="https://github.com/ronaldossendrijver/treachery.online/issues" target="_blank" @onclick="CloseMenus">
                <svg viewBox="0 0 24 24"><path d="M8 9a4 4 0 0 1 8 0v5a4 4 0 0 1-8 0z"/><path d="M12 9v9M4 13h4M16 13h4M5 7l3 2M19 7l-3 2M5 19l3-2M19 19l-3-2M10 5l-1-2M14 5l1-2"/></svg>Report a bug or suggest improvements<span class="trail"><svg class="ext" viewBox="0 0 24 24"><path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6"/></svg></span>
            </a>
        </li>

        @if (CanSave)
        {
            <li><hr class="dropdown-divider"></li>
            <li><h6 class="dropdown-header">@(Client.IsHost ? "Host" : "Admin")</h6></li>
            <li>
                <button class="dropdown-item" @onclick="Save">
                    <svg viewBox="0 0 24 24"><path d="M5 4h11l3 3v13H5z"/><path d="M8 4v5h7V4M8 20v-6h8v6"/></svg>Save game
                </button>
            </li>
        }

        @* The file inputs stay in the page while the menu is closed: picking a file closes it. *@
        @if (HostTools)
        {
            <li>
                <label class="dropdown-item">
                    <svg viewBox="0 0 24 24"><path d="M3 19V5h6l2 2h10v12z"/><path d="M12 16v-6M9 12.5 12 10l3 2.5"/></svg>Load game…
                    <input hidden type="file" id="fileInput" @ref="_fileInput" @onchange="LoadGame"/>
                </label>
            </li>
            <li>
                <label class="dropdown-item">
                    <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18c1.4 0 2-.8 2-1.8 0-1.3-1.2-1.6-1.2-2.7 0-.9.8-1.5 1.8-1.5H17a4 4 0 0 0 4-4c0-4.4-4-8-9-8z"/><circle cx="7.5" cy="11" r="1"/><circle cx="10" cy="7" r="1"/><circle cx="15" cy="7.5" r="1"/></svg>Apply skin…
                    <input hidden type="file" id="skinInput" @ref="_skinInput" @onchange="LoadSkin"/>
                </label>
            </li>

            @if (Client.Game.EventCount > 1)
            {
                <li>
                    <button class="dropdown-item" @onclick="OpenUndo">
                        <svg viewBox="0 0 24 24"><path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/></svg>Undo…
                    </button>
                </li>
            }

            @if (Client.Game.NumberOfBots > 0)
            {
                var speed = Client.Game.Participation.BotsSpeed;
                <li class="bots">
                    <svg viewBox="0 0 24 24"><rect x="4" y="8" width="16" height="11" rx="2"/><path d="M12 8V4M9 13v1M15 13v1"/></svg><span>Bots</span>
                    <span class="seg">
                        <button class="@(speed == 0 ? "on" : "")" title="Bots are paused" @onclick="@(() => Client.RequestSetBotSpeed(0))">Pause</button>
                        <button class="@(speed == 1 ? "on" : "")" title="Bots at normal speed" @onclick="@(() => Client.RequestSetBotSpeed(1))">1×</button>
                        <button class="@(speed == 2 ? "on" : "")" title="Bots at higher speed" @onclick="@(() => Client.RequestSetBotSpeed(2))">2×</button>
                        <button class="@(speed == 4 ? "on" : "")" title="Bots at highest speed" @onclick="@(() => Client.RequestSetBotSpeed(4))">4×</button>
                    </span>
                </li>
            }
        }
    </ul>

    @if (_leaveOpen)
    {
        <div class="pop menu-leave">
            <h6>Leave this game?</h6>
            <p>You'll return to the main screen.</p>
            <div class="actions">
                <button class="btn btn-secondary btn-sm" @onclick="CloseMenus">Stay</button>
                <button class="btn btn-danger btn-sm" @onclick="ToMainScreen">Leave</button>
            </div>
        </div>
    }
</div>

<div class="text-danger small">@_loadValidationError</div>

@if (_loadValidationError != "")
{
    <button class="btn btn-primary mt-1 btn-sm" @onclick="ClearValidationErrors">Clear errors</button>
}

@* Shown whenever there is something to restore, so it stays up after the undo panel closes. *@
@if (Client.IsHost)
{
    <RedoComponent/>
}

@if (IsVisible(Host))
{
    <UndoComponent OnClose="@(() => SetVisible(Host))"/>
}
else if (IsVisible(Players))
{
    <JoinedPlayersPanel/>
}

<MentatComponent Id="mentatModal"/>
<CreditComponent Id="creditModal"/>

@code {

    private string _loadValidationError = "";
    private object? _fileInput;
    private object? _skinInput;

    private const string Host = "host";
    private const string Players = "players";

    private const int MaxSaveGameSize = 4194304;
    private const int MaxSkinFileSize = 262144;

    [Parameter]
    public object Visible { get; set; } = null;

    private bool _menuOpen;
    private bool _leaveOpen;
    private bool _rulesOpen;
    private bool _soundOpen;
    private bool _fullscreen;

    private DotNetObjectReference<MenuComponent>? _self;

    private bool Started => Client.Game?.EventCount > 0;

    private bool CanSave => Started && (Client.IsHost || Client.UserName == Client.ServerInfo.AdminName);

    private bool HostTools => Started && Client.IsHost && !Client.IsObserver;

    private bool BotsPaused => HostTools && Client.Game.NumberOfBots > 0 && Client.Game.Participation.BotsSpeed == 0;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _self = DotNetObjectReference.Create(this);
    }

    public override void Dispose()
    {
        base.Dispose();
        _ = Browser.StopListeningForEscape("menu");
        _self?.Dispose();
    }

    private async Task ToggleMenu()
    {
        var open = !_menuOpen;
        CloseMenus();
        if (!open) return;

        _menuOpen = true;
        await Browser.ListenForEscape("menu", _self!);
        _fullscreen = await Browser.IsFullScreen();
    }

    private async Task ToggleLeave()
    {
        var open = !_leaveOpen;
        CloseMenus();
        if (!open) return;

        _leaveOpen = true;
        await Browser.ListenForEscape("menu", _self!);
    }

    private void CloseMenus()
    {
        if (!_menuOpen && !_leaveOpen) return;
        _menuOpen = false;
        _leaveOpen = false;
        _ = Browser.StopListeningForEscape("menu");
    }

    [JSInvokable]
    public void OnEscape()
    {
        CloseMenus();
        StateHasChanged();
    }

    private void OpenUndo()
    {
        CloseMenus();
        Visible = Host;
    }

    private async Task ToMainScreen()
    {
        CloseMenus();
        await Client.ExitGame();
        Client.Refresh(nameof(ToMainScreen));
    }

    private void SetVisible(object o)
    {
        Visible = Visible == o ? null : o;
    }

    private bool IsVisible(object o)
    {
        return o == Visible;
    }

    private async Task ToggleFullScreen()
    {
        CloseMenus();
        await Browser.ToggleFullScreen();
        await Task.Delay(2000).ContinueWith(e => Client.Refresh(nameof(ToggleFullScreen)));
    }

    // Saves the live game, not the moment the undo panel is showing.
    private async Task Save()
    {
        CloseMenus();
        var stateData = GameState.GetStateAsString(Client.UndoSession?.Live ?? Client.Game);
        await Browser.Save("savegame.json", stateData);
    }

    private async Task LoadGame()
    {
        CloseMenus();
        try
        {
            _loadValidationError = "";
            var data = await Browser.LoadFile(_fileInput);
            await Browser.ClearFileInput("fileInput");

            if (data.Length < MaxSaveGameSize)
            {
                await Client.RequestLoadGame(data);
            }
            else
            {
                _loadValidationError = "Saved Game file is too big...";
            }
        }
        catch (Exception e)
        {
            _loadValidationError = $"Error loading game ({e.Message})";
        }
    }

    private async Task LoadSkin()
    {
        CloseMenus();
        try
        {
            _loadValidationError = "";
            var data = await Browser.LoadFile(_skinInput);
            await Browser.ClearFileInput("skinInput");

            if (data.Length < MaxSkinFileSize)
            {
                await Client.RequestSetSkin(data);
            }
            else
            {
                _loadValidationError = "Skin file is too big...";
            }
        }
        catch (Exception e)
        {
            _loadValidationError = $"Error loading skin ({e.Message})";
        }
    }

    private void ClearValidationErrors()
    {
        _loadValidationError = "";
    }
}
