@inherits GameComponent
@inject MenuState Menu

@*
 What the menu bar under the map (MenuComponent) opens, shown at the top of a
 side column: the players list, the host's undo panel, the recently undone
 events, and errors from loading a game or skin.
*@

@if (Menu.LoadError != "")
{
    <div class="text-danger small">@Menu.LoadError</div>
    <button class="btn btn-primary mt-1 mb-2 btn-sm" @onclick="ClearLoadError">Clear errors</button>
}

@* Shown whenever there is something to restore, so it stays up after the undo panel closes. *@
@if (Client.IsHost)
{
    <RedoComponent/>
}

@if (Menu.Panel == MenuPanel.Undo)
{
    <UndoComponent OnClose="Close"/>
}
else if (Menu.Panel == MenuPanel.Players)
{
    <JoinedPlayersPanel/>
}

@code {

    private void ClearLoadError()
    {
        Menu.LoadError = "";
        Client.Refresh(nameof(ClearLoadError));
    }

    private void Close()
    {
        Menu.Close();
        Client.Refresh(nameof(Close));
    }
}
