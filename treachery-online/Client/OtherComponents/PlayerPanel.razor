@inherits GameComponent
@inject MenuState Menu

@*
 A player's panel: spice and reserves in a bar, the leaders with the traitors
 (or face dancers) in a recessed well at the right, any faction extras, and
 the hand of cards under a rule. Styles in _player-panel.scss.
*@

@if (Player != null && Client.CurrentPhase >= Phase.TradingFactions)
{
    <div class="card p-1 mb-1" style="animation:fadeIn 3s;">

        @if (ShowHeader)
        {
            <div class="card-header" @onclick=@(_ => _collapsed = !_collapsed) style="cursor:pointer">
                <FactionChip Faction=@ShownPlayer.Faction Game=Client.Game/>
                <CollapseButton Collapsed=@_collapsed />
            </div>
        }

        @if (!_collapsed || !ShowHeader) {
            <div class="card-body p-0 bg-transparent player-panel">

                <div class="card-text h-100">

                    @if (Client.CurrentPhase >= Phase.HarkonnenMulligan)
                    {
                        <div class="pp-bar">

                            @if (!ShowHeader)
                            {
                                <FactionChip Faction=@ShownPlayer.Faction Game=Client.Game/>
                            }

                            <span class="pp-stat">@((MarkupString)Support.SpiceLineHtml(Client.CurrentSkin, ResourcesText, 24))</span>

                            <span class="pp-stat">
                                <ForceToken Faction="ShownPlayer.Faction" Size="22" ImgClass="m-0 p-0" Title="@Name(ShownPlayer.Force)"/>@ShownPlayer.ForcesInReserve
                            </span>

                            @if (ShownPlayer.HasSpecialForces)
                            {
                                <span class="pp-stat">
                                    <ForceToken Faction="ShownPlayer.Faction" Special="true" Size="22" ImgClass="m-0 p-0" Title="@Name(ShownPlayer.SpecialForce)"/>@ShownPlayer.SpecialForcesInReserve
                                </span>
                            }

                        </div>

                        @* Leaders, then the traitors held (or face dancers) in a recessed well at the right. The traitors passed on at the start aren't shown. *@
                        <div class="pp-people">

                            @foreach (var v in ShownPlayer.Leaders.Where(l => Client.Game.IsAlive(l)))
                            {
                                <Image Src=@Client.CurrentSkin.GetImageUrl(v) Highlighted="@Game.IsSkilled(v)" Width=44 NoShadow Popover=@Client.CurrentSkin.GetPopup(v, Client.Game)/>
                            }

                            @foreach (var v in ShownPlayer.Leaders.Where(l => !Client.Game.IsAlive(l)))
                            {
                                <Image Src=@Client.CurrentSkin.GetImageUrl(v) Darkened Width=44 NoShadow Popover=@Client.CurrentSkin.GetPopup(v, Client.Game)/>
                            }

                            @if (ShownPlayer.FaceDancers.Count > 0)
                            {
                                <span class="pp-well" title="Face Dancers">
                                    @foreach (var v in ShownPlayer.FaceDancers)
                                    {
                                        <span data-faction-of="@v.Faction"><Image Src=@Client.CurrentSkin.GetImageUrl(v) Blurred="@ShownPlayer.RevealedFaceDancers.Contains(v)" Width=38 NoShadow Popover=@Client.CurrentSkin.GetPopup(v, Client.Game)/></span>
                                    }
                                </span>
                            }
                            else if (ShownPlayer.Traitors.Count > 0 && !StillPickingTraitor)
                            {
                                <span class="pp-well" title="@(ShownPlayer.Traitors.Count == 1 ? "Your traitor" : "Your traitors")">
                                    @foreach (var v in ShownPlayer.Traitors)
                                    {
                                        <span data-faction-of="@v.Faction"><Image Src=@Client.CurrentSkin.GetImageUrl(v) Blurred="@ShownPlayer.RevealedTraitors.Contains(v)" Width=38 NoShadow Popover=@Client.CurrentSkin.GetPopup(v, Client.Game)/></span>
                                    }
                                </span>
                            }

                        </div>

                        <div class="pp-extras">

                        @if (Client.CurrentPhase > Phase.DiallingStorm && Client.Game.HasStormPrescience(Player))
                        {
                            <div>The next storm will move <SimpleNumberComponent>@(Client.Game.NextStormMoves)</SimpleNumberComponent> sectors.</div>
                        }

                        @if (ShownPlayer.Faction == Faction.BeneGesserit && Client.CurrentPhase > Phase.BeneGesseritPredicting)
                        {
                            <div>Prediction: <FactionChip Faction=@ShownPlayer.PredictedFaction Game=Client.Game/> <SimpleNumberComponent Size=30>@ShownPlayer.PredictedTurn</SimpleNumberComponent></div>
                        }

                        @if (ShownPlayer.Faction == Faction.Atreides)
                        {
                            if (Client.Game.Applicable(Rule.AtreidesMessiah))
                            {
                                <div>
                                    <img class="img-fluid m-0 p-0" width="32" height="32"
                                         src="@Client.CurrentSkin.Messiah_URL"
                                         title="@Client.CurrentSkin.Describe(Concept.Messiah)"
                                         alt="@Client.CurrentSkin.Describe(Concept.Messiah)"/>
                                    @if (ShownPlayer.TotalForcesKilledInBattle >= 7)
                                    {
                                        if (ShownPlayer.MessiahAvailable)
                                        {
                                            <span> is available.</span>
                                        }
                                        else
                                        {
                                            <span>has been killed.</span>
                                        }
                                    }
                                    else
                                    {
                                        <span> will be available after <SimpleNumberComponent>@(7 - ShownPlayer.TotalForcesKilledInBattle)</SimpleNumberComponent> more forces are killed in battle.</span>
                                    }
                                </div>
                            }
                        }

                        @if (ShownPlayer.Faction == Faction.Ecaz && Client.CurrentPhase > Phase.BeneGesseritPredicting)
                        {
                            <div>
                                Ambassadors:
                                @foreach (var ambassador in ShownPlayer.Ambassadors)
                                {
                                    <Image Shown=@ambassador Width="30"/>
                                }
                            </div>
                        }

                        @if (ShownPlayer.Faction == Faction.Moritani && Client.CurrentPhase > Phase.BeneGesseritPredicting)
                        {
                            var style = $"color:var(--parchment);{Support.TextBorder(1, "var(--f-moritani)")}";

                            <div>
                            Available Terror:
                            <ExpressionComponent Game="Game" Size="30" Expression=@Expression.Express(Game.UnplacedTerrorTokens) TextBorder=@style />
                            </div>
                        }

                        @if (Client.Game.CurrentMainPhase == MainPhase.ShipmentAndMove && Client.Game.HasResourceDeckPrescience(Player) && !Client.Game.ResourceCardDeck.IsEmpty)
                        {
                            <div>Top card of @Name(Concept.Resource) Deck: <RichText Shown=@Client.Game.ResourceCardDeck.Top Game=Client.Game/></div>
                        }

                        </div>

                        @* The hand, under a rule. It keeps its height when empty. A card
                           you can play now glows; clicking it opens its panel (CardPlayPopover). *@
                        <div class="pp-cards">
                            @foreach (var v in ShownPlayer.TreacheryCards)
                            {
                                var card = v;
                                if (ShownPlayer == Client.Player && CardPlays.Playable(card, Client.Actions, Game, Player))
                                {
                                    <span class="pp-card playable @(Menu.CardPlay == card ? "open" : "")" @onclick="@(e => TogglePlay(card, e))">
                                        <Image Shown=@card Width=48 NoShadow/>
                                    </span>
                                }
                                else
                                {
                                    <Image Shown=@card Width=48 NoShadow/>
                                }
                            }

                            @if (Client.Game.GetCardSetAsideForBid(Player) is { } setAside)
                            {
                                <Image Shown=@setAside Width=48 NoShadow/>
                            }
                        </div>

                        @if (ShownPlayer.Nexus != Faction.None)
                        {
                            <div class="pp-extras">Nexus: <Image Width=30 Src=@Client.CurrentSkin.GetFactionFaceDownImageUrl(ShownPlayer.Nexus) Popover=@Client.CurrentSkin.GetNexusCardPopup(ShownPlayer.Nexus.ToNexus())/></div>
                        }
                    }
                    else
                    {
                        <FactionComponent Faction="Client.Player.Faction"/>
                    }
                
                </div>

            </div>
        }

    </div>
}

@code {

    [Parameter]
    public Player? ShownPlayer { get; set; }

    [Parameter]
    public bool ShowHeader { get; set; }

    private bool _collapsed = true;

    private void TogglePlay(TreacheryCard card, MouseEventArgs e)
    {
        Menu.ToggleCardPlay(card, e.ClientY);
        Client.Refresh(nameof(TogglePlay));
    }

    // While traitors are being picked, a player who picks still holds all the dealt candidates; show none until they've chosen.
    private bool StillPickingTraitor =>
        Client.Game.CurrentPhase == Phase.SelectingTraitors &&
        ShownPlayer.Faction != Faction.Harkonnen && ShownPlayer.Faction != Faction.Tleilaxu &&
        !Client.Game.HasActedOrPassed.Contains(ShownPlayer.Faction);

    private string ResourcesText
    {
        get
        {
            if (ShownPlayer.BankedResources > 0)
            {
                if (ShownPlayer.Bribes + ShownPlayer.Extortion > 0)
                {
                    if (ShownPlayer.ResourcesAfterBidding > 0)
                    {
                        return Client.CurrentSkin.Format("{0}, {1} at end of turn, {2} at end of bidding, {3} at {4}", ShownPlayer.Resources, ShownPlayer.Bribes + ShownPlayer.Extortion, ShownPlayer.ResourcesAfterBidding, ShownPlayer.BankedResources, MainPhase.Contemplate);
                    }

                    return Client.CurrentSkin.Format("{0}, {1} at {2}, {3} at {4}", ShownPlayer.Resources, ShownPlayer.Bribes + ShownPlayer.Extortion, MainPhase.Contemplate, ShownPlayer.BankedResources, MainPhase.Contemplate);
                }

                if (ShownPlayer.ResourcesAfterBidding > 0)
                {
                    return Client.CurrentSkin.Format("{0}, {1} at end of {2}, {3} at {4}", ShownPlayer.Resources, ShownPlayer.ResourcesAfterBidding, MainPhase.Bidding, ShownPlayer.BankedResources, MainPhase.Contemplate);
                }

                return Client.CurrentSkin.Format("{0}, {1} at {2}", ShownPlayer.Resources, ShownPlayer.BankedResources, MainPhase.Contemplate);
            }

            if (ShownPlayer.Bribes + ShownPlayer.Extortion > 0)
            {
                if (ShownPlayer.ResourcesAfterBidding > 0)
                {
                    return Client.CurrentSkin.Format("{0}, {1} at end of turn, {2} at end of bidding", ShownPlayer.Resources, ShownPlayer.Bribes + ShownPlayer.Extortion, ShownPlayer.ResourcesAfterBidding);
                }

                return Client.CurrentSkin.Format("{0}, {1} at {2}", ShownPlayer.Resources, ShownPlayer.Bribes + ShownPlayer.Extortion, MainPhase.Contemplate);
            }

            if (ShownPlayer.ResourcesAfterBidding > 0)
            {
                return Client.CurrentSkin.Format("{0}, {1} at end of {2}", ShownPlayer.Resources, ShownPlayer.ResourcesAfterBidding, MainPhase.Bidding);
            }

            return Client.CurrentSkin.Format("{0}", ShownPlayer.Resources);
        }
    }
}