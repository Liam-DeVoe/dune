@inherits GameComponent
@inject MenuState Menu

@*
 What the trade icons in the menu bar open, in a popover above the bar:
 Deals, Offer a Deal and Give Spice to a faction as tabs; the alliance;
 or the Card Tracker and the notekeeping assistant. The panels are the ones
 the action column used to show, opened up (InPopover). A click outside,
 Escape, or the icon again closes it.
*@

@if (IsOpen(Menu.Panel))
{
    <div class="menu-scrim" @onclick="Close"></div>

    <div class="pop trade-pop">
        <CascadingValue Name="InPopover" Value="true">

            @if (Menu.Panel == MenuPanel.Deals)
            {
                var tabs = DealTabs.ToArray();
                // Opened from a deal's toast, Deals shows with that offer marked.
                if (Menu.MarkedDeal != null && tabs.Contains(DealTab.Deals)) _tab = DealTab.Deals;
                var tab = tabs.Contains(_tab) ? _tab : tabs.FirstOrDefault();

                @if (tabs.Length > 1)
                {
                    <div class="pop-tabs">
                        @foreach (var t in tabs)
                        {
                            var shown = t;
                            <button class="@(t == tab ? "on" : "")" @onclick="@(() => _tab = shown)">@TabName(t)</button>
                        }
                    </div>
                }

                <div class="pop-body">
                    @switch (tab)
                    {
                        case DealTab.Deals:
                            <DealComponent/>
                            break;
                        case DealTab.Offer:
                            <ActionPanel Filter="@(a => a == typeof(DealOffered))"/>
                            break;
                        case DealTab.Give:
                            <ActionPanel Filter="@(a => a == typeof(Donated))"/>
                            break;
                        default:
                            <p class="pop-empty">No deals.</p>
                            break;
                    }
                </div>
            }
            else if (Menu.Panel == MenuPanel.Alliance)
            {
                <div class="pop-body">
                    <ActionPanel Filter="@(a => a == typeof(AllyPermission))"/>
                </div>
            }
            else
            {
                <div class="pop-body">
                    @if (Client.Game.AssistedNoteKeepingEnabled(Player))
                    {
                        <NoteComponent/>
                    }
                    @if (Client.CurrentPhase >= Phase.SelectingTraitors && Client.Faction is Faction.Atreides)
                    {
                        <TrackerComponent/>
                    }
                </div>
            }

        </CascadingValue>
    </div>
}

@code {

    private enum DealTab { Deals, Offer, Give }

    private DealTab _tab;

    private IEnumerable<DealTab> DealTabs
    {
        get
        {
            if (DealAccepted.CurrentDeals(Game).Any() || DealAccepted.AcceptableDeals(Game, Player).Any() || DealAccepted.CancellableDeals(Game, Player).Any())
                yield return DealTab.Deals;
            if (Client.Actions.Contains(typeof(DealOffered)))
                yield return DealTab.Offer;
            if (Client.Actions.Contains(typeof(Donated)))
                yield return DealTab.Give;
        }
    }

    private string TabName(DealTab t) => t switch
    {
        DealTab.Deals => "Deals",
        DealTab.Offer => "Offer a Deal",
        _ => Client.CurrentSkin.Format("Give {0}", Concept.Resource)
    };

    // Whether the card icon has anything to open.
    public static bool HasCardTools(IGameService client) =>
        client.InGame && !client.IsObserver && client.Game.EventCount > 0 &&
        (client.Game.AssistedNoteKeepingEnabled(client.Player) || (client.CurrentPhase >= Phase.SelectingTraitors && client.Player.Faction is Faction.Atreides));

    private static bool IsOpen(MenuPanel panel) => panel is MenuPanel.Deals or MenuPanel.Alliance or MenuPanel.Cards;

    private DotNetObjectReference<TradePopover>? _self;
    private bool _listening;

    // The menu bar opens and closes this popover through MenuState, so the
    // Escape listener follows whether it rendered open.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var open = IsOpen(Menu.Panel);
        if (open == _listening) return;
        _listening = open;
        if (open)
        {
            _self ??= DotNetObjectReference.Create(this);
            await Browser.ListenForEscape("trade", _self);
        }
        else
        {
            await Browser.StopListeningForEscape("trade");
        }
    }

    public override void Dispose()
    {
        base.Dispose();
        _ = Browser.StopListeningForEscape("trade");
        _self?.Dispose();
    }

    [JSInvokable]
    public void OnEscape()
    {
        if (IsOpen(Menu.Panel)) Close();
    }

    private void Close()
    {
        Menu.Close();
        Client.Refresh(nameof(TradePopover));
    }
}
