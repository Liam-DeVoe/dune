@inherits GameComponent
@inject TurnClock Clock

@*
 A bright bar pinned across the top of the window while it's the player's
 turn, so nobody holds up the game without noticing. It says "Your turn" and
 how long it has been, on the same clock (TurnClock) as the prompt card. A
 spacer under it pushes the game screen down, and GameScreen.Style makes the
 screen shorter to match.
*@

@if (GameScreen.ShowsTurnBanner(Client))
{
    <div class="turn-banner-space"></div>
    <div class="turn-banner" role="status">
        <span class="label">Your turn</span>
        <span class="clock">@Elapsed()</span>
    </div>
}

@code {

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Clock.Tick += OnTick;
    }

    private void OnTick()
    {
        if (GameScreen.ShowsTurnBanner(Client)) InvokeAsync(StateHasChanged);
    }

    // Since the event the game is waiting on, as the prompt's clock counts it,
    // or else since the last thing that happened.
    private string Elapsed()
    {
        var since = Client.Status?.TimedEvent?.Time ?? Game.History.LastOrDefault()?.Time;
        return since is null ? "" : Clock.Since(since.Value);
    }

    public override void Dispose()
    {
        Clock.Tick -= OnTick;
        base.Dispose();
    }
}
