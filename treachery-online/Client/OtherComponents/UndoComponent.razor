@inherits GameComponent

@*
 The host's undo panel. Opening it starts an undo session: the host drags the
 timeline under the map (UndoTimeline) to a moment, and the board, player
 panel and report show the game as it was then. The panel says where the game
 goes back to and lists what would be undone. Escape cancels.
*@

@if (Client.UndoSession is { } session)
{
    var count = session.Live.History.Count - session.Gap;

    <div class="panel undo mb-2">
        <header>
            <h5>Undo</h5>
            <button class="btn-close btn-close-sm" title="Cancel" @onclick="Cancel"></button>
        </header>
        <div class="body">
            @if (session.AtNow)
            {
                <div class="empty">Drag the timeline under the map back to the moment you want to return to.</div>
            }
            else
            {
                var moment = session.MomentOf(session.Gap);
                <div>
                    <div class="kicker">Back to</div>
                    <div class="dest">Turn @moment.Turn · @Client.CurrentSkin.Describe(moment.Phase)</div>
                </div>

                <div>
                    <div class="kicker">Undone</div>
                    <div class="undone">
                        @{ Moment? group = null; }
                        @for (var i = session.Live.History.Count - 1; i >= session.Gap; i--)
                        {
                            var e = session.Live.History[i];
                            if (!UndoSession.IsListed(e)) continue;

                            var m = session.MomentOf(i);
                            if (group is not { } g || g.Turn != m.Turn || g.Phase != m.Phase)
                            {
                                group = m;
                                <div class="group">Turn @m.Turn · @Client.CurrentSkin.Describe(m.Phase)</div>
                            }

                            <div class="line"><ExpressionComponent Expression="@e.GetShortMessage().Expression" Game="@session.Live" Size="18"/></div>
                        }
                    </div>
                </div>
            }

            <div class="actions">
                <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                <button class="btn btn-primary" disabled="@session.AtNow" @onclick="Confirm">
                    @(session.AtNow ? "Undo" : count == 1 ? "Undo 1 event" : $"Undo {count} events")
                </button>
            </div>
        </div>
    </div>
}

@code {

    // Called when the panel should close, after a confirm or a cancel.
    [Parameter]
    public EventCallback OnClose { get; set; }

    private DotNetObjectReference<UndoComponent>? _self;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Client.OpenUndo();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        await Browser.ListenForEscape("undo", _self);
    }

    public override void Dispose()
    {
        base.Dispose();
        _ = Browser.StopListeningForEscape("undo");
        _self?.Dispose();
        Client.CloseUndo();
    }

    [JSInvokable]
    public async Task OnEscape() => await Cancel();

    private async Task Cancel() => await OnClose.InvokeAsync();

    private async Task Confirm()
    {
        if (Client.UndoSession is not { AtNow: false } session) return;

        var gap = session.Gap;
        Client.CloseUndo();
        await Client.RequestUndo(gap);
        await OnClose.InvokeAsync();
    }
}
