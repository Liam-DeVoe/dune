@page "/scene"
@using System.Net.Http
@using Treachery.Client.OtherComponents
@using Treachery.Client.MapComponents
@using Treachery.Client.GameEventComponents
@using Treachery.Client.Scene
@inject HttpClient Http
@inject IJSRuntime JS
@implements IDisposable

@*
 A saved game rendered as one faction, with no server, for screenshots.
 /scene?fixture=ship&faction=emperor&steps=click:Carthag|button:Confirm

 fixture  name of a file under fixtures/ (without .json), or a URL
 faction  the enum or skin name of the faction to play as, or "observer"
          to watch as a non-host observer
 steps    optional '|'-separated clicks to make after the first render:
          click:<location>, shift:<location>, ctrl:<location>,
          right:<location>, button:<label>. Locations are named as the
          default skin names them: "Carthag", "False Wall South (East Sector)".

 The page reproduces Main.razor's in-game layout. wwwroot/js/scene.js
 exposes what the screenshot harness needs: <html data-scene> goes from
 loading to ready once the steps have run, and window.treacheryScene has
 the location centres, a click function and a way to wait for the DOM to
 settle. The service behind Client is SceneGameService; Program.cs picks it
 for this path.
*@

@if (_error != null)
{
    <div class="alert alert-danger m-3" role="alert">@_error</div>
}
else if (!_loaded)
{
    <div class="m-3">Loading scene...</div>
}
else
{
    <TurnBanner/>
    <div @ref="@_element" class="row game-screen" style="@GameScreen.Style(Client)">

        <GameColumns/>

    </div>
}

@code {

    [SupplyParameterFromQuery] public string? Fixture { get; set; }
    [SupplyParameterFromQuery(Name = "faction")] public string? FactionName { get; set; }
    [SupplyParameterFromQuery] public string? Steps { get; set; }

    private SceneGameService? _scene;
    private List<SceneStep> _steps = [];
    private string? _error;
    private bool _loaded;
    private bool _stepsStarted;
    private ElementReference _element;
    private DotNetObjectReference<Scene>? _self;
    private TaskCompletionSource? _rendered;

    protected override async Task OnInitializedAsync()
    {
        Client.RefreshHandler += StateHasChanged;
        Client.RefreshPopoverHandler += RefreshPopovers;
        Message.DefaultDescriber = DefaultSkin.Default;

        _self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("treacheryScene.attach", _self);

        try
        {
            _scene = Client as SceneGameService
                ?? throw new InvalidOperationException("Open /scene with a full page load. The scene service is chosen when the app starts.");
            if (string.IsNullOrWhiteSpace(Fixture))
                throw new ArgumentException("The fixture query parameter is required.");
            var observer = string.Equals(FactionName?.Trim(), "observer", StringComparison.OrdinalIgnoreCase);
            Faction? faction = observer ? null : SceneScript.ParseFaction(FactionName)
                ?? throw new ArgumentException($"Unknown faction '{FactionName}'. Use an enum name such as emperor or bene_gesserit, a skin name such as Bene Gesserit, or observer.");
            _steps = SceneStep.ParseAll(Steps);

            var url = Fixture.Contains('/') || Fixture.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? Fixture
                : $"fixtures/{Fixture}.json";
            using var response = await Http.GetAsync(url);
            if (!response.IsSuccessStatusCode)
                throw new InvalidOperationException($"Could not fetch {url}: {(int)response.StatusCode} {response.ReasonPhrase}.");
            var json = await response.Content.ReadAsStringAsync();

            _scene.Load(json, faction);
            await JS.InvokeVoidAsync("treacheryScene.setLocations", SceneScript.LocationCentres(_scene.Game!));
            _loaded = true;
        }
        catch (Exception e)
        {
            await Fail(e.Message);
        }
    }

    public void Dispose()
    {
        Client.RefreshHandler -= StateHasChanged;
        Client.RefreshPopoverHandler -= RefreshPopovers;
        _self?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("treacheryScene.rendered");
        _rendered?.TrySetResult();

        if (!_loaded) return;

        await Browser.SetPlanetMapScale();

        if (!_stepsStarted)
        {
            _stepsStarted = true;
            _ = RunInitialSteps();
        }
    }

    private async Task RunInitialSteps()
    {
        try
        {
            foreach (var step in _steps) await Run(step);
            await JS.InvokeVoidAsync("treacheryScene.setState", "ready");
        }
        catch (Exception e)
        {
            await Fail(e.Message);
        }
    }

    private async Task Run(SceneStep step)
    {
        if (step.IsButton)
            await PressButton(step.Target);
        else
            await Click(step.Target, step.Shift, step.Ctrl, step.Right);
    }

    // Clicks a location the way the map does, once the action that uses the
    // map has claimed it, and returns after the page has redrawn.
    [JSInvokable]
    public async Task Click(string location, bool shift, bool ctrl, bool right)
    {
        var l = SceneScript.FindLocation(_scene!.Game!, location)
            ?? throw new ArgumentException($"Unknown location '{location}'. Names are the default skin's, such as 'Carthag' or 'False Wall South (East Sector)'.");

        await WaitForMapOwner();
        Client.LocationClick(new LocationEventArgs { Location = l, ShiftKey = shift, CtrlKey = ctrl, RightButton = right });
        await Settle();
    }

    // Another faction offers the seated faction a deal, or withdraws its newest
    // offer, as if it came from the server. For checking the deal toasts.
    [JSInvokable]
    public async Task OfferDeal(string from, int price, bool withdraw)
    {
        var game = _scene!.Game!;
        var faction = SceneScript.ParseFaction(from) ?? throw new ArgumentException($"Unknown faction '{from}'.");
        GameEvent e = withdraw
            ? (game.DealOffers.LastOrDefault(o => o.Initiator == faction) ?? throw new InvalidOperationException($"{from} has no offer to withdraw.")).Cancellation()
            : new DealOffered(game, faction) { Type = DealType.TellDiscardedTraitors, Price = price, To = [_scene.Faction!.Value], EndPhase = Phase.TurnConcluded };
        var error = await _scene.RequestGameEvent(e);
        if (error != null) throw new InvalidOperationException(error);
        await Settle();
    }

    // Clicks the first visible button with this label and returns after the
    // page has redrawn.
    [JSInvokable]
    public async Task PressButton(string label)
    {
        var found = await JS.InvokeAsync<bool>("treacheryScene.pressButton", label);
        if (!found) throw new InvalidOperationException($"No visible button labelled '{label}'.");
        await Settle();
    }

    // The component owning the map claims it after its first render, so a
    // click right after loading could come too early. Gives up after a
    // second: some phases have no map action at all.
    private async Task WaitForMapOwner()
    {
        for (var i = 0; i < 50 && Client.MapInteraction.IsFree; i++)
        {
            await Task.Delay(20);
            await Render();
        }
    }

    // Two renders with a pause between them, so that handlers which queue
    // their own render (a button's event, a map redraw) have run too.
    private async Task Settle()
    {
        await Render();
        await Task.Delay(30);
        await Render();
    }

    private async Task Render()
    {
        _rendered = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        await InvokeAsync(StateHasChanged);
        await _rendered.Task;
    }

    private async Task Fail(string message)
    {
        _error = message;
        _loaded = false;
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("treacheryScene.setState", "error");
    }

    private void RefreshPopovers() => _ = Browser.RefreshPopovers(_element);
}
