<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Treachery.ServerOracle</RootNamespace>
    <AssemblyName>Treachery.ServerOracle</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>CS0612;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Server\Treachery.Server.csproj" />
    <ProjectReference Include="..\Oracle\Treachery.Oracle.csproj" />
  </ItemGroup>

</Project>
