{
  "name": "treachery-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "React client for the Rust server. See rust/docs/client.md.",
  "scripts": {
    "dev": "npm run build:css && vite",
    "build": "npm run build:css && tsc -b && vite build",
    "build:css": "sass --style=expanded --no-source-map styles/treachery.scss assets/css/treachery.css",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "check:rich-text": "node tools/check-rich-text.ts",
    "check:flash": "node tools/check-flash.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "sass": "1.103.0",
    "typescript": "5.9",
    "vite": "^7.3.7"
  }
}
